{
  "name": "Arcanoid Upgrade",
  "content": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Arcanoid_Upgrade</title>\n  <style>\n    html, body {\n      width: 390px;\n      height: 844px;\n      margin: 0;\n      padding: 0;\n      background: #0a0a0a;\n      overflow: hidden;\n      font-family: monospace;\n    }\n    body {\n      width: 390px;\n      height: 844px;\n      overflow: hidden;\n      margin: 0;\n      position: relative;\n      background: #0a0a0a;\n    }\n    canvas {\n      display: block;\n      width: 390px;\n      height: 844px;\n      margin: 0;\n      background: #0a0a0a;\n      touch-action: none;\n    }\n    #mute-btn {\n      position: absolute;\n      left: 332px;\n      top: 10px;\n      z-index: 11;\n      width: 46px;\n      height: 46px;\n      background: #181824;\n      border-radius: 50%;\n      border: 2px solid #4fc3f7;\n      outline: none;\n      cursor: pointer;\n      color: #00ff88;\n      font-size: 22px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    #mute-btn.muted { color: #888; border-color: #888; background: #201920; }\n    #initials-prompt {\n      display: none;\n      position: absolute;\n      inset: 0;\n      width: 390px;\n      height: 844px;\n      background: rgba(0,0,0,0.88);\n      z-index: 1000;\n      align-items: center;\n      justify-content: center;\n      flex-direction: column;\n    }\n    #initials-form {\n      background: rgba(24,24,34,0.95);\n      border-radius: 14px;\n      box-shadow: 0 4px 32px rgba(0,255,136,0.25);\n      padding: 28px 20px 22px 20px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      border: 2px solid #00ff88;\n    }\n    #initials-form label {\n      color: #4fc3f7;\n      font-size: 18px;\n      letter-spacing: 2px;\n      margin-bottom: 8px;\n    }\n    #initials-input {\n      margin: 10px 0 14px 0;\n      border-radius: 6px;\n      border: 2px solid #00ff88;\n      background: #10131c;\n      color: #00ff88;\n      font-size: 32px;\n      width: 92px;\n      text-align: center;\n      letter-spacing: 7px;\n      text-transform: uppercase;\n      outline: none;\n      font-weight: 700;\n      padding: 6px;\n    }\n    #initials-submit {\n      margin-top: 4px;\n      font-size: 18px;\n      padding: 8px 26px;\n      border-radius: 8px;\n      background: #00ff88;\n      color: #102;\n      border: none;\n      cursor: pointer;\n      font-family: monospace;\n      letter-spacing: 2px;\n      font-weight: 700;\n    }\n  </style>\n</head>\n<body>\n  <canvas width=\"390\" height=\"844\"></canvas>\n  <button id=\"mute-btn\" title=\"Mute/unmute sound\"><span id=\"mute-icon\">🔊</span></button>\n  <div id=\"initials-prompt\">\n    <form id=\"initials-form\" autocomplete=\"off\">\n      <label for=\"initials-input\">NEW HIGH SCORE!</label>\n      <input id=\"initials-input\" type=\"text\" maxlength=\"3\" autofocus autocorrect=\"off\" autocomplete=\"off\" spellcheck=\"false\" />\n      <button type=\"submit\" id=\"initials-submit\">OK</button>\n    </form>\n  </div>\n<script>\nif(window.__canvasAnimId) cancelAnimationFrame(window.__canvasAnimId);\n\nlet WIDTH = 390;\nlet HEIGHT = 844;\nlet canvas = document.querySelector('canvas');\nlet ctx = canvas.getContext('2d');\nlet BG_COLORS = ['#101920','#0a1731','#1a192c','#220d11','#112a24'];\nlet LEVELS = [\n  {name:'LAUNCH PAD', theme:'CYBER DOCK', layout:[5,5,5,5,5,0,0], color:'#00ff88'},\n  {name:'TWIST RUN', theme:'AQUA CIRCUIT', layout:[3,6,2,7,3,7,6], color:'#4fc3f7'},\n  {name:'BLOCKADE', theme:'EMBER FORT', layout:[7,5,4,6,7,5,6], color:'#ff6b35'},\n  {name:'NEON CAVE', theme:'VIOLET GROTTO', layout:[2,3,6,5,2,6,3], color:'#b388ff'},\n  {name:'SPIKE DANCE', theme:'JADE STORM', layout:[5,5,7,1,7,5,5], color:'#00ff88'}\n];\nlet POWER_UP_TYPES = [\n  {type:'life', label:'1UP', color:'#4fc3f7'},\n  {type:'multi', label:'MB', color:'#ff6b35'},\n  {type:'laser', label:'LZR', color:'#c3ff25'},\n  {type:'slow', label:'SLO', color:'#00ff88'},\n  {type:'magnet', label:'MAG', color:'#00fff9'},\n  {type:'shield', label:'SHL', color:'#ff19c9'},\n  {type:'scorex2', label:'2X', color:'#fbc02d'},\n  {type:'bomb', label:'BMB', color:'#ffffff'}\n];\nlet FALL_POWERUP_FREQ = 0.21;\nlet TIMER_POWERUP_FREQ = 0.13;\nlet game = null;\nlet muted = (localStorage['canvas_game_muted'] === '1');\nlet inputBound = window.__arcanoidInputBound || false;\n\nfunction safeAudioContext() {\n  try {\n    let Ctx = window.AudioContext || window.webkitAudioContext;\n    if(!Ctx) return null;\n    return new Ctx();\n  } catch(e) {\n    return null;\n  }\n}\n\nfunction MusicEngine() {\n  let ac = safeAudioContext();\n  let master = null;\n  let musicNodes = [];\n  let musicTimers = [];\n  let padOsc = null;\n  let padGain = null;\n  let activePadLfo = null;\n  if(ac) {\n    master = ac.createGain();\n    master.gain.value = muted ? 0 : 0.22;\n    master.connect(ac.destination);\n  }\n  function ensureResume() {\n    if(!ac) return;\n    if(ac.state === 'suspended') {\n      try { ac.resume(); } catch(e) {}\n    }\n  }\n  function playTone(freq, type, dur, gain) {\n    if(!ac || !master || muted) return;\n    ensureResume();\n    let now = ac.currentTime;\n    let o = ac.createOscillator();\n    let g = ac.createGain();\n    o.type = type || 'sine';\n    o.frequency.setValueAtTime(freq, now);\n    g.gain.setValueAtTime(0.0001, now);\n    g.gain.linearRampToValueAtTime(gain || 0.4, now + 0.01);\n    g.gain.exponentialRampToValueAtTime(0.0001, now + dur);\n    o.connect(g);\n    g.connect(master);\n    o.start(now);\n    o.stop(now + dur + 0.05);\n    setTimeout(function(){ try { o.disconnect(); g.disconnect(); } catch(e){} }, (dur + 0.1) * 1000);\n  }\n  function playSoftNote(freq, dur, gain, wave) {\n    if(!ac || !master || muted) return;\n    ensureResume();\n    let now = ac.currentTime;\n    let o = ac.createOscillator();\n    let g = ac.createGain();\n    let lp = ac.createBiquadFilter();\n    lp.type = 'lowpass';\n    lp.frequency.value = 1400;\n    lp.Q.value = 0.35;\n    o.type = wave || 'sine';\n    o.frequency.setValueAtTime(freq, now);\n    g.gain.setValueAtTime(0.0001, now);\n    g.gain.linearRampToValueAtTime(gain, now + 0.04);\n    g.gain.linearRampToValueAtTime(gain * 0.72, now + dur * 0.55);\n    g.gain.exponentialRampToValueAtTime(0.0001, now + dur);\n    o.connect(lp);\n    lp.connect(g);\n    g.connect(master);\n    o.start(now);\n    o.stop(now + dur + 0.06);\n    setTimeout(function(){ try { o.disconnect(); lp.disconnect(); g.disconnect(); } catch(e){} }, (dur + 0.12) * 1000);\n  }\n  function playBell(freq, dur, gain) {\n    if(!ac || !master || muted) return;\n    ensureResume();\n    let now = ac.currentTime;\n    let o1 = ac.createOscillator();\n    let o2 = ac.createOscillator();\n    let g = ac.createGain();\n    let lp = ac.createBiquadFilter();\n    lp.type = 'lowpass';\n    lp.frequency.value = 2400;\n    o1.type = 'triangle';\n    o2.type = 'sine';\n    o1.frequency.setValueAtTime(freq, now);\n    o2.frequency.setValueAtTime(freq * 2, now);\n    g.gain.setValueAtTime(0.0001, now);\n    g.gain.linearRampToValueAtTime(gain, now + 0.018);\n    g.gain.exponentialRampToValueAtTime(0.0001, now + dur);\n    o1.connect(lp);\n    o2.connect(lp);\n    lp.connect(g);\n    g.connect(master);\n    o1.start(now);\n    o2.start(now);\n    o1.stop(now + dur + 0.05);\n    o2.stop(now + dur + 0.05);\n    setTimeout(function(){ try { o1.disconnect(); o2.disconnect(); lp.disconnect(); g.disconnect(); } catch(e){} }, (dur + 0.11) * 1000);\n  }\n  function clearMusicTimers() {\n    for(let i = 0; i < musicTimers.length; i++) clearTimeout(musicTimers[i]);\n    musicTimers = [];\n  }\n  function setPad(freq) {\n    if(!ac || !master || muted) return;\n    ensureResume();\n    let now = ac.currentTime;\n    if(!padOsc) {\n      padOsc = ac.createOscillator();\n      padGain = ac.createGain();\n      let padFilter = ac.createBiquadFilter();\n      padFilter.type = 'lowpass';\n      padFilter.frequency.value = 700;\n      padFilter.Q.value = 0.4;\n      padOsc.type = 'triangle';\n      padGain.gain.setValueAtTime(0.0001, now);\n      padOsc.connect(padFilter);\n      padFilter.connect(padGain);\n      padGain.connect(master);\n      padOsc.start(now);\n      musicNodes.push(padOsc, padGain, padFilter);\n      activePadLfo = ac.createOscillator();\n      let lfoGain = ac.createGain();\n      activePadLfo.type = 'sine';\n      activePadLfo.frequency.value = 0.22;\n      lfoGain.gain.value = 5;\n      activePadLfo.connect(lfoGain);\n      lfoGain.connect(padOsc.frequency);\n      activePadLfo.start(now);\n      musicNodes.push(activePadLfo, lfoGain);\n    }\n    padOsc.frequency.cancelScheduledValues(now);\n    padOsc.frequency.linearRampToValueAtTime(freq, now + 0.7);\n    padGain.gain.cancelScheduledValues(now);\n    padGain.gain.linearRampToValueAtTime(0.06, now + 0.8);\n  }\n  function sfx(name) {\n    if(!ac || muted) return;\n    if(name === 'hit') playTone(410 + Math.random() * 35, 'triangle', 0.055, 0.47);\n    if(name === 'brick') playTone(130 + Math.random() * 60, 'sawtooth', 0.16, 0.5);\n    if(name === 'power') playTone(550 + Math.random() * 55, 'square', 0.15, 0.49);\n    if(name === 'life') playTone(1560, 'square', 0.25, 0.5);\n    if(name === 'fail') { playTone(120, 'sine', 0.2, 0.5); setTimeout(function(){ playTone(77, 'sawtooth', 0.24, 0.4); }, 90); }\n    if(name === 'level') playTone(185, 'triangle', 0.47, 0.18);\n    if(name === 'bomb') { playTone(220, 'square', 0.21, 0.7); setTimeout(function(){ playTone(68, 'triangle', 0.19, 0.64); }, 140); }\n    if(name === 'newhi') playTone(900, 'square', 0.48, 0.58);\n    if(name === 'shield') playTone(2200, 'triangle', 0.34, 0.36);\n  }\n  function queueLoop(levelIx) {\n    if(!ac || !master) return;\n    let root = 174.61 + levelIx * 9;\n    let bpm = 82 + levelIx * 3;\n    let beatMs = 60000 / bpm;\n    let bars = [\n      { chord:[0,4,7], bass:0, lead:[7,9,11,12,11,9,7,4] },\n      { chord:[5,9,12], bass:5, lead:[9,11,12,14,12,11,9,7] },\n      { chord:[7,11,14], bass:7, lead:[11,12,14,16,14,12,11,9] },\n      { chord:[4,7,11], bass:4, lead:[7,9,11,12,11,9,7,2] }\n    ];\n    if(levelIx >= 3) {\n      bars[1].lead = [9,12,14,16,14,12,11,9];\n      bars[2].lead = [11,14,16,18,16,14,12,11];\n    }\n    function noteFreq(semi, octave) {\n      return root * Math.pow(2, semi / 12) * (octave || 1);\n    }\n    let totalBeats = 0;\n    for(let bi = 0; bi < bars.length; bi++) {\n      let bar = bars[bi];\n      let barStart = totalBeats * beatMs;\n      let bassFreq = noteFreq(bar.bass, 0.5);\n      musicTimers.push(setTimeout(function(){ setPad(bassFreq); }, barStart));\n      for(let ci = 0; ci < bar.chord.length; ci++) {\n        let cf = noteFreq(bar.chord[ci], 1);\n        musicTimers.push(setTimeout(function(){ playSoftNote(cf, beatMs * 2.7 / 1000, 0.040, 'triangle'); }, barStart + ci * beatMs * 0.5));\n      }\n      for(let step = 0; step < 8; step++) {\n        let semi = bar.lead[step];\n        let noteTime = barStart + step * beatMs;\n        let leadWave = (step % 3 === 0) ? 'sine' : 'triangle';\n        let leadGain = 0.090 + Math.min(levelIx, 8) * 0.004;\n        musicTimers.push(setTimeout(function(){ playSoftNote(noteFreq(semi, 1), beatMs * 0.88 / 1000, leadGain, leadWave); }, noteTime));\n        if(step % 2 === 0) {\n          let harmonySemi = semi - 12;\n          musicTimers.push(setTimeout(function(){ playSoftNote(noteFreq(harmonySemi, 1), beatMs * 0.7 / 1000, 0.030, 'sine'); }, noteTime + beatMs * 0.18));\n        }\n        if(levelIx >= 4 && (step === 3 || step === 7)) {\n          musicTimers.push(setTimeout(function(){ playBell(noteFreq(semi + 12, 1), beatMs * 0.55 / 1000, 0.032); }, noteTime + beatMs * 0.08));\n        }\n      }\n      totalBeats += 8;\n    }\n    musicTimers.push(setTimeout(function(){ queueLoop(levelIx); }, totalBeats * beatMs));\n  }\n  function stopMusic() {\n    clearMusicTimers();\n    if(padGain && ac) {\n      try {\n        let now = ac.currentTime;\n        padGain.gain.cancelScheduledValues(now);\n        padGain.gain.linearRampToValueAtTime(0.0001, now + 0.25);\n      } catch(e) {}\n    }\n    if(musicNodes.length) {\n      for(let i = 0; i < musicNodes.length; i++) {\n        try {\n          if(musicNodes[i].stop) musicNodes[i].stop(ac.currentTime + 0.3);\n        } catch(e) {}\n      }\n      setTimeout(function(){\n        for(let i = 0; i < musicNodes.length; i++) {\n          try { musicNodes[i].disconnect(); } catch(e) {}\n        }\n        musicNodes = [];\n        padOsc = null;\n        padGain = null;\n        activePadLfo = null;\n      }, 380);\n    } else {\n      padOsc = null;\n      padGain = null;\n      activePadLfo = null;\n    }\n  }\n  function startMusic(levelIx) {\n    if(!ac || !master) return;\n    ensureResume();\n    stopMusic();\n    queueLoop(levelIx);\n  }\n  function muteSwitch(on) {\n    muted = on;\n    localStorage['canvas_game_muted'] = on ? '1' : '0';\n    if(master) master.gain.value = muted ? 0 : 0.22;\n  }\n  return { sfx:sfx, startMusic:startMusic, stopMusic:stopMusic, muteSwitch:muteSwitch, ensureResume:ensureResume };\n}\n\nlet audio = window.__arcanoidAudio;\nif(!audio) {\n  audio = MusicEngine();\n  window.__arcanoidAudio = audio;\n}\n\n(function() {\n  let muteBtn = document.getElementById('mute-btn');\n  let icon = document.getElementById('mute-icon');\n  function update() {\n    if(muted) {\n      muteBtn.classList.add('muted');\n      icon.textContent = '🔇';\n    } else {\n      muteBtn.classList.remove('muted');\n      icon.textContent = '🔊';\n    }\n  }\n  muteBtn.onclick = function() {\n    muted = !muted;\n    audio.muteSwitch(muted);\n    update();\n  };\n  update();\n})();\n\nfunction getHighScore() {\n  let entry = localStorage['canvas_arcanoid_highscore'] || 'AAA 0';\n  let s = entry.split(' ');\n  return { initials:(s[0] || 'AAA').slice(0,3), score:+s[1] || 0 };\n}\nfunction setHighScore(initials, score) {\n  localStorage['canvas_arcanoid_highscore'] = initials.slice(0,3).toUpperCase() + ' ' + score;\n}\nfunction promptInitials(score, cb) {\n  let d = document.getElementById('initials-prompt');\n  let f = document.getElementById('initials-form');\n  let i = document.getElementById('initials-input');\n  d.style.display = 'flex';\n  i.value = '';\n  setTimeout(function(){ try { i.focus(); } catch(e) {} }, 10);\n  f.onsubmit = function(e) {\n    e.preventDefault();\n    let x = i.value.replace(/[^A-Za-z0-9]/g, '').slice(0,3).toUpperCase();\n    if(!x) x = '???';\n    d.style.display = 'none';\n    cb(x);\n  };\n}\nfunction randOne(arr) { return arr[Math.floor(Math.random() * arr.length)]; }\nfunction clamp(x,a,b) { return Math.min(b, Math.max(a, x)); }\nfunction circleRectCollision(cx, cy, cr, rx, ry, rw, rh) {\n  let testX = clamp(cx, rx, rx + rw);\n  let testY = clamp(cy, ry, ry + rh);\n  let dx = cx - testX;\n  let dy = cy - testY;\n  return dx * dx + dy * dy <= cr * cr;\n}\n\nfunction makeGame() {\n  let g = {\n    state: 'boot',\n    score: 0,\n    hiscore: getHighScore(),\n    initials: getHighScore().initials,\n    lives: 3,\n    level: 0,\n    maxLevel: LEVELS.length - 1,\n    paddle: { x: WIDTH/2 - 46, y: HEIGHT - 32, w: 92, h: 15, speed: 7, shield:false, shieldTimer:0 },\n    balls: [],\n    bricks: [],\n    powerups: [],\n    activePower: {},\n    timers: { pSpawn: 0 },\n    combo: 0,\n    comboTimer: 0,\n    levelClearScheduled: false,\n    pendingReset: false,\n    allowLaunch: false,\n    autoLaunchAfterIntro: false,\n    waitingForHighScoreEntry: false,\n    transitionToken: 0,\n    introEndAt: 0,\n    message: '',\n    messageTimer: 0,\n    _lastTS: 0\n  };\n\n  g.attachBallsToPaddle = function(resetVelocity) {\n    for(let i = 0; i < this.balls.length; i++) {\n      let ball = this.balls[i];\n      ball.active = false;\n      ball.x = this.paddle.x + this.paddle.w / 2;\n      ball.y = this.paddle.y - ball.r - 3;\n      if(resetVelocity) {\n        let dir = Math.random() < 0.5 ? -1 : 1;\n        ball.vx = dir * (3.2 + Math.random() * 1.3 + this.level * 0.12);\n        ball.vy = -7 - Math.min(this.level, 5) * 0.4;\n      }\n    }\n  };\n\n  g.prepareServe = function(resetVelocity) {\n    this.pendingReset = false;\n    this.allowLaunch = false;\n    this.paddle.x = WIDTH / 2 - this.paddle.w / 2;\n    this.paddle.y = HEIGHT - 32;\n    this.attachBallsToPaddle(resetVelocity !== false);\n  };\n\n  g.beginLevelIntro = function(text) {\n    this.transitionToken++;\n    let token = this.transitionToken;\n    this.state = 'level-intro';\n    this.allowLaunch = false;\n    this.message = text || '';\n    this.messageTimer = text ? 1400 : 0;\n    this.prepareServe(true);\n    this.introEndAt = performance.now() + 1550;\n    let self = this;\n    setTimeout(function(){\n      if(!game || self !== game) return;\n      if(self.transitionToken !== token) return;\n      if(self.state !== 'level-intro') return;\n      self.state = 'playing';\n      self.allowLaunch = true;\n      self.message = '';\n      self.messageTimer = 0;\n      if(self.autoLaunchAfterIntro) tryLaunchBall();\n    }, 1550);\n  };\n\n  g.scheduleLifeReset = function() {\n    this.transitionToken++;\n    let token = this.transitionToken;\n    this.state = 'level-intro';\n    this.allowLaunch = false;\n    this.pendingReset = true;\n    this.message = 'LIFE LOST';\n    this.messageTimer = 900;\n    this.prepareServe(true);\n    this.introEndAt = performance.now() + 950;\n    let self = this;\n    setTimeout(function(){\n      if(!game || self !== game) return;\n      if(self.transitionToken !== token) return;\n      if(self.lives <= 0) return;\n      self.pendingReset = false;\n      self.state = 'playing';\n      self.allowLaunch = true;\n      self.message = '';\n      self.messageTimer = 0;\n      if(self.autoLaunchAfterIntro) tryLaunchBall();\n    }, 950);\n  };\n\n  g.setLevel = function(lvIx) {\n    this.level = lvIx;\n    this.combo = 0;\n    this.comboTimer = 0;\n    this.powerups = [];\n    this.activePower = {};\n    this.levelClearScheduled = false;\n    this.pendingReset = false;\n    this.allowLaunch = false;\n    this.waitingForHighScoreEntry = false;\n    this.message = '';\n    this.messageTimer = 0;\n    let lev = LEVELS[lvIx];\n    this.bricks = [];\n    let rows = lev.layout.length;\n    let brickH = 27;\n    let gapY = 5;\n    for(let y = 0; y < rows; y++) {\n      let n = lev.layout[y];\n      if(n <= 0) continue;\n      let tot = n * 40 + (n - 1) * 5;\n      let off = (WIDTH - tot) / 2;\n      for(let i = 0; i < n; i++) {\n        let bx = off + i * 45;\n        let by = 58 + y * (brickH + gapY);\n        let brick = { x:bx, y:by, w:40, h:brickH, color:lev.color, alive:true };\n        if(lvIx === 1 && y % 2 === 1) brick.x += (i % 2 === 0 ? 10 : -10);\n        if(lvIx === 2 && (i === 0 || i === n - 1)) brick.h = 31;\n        if(lvIx === 3 && y % 2 === 0) brick.w = 34;\n        if(lvIx === 4 && y === 3) brick.color = '#ff6b35';\n        this.bricks.push(brick);\n      }\n    }\n    this.balls = [{ x:WIDTH/2, y:HEIGHT - 90, vx:4 + lvIx * 0.2, vy:-7 - lvIx * 0.25, r:9, active:false }];\n    this.paddle.w = Math.max(80, 92 - lvIx * 2);\n    this.paddle.x = WIDTH/2 - this.paddle.w / 2;\n    this.paddle.y = HEIGHT - 32;\n    this.paddle.shield = false;\n    this.paddle.shieldTimer = 0;\n    this.timers.pSpawn = performance.now() + 1200;\n    this.beginLevelIntro('LEVEL ' + (this.level + 1));\n  };\n\n  g.nextLevel = function() {\n    if(this.level < this.maxLevel) {\n      this.setLevel(this.level + 1);\n      audio.sfx('level');\n      audio.startMusic(this.level + 1);\n    } else {\n      this.transitionToken++;\n      this.state = 'victory';\n      this.allowLaunch = false;\n      audio.stopMusic();\n      if(this.score > this.hiscore.score) {\n        this.waitingForHighScoreEntry = true;\n        let self = this;\n        setTimeout(function(){\n          promptInitials(self.score, function(init) {\n            setHighScore(init, self.score);\n            self.initials = init;\n            self.hiscore = getHighScore();\n            self.waitingForHighScoreEntry = false;\n            audio.sfx('newhi');\n          });\n        }, 350);\n      }\n    }\n  };\n\n  g.hitBrick = function(ball, brick) {\n    if(!brick.alive) return;\n    brick.alive = false;\n    let scoreGain = this.activePower['scorex2'] ? 20 : 10;\n    scoreGain += Math.min(this.combo, 8) * 2;\n    this.score += scoreGain;\n    audio.sfx('brick');\n    if(Math.random() < FALL_POWERUP_FREQ) this.spawnPowerUp(brick.x + brick.w/2, brick.y + brick.h/2);\n\n    let overlapLeft = (ball.x + ball.r) - brick.x;\n    let overlapRight = (brick.x + brick.w) - (ball.x - ball.r);\n    let overlapTop = (ball.y + ball.r) - brick.y;\n    let overlapBottom = (brick.y + brick.h) - (ball.y - ball.r);\n    let minOverlap = Math.min(overlapLeft, overlapRight, overlapTop, overlapBottom);\n\n    if(minOverlap === overlapLeft) {\n      ball.x = brick.x - ball.r;\n      ball.vx = -Math.abs(ball.vx);\n    } else if(minOverlap === overlapRight) {\n      ball.x = brick.x + brick.w + ball.r;\n      ball.vx = Math.abs(ball.vx);\n    } else if(minOverlap === overlapTop) {\n      ball.y = brick.y - ball.r;\n      ball.vy = -Math.abs(ball.vy);\n    } else {\n      ball.y = brick.y + brick.h + ball.r;\n      ball.vy = Math.abs(ball.vy);\n    }\n  };\n\n  g.spawnPowerUp = function(x, y, type) {\n    let px = x;\n    let py = y;\n    let typ = type;\n    if(px == null) px = 30 + Math.random() * (WIDTH - 60);\n    if(py == null) py = 150 + Math.random() * 140;\n    if(!typ) typ = randOne(POWER_UP_TYPES).type;\n    let pt = null;\n    for(let i = 0; i < POWER_UP_TYPES.length; i++) {\n      if(POWER_UP_TYPES[i].type === typ) pt = POWER_UP_TYPES[i];\n    }\n    if(!pt) pt = randOne(POWER_UP_TYPES);\n    this.powerups.push({ x:px, y:py, r:17, vy:2.6, type:pt.type, label:pt.label, color:pt.color, collected:false });\n 