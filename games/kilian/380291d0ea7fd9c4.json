urn;\n    }\n\n    for(let i = 0; i < this.balls.length; i++) {\n      let ball = this.balls[i];\n      if(!ball.active) {\n        ball.x = this.paddle.x + this.paddle.w / 2;\n        ball.y = this.paddle.y - ball.r - 3;\n        continue;\n      }\n\n      let speedFactor = this.activePower['slow'] ? 0.65 : 1;\n      let levelFactor = 1 + this.level * 0.05;\n      ball.x += ball.vx * speedFactor * levelFactor;\n      ball.y += ball.vy * speedFactor * levelFactor;\n\n      if(ball.x - ball.r < 0) { ball.x = ball.r; ball.vx *= -1; audio.sfx('hit'); }\n      if(ball.x + ball.r > WIDTH) { ball.x = WIDTH - ball.r; ball.vx *= -1; audio.sfx('hit'); }\n      if(ball.y - ball.r < 56) { ball.y = 56 + ball.r; ball.vy *= -1; audio.sfx('hit'); }\n\n      if(circleRectCollision(ball.x, ball.y, ball.r, this.paddle.x, this.paddle.y, this.paddle.w, this.paddle.h) && ball.vy > 0) {\n        ball.y = this.paddle.y - ball.r - 1;\n        ball.vy = -Math.abs(ball.vy) * 1.05;\n        ball.vx += (ball.x - (this.paddle.x + this.paddle.w / 2)) / 36;\n        ball.vx = clamp(ball.vx, -8.5, 8.5);\n        if(Math.abs(ball.vx) < 1.25) ball.vx = ball.vx < 0 ? -1.25 : 1.25;\n        audio.sfx('hit');\n        if(this.activePower['magnet']) ball.active = false;\n        this.combo++;\n        this.comboTimer = 160;\n      }\n\n      if(this.paddle.shield && circleRectCollision(ball.x, ball.y, ball.r, this.paddle.x, this.paddle.y + this.paddle.h, this.paddle.w, 8) && ball.vy > 0) {\n        ball.vy = -Math.abs(ball.vy) * 1.13;\n        audio.sfx('shield');\n        this.paddle.shieldTimer = Math.max(22, this.paddle.shieldTimer - 16);\n        ball.y = this.paddle.y + this.paddle.h - ball.r - 2;\n      }\n\n      for(let j = 0; j < this.bricks.length; j++) {\n        let brick = this.bricks[j];\n        if(!brick.alive) continue;\n        if(circleRectCollision(ball.x, ball.y, ball.r, brick.x, brick.y, brick.w, brick.h)) {\n          this.hitBrick(ball, brick);\n          break;\n        }\n    