ient(ball.x - ball.r * 0.35, ball.y - ball.r * 0.35, 1, ball.x, ball.y, ball.r + 2);\n    grad.addColorStop(0, '#ffffff');\n    grad.addColorStop(0.45, '#dff7ff');\n    grad.addColorStop(1, ball.active ? '#4fc3f7' : '#8bbfd3');\n    ctx.beginPath();\n    ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);\n    ctx.fillStyle = grad;\n    ctx.fill();\n    ctx.lineWidth = 2;\n    ctx.strokeStyle = '#ffffffaa';\n    ctx.stroke();\n    ctx.restore();\n  }\n\n  for(let p = 0; p < game.powerups.length; p++) {\n    let pu = game.powerups[p];\n    ctx.save();\n    ctx.globalAlpha = 0.93;\n    ctx.shadowBlur = 13;\n    ctx.shadowColor = pu.color;\n    ctx.beginPath();\n    ctx.arc(pu.x, pu.y, pu.r, 0, 2 * Math.PI);\n    ctx.fillStyle = pu.color;\n    ctx.fill();\n    ctx.globalAlpha = 1;\n    ctx.font = 'bold 14px monospace';\n    ctx.fillStyle = '#110a33';\n    ctx.fillText(pu.label, pu.x - 14, pu.y + 5);\n    ctx.restore();\n  }\n\n  ctx.save();\n  if(game.state === 'level-intro') {\n    ctx.globalAlpha = 0.92;\n    ctx.fillStyle = 'rgba(0,0,0,0.53)';\n    ctx.fillRect(0, HEIGHT / 2 - 88, WIDTH, 148);\n    ctx.font = 'bold 34px monospace';\n    ctx.fillStyle = '#00ff88';\n    ctx.textAlign = 'center';\n    if(game.message) {\n      ctx.fillText(game.message, WIDTH / 2, HEIGHT / 2 - 28);\n      ctx.font = 'bold 20px monospace';\n      ctx.fillStyle = '#4fc3f7';\n      ctx.fillText('LEVEL ' + (game.level + 1) + ' — ' + LEVELS[game.level].name, WIDTH / 2, HEIGHT / 2 + 8);\n      ctx.font = 'bold 15px monospace';\n      ctx.fillStyle = '#fbc02d';\n      ctx.fillText(LEVELS[game.level].theme, WIDTH / 2, HEIGHT / 2 + 28);\n    } else {\n      ctx.fillText('LEVEL ' + (game.level + 1), WIDTH / 2, HEIGHT / 2 - 17);\n      ctx.font = 'bold 21px monospace';\n      ctx.fillStyle = '#4fc3f7';\n      ctx.fillText(LEVELS[game.level].name, WIDTH / 2, HEIGHT / 2 + 14);\n      ctx.font = 'bold 15px monospace';\n      ctx.fillStyle = '#fbc02d';\n      ctx.fillText(LEVELS[game.level].theme, WIDTH / 2, HEIGHT / 2 + 36);\n    }\n    ctx.font = 'bold 15px monospace';\n    ctx.fillStyle = '#fbc02d';\n    let countdown = Math.max(0, Math.ceil((game.introEndAt - performance.now()) / 1000));\n    if(countdown > 0) ctx.fillText('GET READY ' + countdown, WIDTH / 2, HEIGHT / 2 + 56);\n    else ctx.fillText('TAP OR CLICK TO LAUNCH', WIDTH / 2, HEIGHT / 2 + 56);\n    ctx.textAlign = 'left';\n  } else if(game.state === 'victory') {\n    ctx.globalAlpha = 0.90;\n    ctx.fillStyle = '#031';\n    ctx.fillRect(18, HEIGHT / 2 - 98, WIDTH - 36, 182);\n    ctx.font = 'bold 36px monospace';\n    ctx.fillStyle = '#00ff88';\n    ctx.textAlign = 'center';\n    ctx.fillText('VICTORY!', WIDTH / 2, HEIGHT / 2 - 12);\n    ctx.font = 'bold 18px monospace';\n    ctx.fillStyle = '#4fc3f7';\n    ctx.fillText('SCORE ' + game.score, WIDTH / 2, HEIGHT / 2 + 25);\n    ctx.fillText('HISCORE ' + game.hiscore.initials + ' ' + game.hiscore.score, WIDTH / 2, HEIGHT / 2 + 52);\n    if(!game.waitingForHighScoreEntry) {\n      ctx.font = 'bold 16px monospace';\n      ctx.fillStyle = '#fbc02d';\n      ctx.fillText('TAP TO REPLAY', WIDTH / 2, HEIGHT / 2 + 82);\n    }\n    ctx.textAlign = 'left';\n  } else if(game.state === 'gameover') {\n    ctx.globalAlpha = 0.88;\n    ctx.fillStyle = '#200a06';\n    ctx.fillRect(27, HEIGHT / 2 - 72, WIDTH - 54, 154);\n    ctx.font = 'bold 34px monospace';\n    ctx.fillStyle = '#ff6b35';\n    ctx.textAlign = 'center';\n    ctx.fillText('GAME OVER', WIDTH / 2, HEIGHT / 2);\n    ctx.font = 'bold 17px monospace';\n    ctx.fillStyle = '#4fc3f7';\n    ctx.fillText('SCORE ' + game.score, WIDTH / 2, HEIGHT / 2 + 34);\n    ctx.fillText('HISCORE ' + game.hiscore.initials + ' ' + game.hiscore.score, WIDTH / 2, HEIGHT / 2 + 62);\n    if(!game.waitingForHighScoreEntry) {\n      ctx.font = 'bold 16px monospace';\n      ctx.fillStyle = '#fbc02d';\n      ctx.fillText('TAP TO REPLAY', WIDTH / 2, HEIGHT / 2 + 92);\n    }\n    ctx.textAlign = 'left';\n  } else if(game.state === 'playing' && game.allowLaunch) {\n    let inactiveBall = false;\n    for(let i3 = 0; i3 < game.balls.length; i3++) if(!game.balls[i3].active) inactiveBall = true;\n    if(inactiveBall) {\n      ctx.globalAlpha = 0.68;\n      ctx.fillStyle = 'rgba(0,0,0,0.38)';\n      ctx.fillRect(50, HEIGHT - 110, WIDTH - 100, 42);\n      ctx.font = 'bold 16px monospace';\n      ctx.textAlign = 'center';\n      ctx.fillStyle = '#fbc02d';\n      ctx.fillText('TAP OR CLICK TO LAUNCH', WIDTH / 2, HEIGHT - 82);\n      ctx.textAlign = 'left';\n    }\n  }\n  ctx.restore();\n}\n\nfunction loop(ts) {\n  if(!game) return;\n  if(!game._lastTS) game._lastTS = ts;\n  let dt = Math.min(50, ts - game._lastTS);\n  game._lastTS = ts;\n  game.update(dt);\n  draw();\n  window.__canvasAnimId = requestAnimationFrame(loop);\n}\n\nfunction tryLaunchBall() {\n  if(!game) return false;\n  if(game.state !== 'playing') return false;\n  if(!game.allowLaunch) return false;\n  let launched = false;\n  for(let i = 0; i < game.balls.length; i++) {\n    let b = game.balls[i];\n    if(!b.active) {\n      b.active = true;\n      if(!b.vx || Math.abs(b.vx) < 1.3) b.vx = (Math.random() < 0.5 ? -1 : 1) * (3 + Math.random() * 1.7);\n      b.vy = -Math.abs(b.vy || 7);\n      if(Math.abs(b.vy) < 6.6) b.vy = -6.6;\n      b.x = game.paddle.x + game.paddle.w / 2;\n      b.y = game.paddle.y - b.r - 5;\n      launched = true;\n    }\n  }\n  if(launched) {\n    game.allowLaunch = false;\n    audio.ensureResume();\n    audio.sfx('hit');\n  }\n  return launched;\n}\n\nfunction startGame(autoLaunch) {\n  if(window.__canvasAnimId) cancelAnimationFrame(window.__canvasAnimId);\n  let prompt = document.getElementById('initials-prompt');\n  prompt.style.display = 'none';\n  game = makeGame();\n  game.autoLaunchAfterIntro = !!autoLaunch;\n  game.setLevel(0);\n  game._lastTS = 0;\n  audio.startMusic(0);\n  draw();\n  window.__canvasAnimId = requestAnimationFrame(loop);\n}\n\nfunction handlePrimaryAction() {\n  audio.ensureResume();\n  if(!game) return;\n  if(game.state === 'gameover') {\n    if(game.waitingForHighScoreEntry) return;\n    startGame(true);\n    return;\n  }\n  if(game.state === 'victory') {\n    if(game.waitingForHighScoreEntry) return;\n    startGame(true);\n    return;\n  }\n  if(game.state === 'level-intro') return;\n  tryLaunchBall();\n}\n\nwindow._leftPress = false;\nwindow._rightPress = false;\nwindow._touchX = null;\n\nif(!inputBound) {\n  window.__arcanoidInputBound = true;\n  window.addEventListener('keydown', function(e) {\n    if(e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') window._leftPress = true;\n    if(e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') window._rightPress = true;\n    if(e.key === ' ' || e.key === 'Enter') handlePrimaryAction();\n  });\n  window.addEventListener('keyup', function(e) {\n    if(e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') window._leftPress = false;\n    if(e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') window._rightPress = false;\n  });\n\n  canvas.addEventListener('mousedown', function(e) {\n    if(e.button !== 0) return;\n    let r = canvas.getBoundingClientRect();\n    let cx = clamp(e.clientX - r.left, 0, WIDTH);\n    window._touchX = cx;\n    handlePrimaryAction();\n  });\n  canvas.addEventListener('mousemove', function(e) {\n    if((e.buttons & 1) === 0) return;\n    let r = canvas.getBoundingClientRect();\n    let cx = clamp(e.clientX - r.left, 0, WIDTH);\n    window._touchX = cx;\n  });\n  window.addEventListener('mouseup', function() {\n    window._touchX = null;\n  });\n\n  canvas.addEventListener('touchstart', function(e) {\n    let r = canvas.getBoundingClientRect();\n    let t = e.touches[0];\n    let cx = clamp(t.clientX - r.left, 0, WIDTH);\n    window._touchX = cx;\n    handlePrimaryAction();\n    e.preventDefault();\n  }, {passive:false});\n\n  canvas.addEventListener('touchmove', function(e) {\n    let r = canvas.getBoundingClientRect();\n    let t = e.touches[0];\n    let cx = clamp(t.clientX - r.left, 0, WIDTH);\n    window._touchX = cx;\n    e.preventDefault();\n  }, {passive:false});\n\n  canvas.addEventListener('touchend', function(e) {\n    window._touchX = null;\n    e.preventDefault();\n  }, {passive:false});\n}\n\nstartGame(false);\n</script>\n</body>\n</html>",
