{
  "name": "Cut The Rope Canvas Edition",
  "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=390, initial-scale=1, maximum-scale=1, user-scalable=no\" />\n<title>Cut the Rope - Canvas Edition</title>\n<style>\n  html, body {\n    margin: 0;\n    width: 390px;\n    height: 844px;\n    overflow: hidden;\n    background: #0a0a0a;\n    font-family: Arial, Helvetica, sans-serif;\n  }\n  body {\n    position: relative;\n    color: #eafff6;\n  }\n  #wrap {\n    position: relative;\n    width: 390px;\n    height: 844px;\n    overflow: hidden;\n    background:\n      radial-gradient(circle at 20% 10%, rgba(79,195,247,0.12), transparent 30%),\n      radial-gradient(circle at 80% 20%, rgba(0,255,136,0.12), transparent 25%),\n      linear-gradient(180deg, #111 0%, #0a0a0a 100%);\n  }\n  canvas {\n    display: block;\n    width: 390px;\n    height: 844px;\n    background: transparent;\n  }\n  #ui {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n  }\n  .panel {\n    position: absolute;\n    left: 10px;\n    right: 10px;\n    top: 10px;\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 8px;\n    font-size: 14px;\n    text-shadow: 0 0 8px rgba(0,0,0,0.8);\n  }\n  .chip {\n    background: rgba(255,255,255,0.06);\n    border: 1px solid rgba(255,255,255,0.14);\n    border-radius: 12px;\n    padding: 8px 10px;\n    backdrop-filter: blur(3px);\n    box-shadow: 0 0 14px rgba(0,255,136,0.06);\n  }\n  #centerMsg {\n    position: absolute;\n    left: 50%;\n    top: 50%;\n    transform: translate(-50%, -50%);\n    width: 310px;\n    text-align: center;\n    pointer-events: none;\n    text-shadow: 0 0 12px rgba(0,0,0,0.9);\n  }\n  #overlay {\n    position: absolute;\n    inset: 0;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    background: rgba(0,0,0,0.62);\n    pointer-events: auto;\n  }\n  #card {\n    width: 320px;\n    background: linear-gradient(180deg, rgba(20,20,20,0.95), rgba(10,10,10,0.98));\n    border: 1px solid rgba(255,255,255,0.12);\n    border-radius: 18px;\n    box-shadow: 0 0 30px rgba(0,255,136,0.08), 0 0 60px rgba(79,195,247,0.08);\n    padding: 18px;\n    color: #f1fff8;\n    text-align: center;\n  }\n  #card h2 {\n    margin: 6px 0 10px;\n    color: #00ff88;\n    font-size: 28px;\n    letter-spacing: 1px;\n  }\n  #card p {\n    margin: 8px 0;\n    color: #d7efe6;\n    line-height: 1.35;\n  }\n  #initialsRow {\n    display: none;\n    margin-top: 12px;\n    gap: 8px;\n    justify-content: center;\n    align-items: center;\n  }\n  #initialsInput {\n    width: 90px;\n    text-align: center;\n    font-size: 24px;\n    letter-spacing: 6px;\n    border-radius: 10px;\n    border: 1px solid rgba(255,255,255,0.18);\n    background: #0f1512;\n    color: #fff;\n    padding: 10px;\n    outline: none;\n    text-transform: uppercase;\n  }\n  button {\n    pointer-events: auto;\n    border: none;\n    border-radius: 12px;\n    padding: 12px 16px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n    cursor: pointer;\n    background: linear-gradient(180deg, #00ff88, #0ccf79);\n    color: #062515;\n    box-shadow: 0 6px 18px rgba(0,255,136,0.25);\n  }\n  button.secondary {\n    background: linear-gradient(180deg, #4fc3f7, #2e9cd0);\n    color: #041923;\n    box-shadow: 0 6px 18px rgba(79,195,247,0.25);\n  }\n  #bottomBar {\n    position: absolute;\n    left: 10px;\n    right: 10px;\n    bottom: 10px;\n    display: flex;\n    justify-content: space-between;\n    gap: 8px;\n    align-items: center;\n    pointer-events: auto;\n  }\n  #powerups {\n    flex: 1;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n    align-items: center;\n  }\n  .pBadge {\n    font-size: 11px;\n    border-radius: 999px;\n    padding: 5px 8px;\n    border: 1px solid rgba(255,255,255,0.14);\n    background: rgba(255,255,255,0.08);\n    color: #fff;\n    min-height: 20px;\n  }\n  #muteBtn {\n    min-width: 86px;\n  }\n</style>\n</head>\n<body>\n<div id=\"wrap\">\n  <canvas width=\"390\" height=\"844\"></canvas>\n  <div id=\"ui\">\n    <div class=\"panel\">\n      <div class=\"chip\" id=\"scoreBox\">Score: 0<br>Lives: 3</div>\n      <div class=\"chip\" id=\"highBox\">High: AAA 0<br>Level: 1</div>\n    </div>\n    <div id=\"centerMsg\"></div>\n    <div id=\"overlay\">\n      <div id=\"card\">\n        <h2 id=\"titleText\">CUT THE ROPE</h2>\n        <p id=\"descText\">Slice ropes to feed the candy into Om Nom across 6 colorful levels.</p>\n        <div id=\"initialsRow\">\n          <input id=\"initialsInput\" maxlength=\"3\" value=\"AAA\" />\n        </div>\n        <div style=\"display:flex;gap:10px;justify-content:center;margin-top:14px;flex-wrap:wrap;\">\n          <button id=\"mainBtn\">START</button>\n          <button class=\"secondary\" id=\"altBtn\">HOW TO PLAY</button>\n        </div>\n      </div>\n    </div>\n    <div id=\"bottomBar\">\n      <div id=\"powerups\"></div>\n      <button id=\"muteBtn\">MUTE: OFF</button>\n    </div>\n  </div>\n</div>\n<script>\nif (window.__canvasAnimId) cancelAnimationFrame(window.__canvasAnimId);\nlet canvas = document.querySelector('canvas');\nlet ctx = canvas.getContext('2d');\nlet W = 390;\nlet H = 844;\n\nlet scoreBox = document.getElementById('scoreBox');\nlet highBox = document.getElementById('highBox');\nlet centerMsg = document.getElementById('centerMsg');\nlet overlay = document.getElementById('overlay');\nlet titleText = document.getElementById('titleText');\nlet descText = document.getElementById('descText');\nlet mainBtn = document.getElementById('mainBtn');\nlet altBtn = document.getElementById('altBtn');\nlet muteBtn = document.getElementById('muteBtn');\nlet powerupsEl = document.getElementById('powerups');\nlet initialsRow = document.getElementById('initialsRow');\nlet initialsInput = document.getElementById('initialsInput');\n\nlet AudioCtx = window.AudioContext || window.webkitAudioContext;\nlet audioCtx = AudioCtx ? new AudioCtx() : null;\nlet masterGain = audioCtx ? audioCtx.createGain() : null;\nif (masterGain) {\n  masterGain.gain.value = 0.08;\n  masterGain.connect(audioCtx.destination);\n}\nlet musicTimer = 0;\nlet musicBeat = 0;\nlet muted = false;\n\nlet high = JSON.parse(localStorage.getItem('cutrope_high') || '{\"initials\":\"AAA\",\"score\":0}');\nif (!high.initials) high = { initials: 'AAA', score: 0 };\n\nlet state = 'menu';\nlet levelIndex = 0;\nlet score = 0;\nlet lives = 3;\nlet timer = 0;\nlet gravity = 0.26;\nlet mouse = { x: -999, y: -999, down: false, px: -999, py: -999 };\nlet stars = [];\nlet sparks = [];\nlet floatingPowerups = [];\nlet activePowerups = [];\nlet globalDropTimer = 0;\nlet introTimer = 0;\nlet victoryShown = false;\nlet awaitingHigh = false;\n\nlet candy = null;\nlet ropes = [];\nlet bubbles = [];\nlet starsLevel = [];\nlet omnom = null;\nlet hazards = [];\nlet bumpers = [];\nlet portals = [];\nlet emitters = [];\n\nlet powerTypes = [\n  { key: 'life', label: '1UP', color: '#00ff88', dur: 0 },\n  { key: 'shield', label: 'SHD', color: '#4fc3f7', dur: 10 },\n  { key: 'slow', label: 'SLOW', color: '#ffd54f', dur: 9 },\n  { key: 'double', label: '2X', color: '#ff6b35', dur: 10 },\n  { key: 'magnet', label: 'MAG', color: '#c084ff', dur: 9 },\n  { key: 'ghost', label: 'GHO', color: '#90caf9', dur: 8 },\n  { key: 'freeze', label: 'FRZ', color: '#80deea', dur: 4 },\n  { key: 'bomb', label: 'BOMB', color: '#ef5350', dur: 0 }\n];\n\nlet levels = [\n  {\n    name: 'LEVEL 1 - SWEET START',\n    bg: ['#10151b', '#0a0a0a'],\n    candy: { x: 195, y: 120 },\n    anchors: [{ x: 130, y: 50 }, { x: 260, y: 50 }],\n    stars: [{ x: 105, y: 240 }, { x: 285, y: 330 }, { x: 195, y: 470 }],\n    omnom: { x: 195, y: 735 },\n    bubbles: [{ x: 330, y: 410, r: 28 }],\n    hazards: [],\n    bumpers: [{ x: 80, y: 420, r: 24 }],\n    portals: [],\n    emitters: []\n  },\n  {\n    name: 'LEVEL 2 - SPIKE DROP',\n    bg: ['#1a1016', '#0a0a0a'],\n    candy: { x: 110, y: 120 },\n    anchors: [{ x: 80, y: 45 }, { x: 190, y: 130 }],\n    stars: [{ x: 220, y: 180 }, { x: 300, y: 360 }, { x: 160, y: 610 }],\n    omnom: { x: 310, y: 735 },\n    bubbles: [{ x: 250, y: 280, r: 24 }],\n    hazards: [{ x: 170, y: 515, w: 90, h: 18 }, { x: 40, y: 300, w: 70, h: 16 }],\n    bumpers: [{ x: 90, y: 560, r: 20 }],\n    portals: [],\n    emitters: [{ x: 60, y: 680, dir: 1 }]\n  },\n  {\n    name: 'LEVEL 3 - TWIN SWING',\n    bg: ['#091822', '#0a0a0a'],\n    candy: { x: 195, y: 145 },\n    anchors: [{ x: 110, y: 50 }, { x: 280, y: 50 }, { x: 195, y: 85 }],\n    stars: [{ x: 80, y: 290 }, { x: 305, y: 300 }, { x: 195, y: 560 }],\n    omnom: { x: 195, y: 735 },\n    bubbles: [{ x: 330, y: 200, r: 26 }, { x: 55, y: 470, r: 26 }],\n    hazards: [{ x: 135, y: 420, w: 120, h: 16 }],\n    bumpers: [{ x: 315, y: 520, r: 22 }, { x: 78, y: 640, r: 18 }],\n    portals: [{ a: { x: 45, y: 190, r: 18 }, b: { x: 345, y: 620, r: 18 } }],\n    emitters: []\n  },\n  {\n    name: 'LEVEL 4 - WIND TUNNEL',\n    bg: ['#121020', '#06060a'],\n    candy: { x: 310, y: 115 },\n    anchors: [{ x: 340, y: 45 }, { x: 250, y: 70 }],\n    stars: [{ x: 300, y: 250 }, { x: 150, y: 350 }, { x: 85, y: 575 }],\n    omnom: { x: 75, y: 735 },\n    bubbles: [{ x: 115, y: 240, r: 22 }],\n    hazards: [{ x: 245, y: 465, w: 110, h: 18 }, { x: 30, y: 640, w: 75, h: 18 }],\n    bumpers: [{ x: 185, y: 540, r: 24 }],\n    portals: [],\n    emitters: [{ x: 340, y: 300, dir: -1 }, { x: 50, y: 470, dir: 1 }]\n  },\n  {\n    name: 'LEVEL 5 - PORTAL BITE',\n    bg: ['#0f1710', '#050708'],\n    candy: { x: 195, y: 100 },\n    anchors: [{ x: 130, y: 40 }, { x: 260, y: 40 }],\n    stars: [{ x: 70, y: 190 }, { x: 320, y: 320 }, { x: 170, y: 640 }],\n    omnom: { x: 315, y: 735 },\n    bubbles: [{ x: 95, y: 500, r: 25 }, { x: 290, y: 540, r: 24 }],\n    hazards: [{ x: 135, y: 260, w: 120, h: 18 }, { x: 100, y: 430, w: 90, h: 16 }],\n    bumpers: [{ x: 325, y: 200, r: 20 }],\n    portals: [{ a: { x: 55, y: 350, r: 18 }, b: { x: 340, y: 150, r: 18 } }],\n    emitters: [{ x: 60, y: 610, dir: 1 }]\n  },\n  {\n    name: 'LEVEL 6 - MASTER CHOMP',\n    bg: ['#20140a', '#080808'],\n    candy: { x: 90, y: 95 },\n    anchors: [{ x: 65, y: 35 }, { x: 150, y: 100 }, { x: 250, y: 55 }],\n    stars: [{ x: 235, y: 160 }, { x: 295, y: 420 }, { x: 105, y: 620 }],\n    omnom: { x: 195, y: 735 },\n    bubbles: [{ x: 315, y: 275, r: 24 }, { x: 120, y: 365, r: 24 }],\n    hazards: [{ x: 145, y: 300, w: 95, h: 16 }, { x: 45, y: 520, w: 85, h: 16 }, { x: 245, y: 590, w: 100, h: 16 }],\n    bumpers: [{ x: 180, y: 210, r: 18 }, { x: 80, y: 710, r: 20 }],\n    portals: [{ a: { x: 340, y: 470, r: 18 }, b: { x: 48, y: 215, r: 18 } }],\n    emitters: [{ x: 335, y: 640, dir: -1 }, { x: 60, y: 260, dir: 1 }]\n  }\n];\n\nfunction resumeAudio() {\n  if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();\n}\n\nfunction tone(freq, dur, type, vol, when) {\n  if (!audioCtx || muted) return;\n  let t = audioCtx.currentTime + (when || 0);\n  let o = audioCtx.createOscillator();\n  let g = audioCtx.createGain();\n  o.type = type || 'sine';\n  o.frequency.setValueAtTime(freq, t);\n  g.gain.setValueAtTime(0.0001, t);\n  g.gain.exponentialRampToValueAtTime(vol || 0.08, t + 0.01);\n  g.gain.exponentialRampToValueAtTime(0.0001, t + dur);\n  o.connect(g);\n  g.connect(masterGain);\n  o.start(t);\n  o.stop(t + dur + 0.02);\n}\n\nfunction sfx(name) {\n  if (name === 'cut') { tone(760, 0.08, 'square', 0.07, 0); tone(520, 0.08, 'triangle', 0.05, 0.02); }\n  if (name === 'star') { tone(900, 0.07, 'triangle', 0.08, 0); tone(1200, 0.09, 'triangle', 0.08, 0.04); }\n  if (name === 'collect') { tone(420, 0.12, 'sine', 0.08, 0); tone(620, 0.12, 'sine', 0.07, 0.08); }\n  if (name === 'bubble') { tone(250, 0.12, 'sine', 0.05, 0); tone(430, 0.08, 'sine', 0.04, 0.08); }\n  if (name === 'hit') { tone(180, 0.08, 'sawtooth', 0.06, 0); }\n  if (name === 'lose') { tone(240, 0.15, 'square', 0.08, 0); tone(160, 0.2, 'square', 0.06, 0.12); }\n  if (name === 'level') { tone(520, 0.12, 'triangle', 0.08, 0); tone(780, 0.12, 'triangle', 0.08, 0.12); tone(1040, 0.16, 'triangle', 0.08, 0.24); }\n  if (name === 'gameover') { tone(260, 0.18, 'sawtooth', 0.07, 0); tone(180, 0.22, 'sawtooth', 0.07, 0.2); tone(120, 0.28, 'sawtooth', 0.06, 0.42); }\n  if (name === 'high') { tone(880, 0.12, 'triangle', 0.08, 0); tone(1175, 0.12, 'triangle', 0.08, 0.12); tone(1568, 0.16, 'triangle', 0.08, 0.24); }\n  if (name === 'power') { tone(640, 0.08, 'square', 0.07, 0); tone(860, 0.1, 'triangle', 0.07, 0.06); }\n}\n\nfunction musicStep() {\n  if (!audioCtx || muted || state === 'menu' || state === 'gameover' || state === 'victory') return;\n  let scales = [220, 247, 262, 294, 330, 392, 440, 523];\n  let idx = (musicBeat + levelIndex * 2) % scales.length;\n  let bass = 110 + levelIndex * 12;\n  tone(scales[idx], 0.14, 'triangle', 0.028, 0);\n  if (musicBeat % 2 === 0) tone(bass, 0.18, 'sine', 0.025, 0);\n  if (levelIndex >= 3 && musicBeat % 4 === 1) tone(scales[(idx + 2) % scales.length] * 2, 0.08, 'square', 0.014, 0);\n  musicBeat++;\n}\n\nfunction rand(a, b) { return a + Math.random() * (b - a); }\nfunction dist(ax, ay, bx, by) { let dx = bx - ax; let dy = by - ay; return Math.sqrt(dx * dx + dy * dy); }\nfunction clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }\n\nfor (let i = 0; i < 65; i++) stars.push({ x: Math.random() * W, y: Math.random() * H, r: Math.random() * 1.7 + 0.4, a: Math.random() * 0.7 + 0.2 });\n\nfunction spawnPowerup(x, y, forcedKey) {\n  let p = forcedKey ? powerTypes.find(function(t){ return t.key === forcedKey; }) : powerTypes[(Math.random() * powerTypes.length) | 0];\n  if (!p) return;\n  floatingPowerups.push({ x: x, y: y, vx: rand(-0.7, 0.7), vy: rand(-0.4, 0.4), r: 16, type: p.key, label: p.label, color: p.color, life: 12 });\n}\n\nfunction addActivePower(key, dur) {\n  if (key === 'life') {\n    lives++;\n    return;\n  }\n  if (key === 'bomb') {\n    for (let i = hazards.length - 1; i >= 0; i--) {\n      let hz = hazards[i];\n      for (let k = 0; k < 16; k++) sparks.push({ x: hz.x + Math.random() * hz.w, y: hz.y + Math.random() * hz.h, vx: rand(-2, 2), vy: rand(-2, 2), life: 24, color: '#ef5350' });\n    }\n    hazards = [];\n    return;\n  }\n  let existing = activePowerups.find(function(a){ return a.key === key; });\n  if (existing) existing.t = Math.max(existing.t, dur);\n  else activePowerups.push({ key: key, t: dur });\n}\n\nfunction hasPower(key) {\n  return activePowerups.some(function(a){ return a.key === key && a.t > 0; });\n}\n\nfunction usePowerup(obj) {\n  let p = powerTypes.find(function(t){ return t.key === obj.type; });\n  if (!p) return;\n  addActivePower(p.key, p.dur);\n  sfx('power');\n  for (let i = 0; i < 14; i++) sparks.push({ x: obj.x, y: obj.y, vx: rand(-2.5, 2.5), vy: rand(-2.5, 2.5), life: 28, color: obj.color });\n}\n\nfunction buildLevel(i) {\n  let lv = levels[i];\n  let cx = lv.candy.x;\n  let cy = lv.candy.y;\n  candy = { x: cx, y: cy, vx: 0, vy: 0, r: 18, attachedBubble: null, alive: true, teleCD: 0 };\n  ropes = [];\n  for (let a = 0; a < lv.anchors.length; a++) {\n    let an = lv.anchors[a];\n    ropes.push({ x: an.x, y: an.y, len: dist(an.x, an.y, cx, cy), cut: false, sway: Math.random() * Math.PI * 2 });\n  }\n  bubbles = lv.bubbles.map(function(b){ return { x: b.x, y: b.y, r: b.r, used: false }; });\n  starsLevel = lv.stars.map(function(s){ return { x: s.x, y: s.y, r: 12, got: false, pulse: Math.random() * Math.PI * 2 }; });\n  omnom = { x: lv.omnom.x, y: lv.omnom.y, r: 32, mouth: 0 };\n  hazards = lv.hazards.map(function(h){ return { x: h.x, y: h.y, w: h.w, h: h.h }; });\n  bumpers = lv.bumpers.map(function(b){ return { x: b.x, y: b.y, r: b.r }; });\n  portals = lv.portals.map(function(p){ return { a: { x: p.a.x, y: p.a.y, r: p.a.r }, b: { x: p.b.x, y: p.b.y, r: p.b.r } }; });\n  emitters = lv.emitters.map(function(e){ return { x: e.x, y: e.y, dir: e.dir, t: Math.random() * 60 }; });\n  introTimer = 90;\n  state = 'intro';\n  centerMsg.innerHTML = '<div style=\"font-size:28px;color:#00ff88;font-weight:800;letter-spacing:1px;\">' + lv.name + '</div><div style=\"margin-top:8px;color:#cdece0;font-size:14px;\">Feed the candy to Om Nom</div>';\n  sfx('level');\n}\n\nfunction resetRun() {\n  score = 0;\n  lives = 3;\n  levelIndex = 0;\n  activePowerups = [];\n  floatingPowerups = [];\n  globalDropTimer = 240;\n  victoryShown = false;\n  awaitingHigh = false;\n  buildLevel(0);\n}\n\nfunction nextLevel() {\n  levelIndex++;\n  activePowerups = activePowerups.filter(function(p){ return p.key === 'double' || p.key === 'life'; });\n  if (levelIndex >= levels.length) {\n    state = 'victory';\n    centerMsg.innerHTML = '';\n    showOverlay('VICTORY!', 'You cleared all levels. Final Score: ' + score, true, false);\n    return;\n  }\n  buildLevel(levelIndex);\n}\n\nfunction loseLife() {\n  if (hasPower('shield') || hasPower('ghost')) {\n    addActivePower('shield', 0);\n    activePowerups = activePowerups.filter(function(p){ return p.key !== 'shield'; });\n    candy.x = clamp(candy.x, 40, W - 40);\n    candy.y = clamp(candy.y, 60, H - 160);\n    candy.vx *= -0.4;\n    candy.vy *= -0.4;\n    return;\n  }\n  lives--;\n  sfx('lose');\n  if (lives <= 0) {\n    endGame(false);\n  } else {\n    buildLevel(levelIndex);\n  }\n}\n\nfunction endGame(win) {\n  state = win ? 'victory' : 'gameover';\n  centerMsg.innerHTML = '';\n  if (!win) sfx('gameover');\n  let isNew = score > high.score;\n  awaitingHigh = isNew;\n  if (isNew) {\n    initialsRow.style.display = 'flex';\n    initialsInput.value = (high.initials || 'AAA').slice(0, 3).toUpperCase();\n    showOverlay(win ? 'VICTORY!' : 'GAME OVER', 'New high score! Enter initials.', true, true);\n    sfx('high');\n  } else {\n    initialsRow.style.display = 'none';\n    showOverlay(win ? 'VICTORY!' : 'GAME OVER', 'Score: ' + score + '<br>High: ' + high.initials + ' ' + high.score, true, false);\n  }\n}\n\nfunction saveHighIfNeeded() {\n  if (!awaitingHigh) return;\n  let val = (initialsInput.value || 'AAA').toUpperCase().replace(/[^A-Z]/g, '').slice(0, 3);\n  while (val.length < 3) val += 'A';\n  high = { initials: val, score: score };\n  localStorage.setItem('cutrope_high', JSON.stringify(high));\n  awaitingHigh = false;\n}\n\nfunction showOverlay(title, desc, showMain, showInput) {\n  overlay.style.display = 'flex';\n  titleText.innerHTML = title;\n  descText.innerHTML = desc;\n  mainBtn.style.display = showMain ? 'inline-block' : 'none';\n  altBtn.style.display = 'inline-block';\n  initialsRow.style.display = showInput ? 'flex' : 'none';\n}\n\nshowOverlay('CUT THE ROPE', 'Slice ropes with your finger or mouse. Collect stars, dodge hazards, use power-ups, and feed Om Nom across 6 levels.', true, false);\naltBtn.onclick = function() {\n  resumeAudio();\n  if (state === 'menu' || state === 'gameover' || state === 'victory') {\n    descText.innerHTML = 'How to play:<br>• Swipe across ropes to cut them<br>• Pop bubbles to float upward<br>• Candy must reach Om Nom\\'s mouth<br>• Stars add points<br>• Avoid spikes and losing candy off-screen<br>• Power-ups fall from stars and timer drops';\n  } else {\n    descText.innerHTML = 'Back in game. Slice ropes and guide the candy.';\n  }\n};\nmainBtn.onclick = function() {\n  resumeAudio();\n  if (awaitingHigh) saveHighIfNeeded();\n  overlay.style.display = 'none';\n  if (state === 'menu' || state === 'gameover' || state === 'victory') resetRun();\n};\nmuteBtn.onclick = function() {\n  muted = !muted;\n  muteBtn.textContent = 'MUTE: ' + (muted ? 'ON' : 'OFF');\n  if (masterGain) masterGain.gain.value = muted ? 0 : 0.08;\n};\ninitialsInput.oninput = function() {\n  initialsInput.value = initialsInput.value.toUpperCase().replace(/[^A-Z]/g, '').slice(0,3);\n};\n\nfunction pointerPos(e) {\n  let r = canvas.getBoundingClientRect();\n  return { x: (e.clientX - r.left) * (W / r.width), y: (e.clientY - r.top) * (H / r.height) };\n}\nfunction startPointer(x, y) { resumeAudio(); mouse.down = true; mouse.x = x; mouse.y = y; mouse.px = x; mouse.py = y; }\nfunction movePointer(x, y) { mouse.px = mouse.x; mouse.py = mouse.y; mouse.x = x; mouse.y = y; }\nfunction endPointer() { mouse.down = false; mouse.x = mouse.y = mouse.px = mouse.py = -999; }\ncanvas.addEventListener('mousedown', function(e){ let p = pointerPos(e); startPointer(p.x, p.y); });\ncanvas.addEventListener('mousemove', function(e){ let p = pointerPos(e); movePointer(p.x, p.y); });\nwindow.addEventListener('mouseup', function(){ endPointer(); });\ncanvas.addEventListener('touchstart', function(e){ let t = e.touches[0]; let p = pointerPos(t); startPointer(p.x, p.y); e.preventDefault(); }, { passive: false });\ncanvas.addEventListener('touchmove', function(e){ let t = e.touches[0]; let p = pointerPos(t); movePointer(p.x, p.y); e.preventDefault(); }, { passive: false });\ncanvas.addEventListener('touchend', function(){ endPointer(); });\n\nfunction segCircleHit(x1, y1, x2, y2, cx, cy, r) {\n  let dx = x2 - x1;\n  let dy = y2 - y1;\n  let l2 = dx * dx + dy * dy;\n  if (l2 <= 0.0001) return dist(x1, y1, cx, cy) <= r;\n  let t = ((cx - x1) * dx + (cy - y1) * dy) / l2;\n  t = clamp(t, 0, 1);\n  let px = x1 + dx * t;\n  let py = y1 + dy * t;\n  return dist(px, py, cx, cy) <= r;\n}\n\nfunction cutRopes() {\n  if (!mouse.down || !candy) return;\n  for (let i = 0; i < ropes.length; i++) {\n    let rp = ropes[i];\n    if (rp.cut) continue;\n    if (segCircleHit(mouse.px, mouse.py, mouse.x, mouse.y, (rp.x + candy.x) * 0.5, (rp.y + candy.y) * 0.5, 18) || segCircleHit(mouse.px, mouse.py, mouse.x, mouse.y, rp.x + (candy.x - rp.x) * 0.25, rp.y + (candy.y - rp.y) * 0.25, 16) || segCircleHit(mouse.px, mouse.py, mouse.x, mouse.y, rp.x + (candy.x - rp.x) * 0.75, rp.y + (candy.y - rp.y) * 0.75, 16)) {\n      rp.cut = true;\n      candy.vx += rand(-1.2, 1.2);\n      candy.vy += rand(-0.4, 0.8);\n      sfx('cut');\n      for (let k = 0; k < 8; k++) sparks.push({ x: mouse.x, y: mouse.y, vx: rand(-2.6, 2.6), vy: rand(-2.6, 2.6), life: 20, color: '#4fc3f7' });\n    }\n  }\n}\n\nfunction updateGame() {\n  timer++;\n  globalDropTimer--;\n  if (globalDropTimer <= 0) {\n    spawnPowerup(rand(40, W - 40), 100 + rand(0, 240));\n    globalDropTimer = 240 + (Math.random() * 180 | 0);\n  }\n  for (let i = activePowerups.length - 1; i >= 0; i--) {\n    if (activePowerups[i].t > 0) activePowerups[i].t -= 1 / 60;\n    if (activePowerups[i].t <= 0) activePowerups.splice(i, 1);\n  }\n  if (!candy) return;\n  cutRopes();\n\n  let gMul = hasPower('slow') ? 0.55 : 1;\n  let pullX = 0;\n  for (let i = 0; i < emitters.length; i++) {\n    emitters[i].t += 0.05;\n    let d = dist(candy.x, candy.y, emitters[i].x, candy.y);\n    if (Math.abs(candy.y - emitters[i].y || 0) < 180 || true) {\n      let dx = candy.x - emitters[i].x;\n      let strength = clamp(180 / (Math.abs(dx) + 80), 0, 1.2);\n      if (Math.abs(candy.y - emitters[i].y) < 160 || !emitters[i].y) pullX += emitters[i].dir * strength * 0.06;\n    }\n  }\n\n  let attached = false;\n  for (let i = 0; i < ropes.length; i++) {\n    let rp = ropes[i];\n    if (rp.cut) continue;\n    attached = true;\n    let dx = candy.x - rp.x;\n    let dy = candy.y - rp.y;\n    let d = Math.sqrt(dx * dx + dy * dy) || 0.0001;\n    let diff = d - rp.len;\n    let nx = dx / d;\n    let ny = dy / d;\n    candy.x -= nx * diff * 0.58;\n    candy.y -= ny * diff * 0.58;\n    let radial = candy.vx * nx + candy.vy * ny;\n    candy.vx -= radial * nx * 0.3;\n    candy.vy -= radial * ny * 0.3;\n    let swing = Math.sin(timer * 0.03 + rp.sway) * 0.02 * (levelIndex + 1);\n    candy.vx += swing;\n  }\n\n  if (candy.attachedBubble !== null) {\n    let b = bubbles[candy.attachedBubble];\n    if (b && !b.used) {\n      candy.x += (b.x - candy.x) * 0.15;\n      candy.y += (b.y - candy.y) * 0.15;\n      candy.vx *= 0.92;\n      candy.vy = -1.4;\n      if (mouse.down && dist(mouse.x, mouse.y, b.x, b.y) < b.r + 10) {\n        b.used = true;\n        candy.attachedBubble = null;\n        sfx('bubble');\n        for (let k = 0; k < 12; k++) sparks.push({ x: b.x, y: b.y, vx: rand(-2, 2), vy: rand(-2, 2), life: 24, color: '#80deea' });\n      }\n    }\n  } else {\n    candy.vx += pullX;\n    candy.vy += gravity * gMul;\n    if (hasPower('freeze')) {\n      candy.vx *= 0.96;\n      candy.vy *= 0.96;\n    }\n    candy.x += candy.vx;\n    candy.y += candy.vy;\n  }\n\n  if (hasPower('magnet')) {\n    for (let i = 0; i < starsLevel.length; i++) {\n      let st = starsLevel[i];\n      if (st.got) continue;\n      let d = dist(candy.x, candy.y, st.x, st.y);\n      if (d < 130) {\n        st.x += (candy.x - st.x) * 0.06;\n        st.y += (candy.y - st.y) * 0.06;\n      }\n    }\n  }\n\n  candy.vx *= attached ? 0.994 : 0.998;\n  candy.vy *= 0.998;\n\n  for (let i = 0; i < bumpers.length; i++) {\n    let b = bumpers[i];\n    let d = dist(candy.x, candy.y, b.x, b.y);\n    let minD = candy.r + b.r;\n    if (d < minD) {\n      let nx = (candy.x - b.x) / (d || 1);\n      let ny = (candy.y - b.y) / (d || 1);\n      candy.x = b.x + nx * minD;\n      candy.y = b.y + ny * minD;\n      let vdot = candy.vx * nx + candy.vy * ny;\n      candy.vx -= 2 * vdot * nx;\n      candy.vy -= 2 * vdot * ny;\n      candy.vx *= 1.04;\n      candy.vy *= 1.04;\n      sfx('hit');\n    }\n  }\n\n  for (let i = 0; i < portals.length; i++) {\n    let p = portals[i];\n    if (candy.teleCD > 0) break;\n    if (dist(candy.x, candy.y, p.a.x, p.a.y) < candy.r + p.a.r) {\n      candy.x = p.b.x;\n      candy.y = p.b.y;\n      candy.teleCD = 25;\n      sfx('collect');\n    } else if (dist(candy.x, candy.y, p.b.x, p.b.y) < candy.r + p.b.r) {\n      candy.x = p.a.x;\n      candy.y = p.a.y;\n      candy.teleCD = 25;\n      sfx('collect');\n    }\n  }\n  if (candy.teleCD > 0) candy.teleCD--;\n\n  for (let i = 0; i < bubbles.length; i++) {\n    let b = bubbles[i];\n    if (!b.used && candy.attachedBubble === null && dist(candy.x, candy.y, b.x, b.y) < candy.r + b.r) {\n      candy.attachedBubble = i;\n      sfx('bubble');\n    }\n  }\n\n  for (let i = 0; i < starsLevel.length; i++) {\n    let st = starsLevel[i];\n    st.pulse += 0.08;\n    if (!st.got && dist(candy.x, candy.y, st.x, st.y) < candy.r + st.r + 4) {\n      st.got = true;\n      let gain = hasPower('double') ? 200 : 100;\n      score += gain;\n      sfx('star');\n      if (Math.random() < 0.45) spawnPowerup(st.x, st.y);\n      for (let k = 0; k < 14; k++) sparks.push({ x: st.x, y: st.y, vx: rand(-2.6, 2.6), vy: rand(-2.6, 2.6), life: 26, color: '#ffd54f' });\n    }\n  }\n\n  for (let i = 0; i < hazards.length; i++) {\n    let h = hazards[i];\n    let cx = clamp(candy.x, h.x, h.x + h.w);\n    let cy = clamp(candy.y, h.y, h.y + h.h);\n    if (dist(candy.x, candy.y, cx, cy) < candy.r) {\n      if (!hasPower('ghost')) {\n        loseLife();\n        return;\n      }\n    }\n  }\n\n  if (dist(candy.x, candy.y, omnom.x, omnom.y) < candy.r + omnom.r + 6) {\n    score += hasPower('double') ? 300 : 150;\n    sfx('collect');\n    nextLevel();\n    return;\n  }\n\n  if (candy.y > H + 50 || candy.x < -60 || candy.x > W + 60) {\n    loseLife();\n    return;\n  }\n\n  for (let i = floatingPowerups.length - 1; i >= 0; i--) {\n    let p = floatingPowerups[i];\n    p.life -= 1 / 60;\n    p.vy += 0.01;\n    p.x += p.vx;\n    p.y += p.vy;\n    if (dist(candy.x, candy.y, p.x, p.y) < candy.r + p.r) {\n      usePowerup(p);\n      floatingPowerups.splice(i, 1);\n      continue;\n    }\n    if (p.life <= 0 || p.y > H + 50) floatingPowerups.splice(i, 1);\n  }\n\n  omnom.mouth = 0.5 + Math.sin(timer * 0.14) * 0.5;\n}\n\nfunction drawBackground() {\n  let lv = levels[Math.min(levelIndex, levels.length - 1)];\n  let g = ctx.createLinearGradient(0, 0, 0, H);\n  g.addColorStop(0, lv.bg[0]);\n  g.addColorStop(1, lv.bg[1]);\n  ctx.fillStyle = g;\n  ctx.fillRect(0, 0, W, H);\n  for (let i = 0; i < stars.length; i++) {\n    let s = stars[i];\n    ctx.globalAlpha = s.a;\n    ctx.fillStyle = '#dff';\n    ctx.beginPath();\n    ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);\n    ctx.fill();\n  }\n  ctx.globalAlpha = 1;\n  for (let y = 100; y < H; y += 120) {\n    ctx.strokeStyle = 'rgba(255,255,255,0.03)';\n    ctx.beginPath();\n    ctx.moveTo(0, y + Math.sin(timer * 0.01 + y) * 8);\n    ctx.lineTo(W, y + Math.cos(timer * 0.008 + y) * 8);\n    ctx.stroke();\n  }\n}\n\nfunction drawOmNom() {\n  if (!omnom) return;\n  ctx.save();\n  ctx.translate(omnom.x, omnom.y);\n  ctx.fillStyle = '#00c96b';\n  ctx.beginPath();\n  ctx.arc(0, 0, omnom.r + 10, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.fillStyle = '#14ef85';\n  ctx.beginPath();\n  ctx.arc(0, 0, omnom.r, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.fillStyle = '#fff';\n  ctx.beginPath();\n  ctx.arc(-12, -10, 7, 0, Math.PI * 2);\n  ctx.arc(12, -10, 7, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.fillStyle = '#111';\n  ctx.beginPath();\n  ctx.arc(-12, -9, 3, 0, Math.PI * 2);\n  ctx.arc(12, -9, 3, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.strokeStyle = '#072d18';\n  ctx.lineWidth = 4;\n  ctx.beginPath();\n  let jaw = 8 + omnom.mouth * 16;\n  ctx.arc(0, 12, 16, 0.1 * Math.PI, 0.9 * Math.PI, false);\n  ctx.stroke();\n  ctx.fillStyle = '#08110d';\n  ctx.beginPath();\n  ctx.ellipse(0, 12, 18, jaw, 0, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.restore();\n}\n\nfunction drawRopesAndCandy() {\n  if (!candy) return;\n  for (let i = 0; i < ropes.length; i++) {\n    let rp = ropes[i];\n    ctx.fillStyle = '#a7f3d0';\n    ctx.beginPath();\n    ctx.arc(rp.x, rp.y, 5, 0, Math.PI * 2);\n    ctx.fill();\n    if (!rp.cut) {\n      ctx.strokeStyle = '#d2b48c';\n      ctx.lineWidth = 3;\n      ctx.beginPath();\n      ctx.moveTo(rp.x, rp.y);\n      let mx = (rp.x + candy.x) * 0.5 + Math.sin(timer * 0.03 + i) * 6;\n      let my = (rp.y + candy.y) * 0.5 + 10;\n      ctx.quadraticCurveTo(mx, my, candy.x, candy.y);\n      ctx.stroke();\n    }\n  }\n  for (let i = 0; i < bubbles.length; i++) {\n    let b = bubbles[i];\n    if (b.used) continue;\n    ctx.fillStyle = 'rgba(128,222,234,0.12)';\n    ctx.strokeStyle = 'rgba(128,222,234,0.9)';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.stroke();\n    ctx.beginPath();\n    ctx.arc(b.x - b.r * 0.25, b.y - b.r * 0.25, b.r * 0.25, 0, Math.PI * 2);\n    ctx.strokeStyle = 'rgba(255,255,255,0.35)';\n    ctx.stroke();\n  }\n  for (let i = 0; i < starsLevel.length; i++) {\n    let st = starsLevel[i];\n    if (st.got) continue;\n    ctx.save();\n    ctx.translate(st.x, st.y);\n    ctx.rotate(st.pulse * 0.2);\n    let s = 10 + Math.sin(st.pulse) * 1.5;\n    ctx.fillStyle = '#ffd54f';\n    ctx.beginPath();\n    for (let k = 0; k < 5; k++) {\n      let a = -Math.PI / 2 + k * Math.PI * 2 / 5;\n      let x1 = Math.cos(a) * s;\n      let y1 = Math.sin(a) * s;\n      let a2 = a + Math.PI / 5;\n      let x2 = Math.cos(a2) * (s * 0.45);\n      let y2 = Math.sin(a2) * (s * 0.45);\n      if (k === 0) ctx.moveTo(x1, y1); else ctx.lineTo(x1, y1);\n      ctx.lineTo(x2, y2);\n    }\n    ctx.closePath();\n    ctx.fill();\n    ctx.restore();\n  }\n  for (let i = 0; i < hazards.length; i++) {\n    let h = hazards[i];\n    ctx.fillStyle = '#5a1010';\n    ctx.fillRect(h.x, h.y, h.w, h.h);\n    for (let x = h.x; x < h.x + h.w; x += 14) {\n      ctx.fillStyle = '#ff6b35';\n      ctx.beginPath();\n      ctx.moveTo(x, h.y + h.h);\n      ctx.lineTo(x + 7, h.y - 6);\n      ctx.lineTo(x + 14, h.y + h.h);\n      ctx.fill();\n    }\n  }\n  for (let i = 0; i < bumpers.length; i++) {\n    let b = bumpers[i];\n    ctx.fillStyle = '#4fc3f7';\n    ctx.beginPath();\n    ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.fillStyle = '#c2f0ff';\n    ctx.beginPath();\n    ctx.arc(b.x - 5, b.y - 5, b.r * 0.35, 0, Math.PI * 2);\n    ctx.fill();\n  }\n  for (let i = 0; i < portals.length; i++) {\n    let p = portals[i];\n    let ends = [p.a, p.b];\n    for (let j = 0; j < ends.length; j++) {\n      let e = ends[j];\n      ctx.strokeStyle = j === 0 ? '#c084ff' : '#80deea';\n      ctx.lineWidth = 4;\n      ctx.beginPath();\n      ctx.arc(e.x, e.y, e.r, 0, Math.PI * 2);\n      ctx.stroke();\n      ctx.beginPath();\n      ctx.arc(e.x, e.y, e.r - 7, 0, Math.PI * 2);\n      ctx.strokeStyle = 'rgba(255,255,255,0.25)';\n      ctx.stroke();\n    }\n  }\n  for (let i = 0; i < emitters.length; i++) {\n    let e = emitters[i];\n    ctx.fillStyle = '#4fc3f7';\n    ctx.fillRect(e.x - 10, e.y - 18, 20, 36);\n    for (let j = 0; j < 4; j++) {\n      let off = Math.sin(timer * 0.1 + j + i) * 5;\n      ctx.strokeStyle = 'rgba(79,195,247,0.35)';\n      ctx.beginPath();\n      ctx.moveTo(e.x, e.y - 12 + j * 8);\n      ctx.lineTo(e.x + e.dir * (26 + off), e.y - 12 + j * 8);\n      ctx.stroke();\n    }\n  }\n  ctx.save();\n  ctx.translate(candy.x, candy.y);\n  ctx.rotate(timer * 0.03 + candy.vx * 0.05);\n  ctx.fillStyle = hasPower('shield') ? '#7ee8ff' : '#ff6b35';\n  ctx.beginPath();\n  ctx.arc(0, 0, candy.r, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.fillStyle = '#ff9f6e';\n  ctx.beginPath();\n  ctx.arc(-5, -5, candy.r * 0.45, 0, Math.PI * 2);\n  ctx.fill();\n  for (let k = 0; k < 10; k++) {\n    let a = k * Math.PI * 2 / 10;\n    ctx.strokeStyle = '#fff0';\n    ctx.fillStyle = '#fff2';\n    ctx.beginPath();\n    ctx.arc(Math.cos(a) * 12, Math.sin(a) * 12, 2.3, 0, Math.PI * 2);\n    ctx.fill();\n  }\n  if (hasPower('shield')) {\n    ctx.strokeStyle = 'rgba(79,195,247,0.85)';\n    ctx.lineWidth = 3;\n    ctx.beginPath();\n    ctx.arc(0, 0, candy.r + 8 + Math.sin(timer * 0.1) * 1.5, 0, Math.PI * 2);\n    ctx.stroke();\n  }\n  ctx.restore();\n}\n\nfunction drawPowerups() {\n  for (let i = 0; i < floatingPowerups.length; i++) {\n    let p = floatingPowerups[i];\n    ctx.fillStyle = p.color;\n    ctx.beginPath();\n    ctx.roundRect(p.x - 16, p.y - 12, 32, 24, 8);\n    ctx.fill();\n    ctx.fillStyle = '#08110d';\n    ctx.font = 'bold 11px Arial';\n    ctx.textAlign = 'center';\n    ctx.fillText(p.label, p.x, p.y + 4);\n  }\n}\n\nfunction drawSparks() {\n  for (let i = sparks.length - 1; i >= 0; i--) {\n    let s = sparks[i];\n    s.x += s.vx;\n    s.y += s.vy;\n    s.vy += 0.02;\n    s.life--;\n    ctx.globalAlpha = Math.max(0, s.life / 28);\n    ctx.fillStyle = s.color;\n    ctx.fillRect(s.x, s.y, 3, 3);\n    if (s.life <= 0) sparks.splice(i, 1);\n  }\n  ctx.globalAlpha = 1;\n}\n\nfunction updateHUD() {\n  scoreBox.innerHTML = 'Score: ' + score + '<br>Lives: ' + lives;\n  highBox.innerHTML = 'High: ' + high.initials + ' ' + high.score + '<br>Level: ' + (Math.min(levelIndex + 1, levels.length));\n  powerupsEl.innerHTML = '';\n  if (activePowerups.length === 0) {\n    let span = document.createElement('div');\n    span.className = 'pBadge';\n    span.textContent = 'No active power-ups';\n    powerupsEl.appendChild(span);\n  } else {\n    for (let i = 0; i < activePowerups.length; i++) {\n      let p = activePowerups[i];\n      let meta = powerTypes.find(function(t){ return t.key === p.key; });\n      let span = document.createElement('div');\n      span.className = 'pBadge';\n      span.style.borderColor = meta ? meta.color : '#fff';\n      span.style.boxShadow = '0 0 10px ' + (meta ? meta.color : '#fff') + '33';\n      span.textContent = (meta ? meta.label : p.key) + ' ' + (p.t > 0 ? p.t.toFixed(1) + 's' : '');\n      powerupsEl.appendChild(span);\n    }\n  }\n  if (state === 'intro') {\n    centerMsg.style.opacity = '1';\n  } else if (state === 'playing') {\n    centerMsg.innerHTML = '';\n  }\n}\n\nfunction loop() {\n  drawBackground();\n  if (state === 'intro') {\n    introTimer--;\n    if (introTimer <= 0) {\n      state = 'playing';\n      centerMsg.innerHTML = '';\n    }\n  }\n  if (state === 'playing') updateGame();\n  if (state === 'intro' || state === 'playing') {\n    drawOmNom();\n    drawRopesAndCandy();\n    drawPowerups();\n    drawSparks();\n  }\n  if (state !== 'menu' && timer % 28 === 0) musicStep();\n  updateHUD();\n  window.__canvasAnimId = requestAnimationFrame(loop);\n}\n\nwindow.__canvasAnimId = requestAnimationFrame(loop);\n</script>\n</body>\n</html>",
