{
  "name": "Breakout Power Mix",
  "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=390,height=844,initial-scale=1,maximum-scale=1,user-scalable=no\" />\n<title>Breakout Power Mix</title>\n<style>\n  html, body {\n    margin: 0;\n    width: 390px;\n    height: 844px;\n    overflow: hidden;\n    background: #0a0a0a;\n    font-family: Arial, Helvetica, sans-serif;\n  }\n  body {\n    position: relative;\n    color: #fff;\n    user-select: none;\n    -webkit-user-select: none;\n    touch-action: none;\n  }\n  #wrap {\n    position: relative;\n    width: 390px;\n    height: 844px;\n    overflow: hidden;\n    background: radial-gradient(circle at top, #122030 0%, #0a0a0a 55%, #050505 100%);\n  }\n  canvas {\n    display: block;\n    width: 390px;\n    height: 844px;\n    background: transparent;\n  }\n  #ui {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n  }\n  .panel {\n    position: absolute;\n    left: 10px;\n    right: 10px;\n    top: 10px;\n    display: flex;\n    justify-content: space-between;\n    gap: 8px;\n    pointer-events: none;\n  }\n  .hudBox {\n    background: rgba(0,0,0,0.45);\n    border: 1px solid rgba(79,195,247,0.35);\n    border-radius: 10px;\n    padding: 8px 10px;\n    box-shadow: 0 0 18px rgba(0,255,136,0.08) inset;\n    min-width: 0;\n  }\n  .hudLabel { color: #9cc7d8; font-size: 11px; letter-spacing: 1px; }\n  .hudValue { color: #fff; font-size: 18px; font-weight: 700; }\n  #activeBar {\n    position: absolute;\n    left: 10px;\n    right: 10px;\n    top: 78px;\n    min-height: 40px;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 6px;\n    pointer-events: none;\n  }\n  .tag {\n    background: rgba(255,255,255,0.08);\n    border: 1px solid rgba(255,255,255,0.18);\n    color: #fff;\n    border-radius: 999px;\n    padding: 5px 8px;\n    font-size: 11px;\n    line-height: 1;\n  }\n  #muteBtn {\n    position: absolute;\n    right: 10px;\n    bottom: 10px;\n    width: 84px;\n    height: 38px;\n    border-radius: 999px;\n    border: 1px solid rgba(255,255,255,0.2);\n    background: rgba(0,0,0,0.6);\n    color: #fff;\n    font-weight: 700;\n    pointer-events: auto;\n    z-index: 5;\n  }\n  #overlay {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    padding: 20px;\n    pointer-events: none;\n  }\n  #overlayCard {\n    max-width: 320px;\n    background: rgba(0,0,0,0.7);\n    border: 1px solid rgba(0,255,136,0.25);\n    border-radius: 18px;\n    padding: 18px 16px;\n    box-shadow: 0 0 30px rgba(0,255,136,0.08), 0 0 60px rgba(79,195,247,0.08) inset;\n  }\n  #overlayTitle { font-size: 30px; font-weight: 900; color: #00ff88; letter-spacing: 2px; }\n  #overlaySub { margin-top: 10px; color: #d0d0d0; font-size: 14px; line-height: 1.4; }\n  #initialsWrap {\n    position: absolute;\n    inset: 0;\n    background: rgba(0,0,0,0.7);\n    display: none;\n    align-items: center;\n    justify-content: center;\n    z-index: 9;\n    pointer-events: auto;\n  }\n  #initialsCard {\n    width: 280px;\n    background: #111;\n    border: 1px solid rgba(255,107,53,0.45);\n    border-radius: 16px;\n    padding: 18px;\n    text-align: center;\n    color: #fff;\n  }\n  #initialsInput {\n    width: 100px;\n    text-align: center;\n    font-size: 28px;\n    letter-spacing: 6px;\n    text-transform: uppercase;\n    margin: 14px 0;\n    border-radius: 10px;\n    border: 1px solid #4fc3f7;\n    background: #000;\n    color: #00ff88;\n    padding: 8px;\n  }\n  #saveScoreBtn {\n    border: 0;\n    border-radius: 10px;\n    background: linear-gradient(90deg, #ff6b35, #00ff88);\n    color: #000;\n    font-weight: 900;\n    padding: 10px 18px;\n  }\n</style>\n</head>\n<body>\n<div id=\"wrap\">\n  <canvas width=\"390\" height=\"844\"></canvas>\n  <div id=\"ui\">\n    <div class=\"panel\">\n      <div class=\"hudBox\"><div class=\"hudLabel\">SCORE</div><div class=\"hudValue\" id=\"scoreVal\">0</div></div>\n      <div class=\"hudBox\"><div class=\"hudLabel\">LIVES</div><div class=\"hudValue\" id=\"livesVal\">3</div></div>\n      <div class=\"hudBox\"><div class=\"hudLabel\">LEVEL</div><div class=\"hudValue\" id=\"levelVal\">1</div></div>\n      <div class=\"hudBox\"><div class=\"hudLabel\">HIGH</div><div class=\"hudValue\" id=\"highVal\">AAA 0</div></div>\n    </div>\n    <div id=\"activeBar\"></div>\n    <div id=\"overlay\"><div id=\"overlayCard\"><div id=\"overlayTitle\">BREAKOUT POWER MIX</div><div id=\"overlaySub\">Tap to launch. Move paddle to smash every level and stack power-ups.</div></div></div>\n    <button id=\"muteBtn\">MUTE: OFF</button>\n    <div id=\"initialsWrap\">\n      <div id=\"initialsCard\">\n        <div style=\"font-size:24px;font-weight:900;color:#ff6b35;\">NEW HIGH SCORE</div>\n        <div style=\"margin-top:8px;font-size:14px;color:#ddd;\">Enter your initials</div>\n        <input id=\"initialsInput\" maxlength=\"3\" value=\"AAA\" />\n        <br />\n        <button id=\"saveScoreBtn\">SAVE</button>\n      </div>\n    </div>\n  </div>\n</div>\n<script>\nif (window.__canvasAnimId) cancelAnimationFrame(window.__canvasAnimId);\nlet canvas = document.querySelector('canvas');\nlet ctx = canvas.getContext('2d');\nlet W = canvas.width;\nlet H = canvas.height;\nlet scoreEl = document.getElementById('scoreVal');\nlet livesEl = document.getElementById('livesVal');\nlet levelEl = document.getElementById('levelVal');\nlet highEl = document.getElementById('highVal');\nlet activeBar = document.getElementById('activeBar');\nlet overlay = document.getElementById('overlay');\nlet overlayTitle = document.getElementById('overlayTitle');\nlet overlaySub = document.getElementById('overlaySub');\nlet muteBtn = document.getElementById('muteBtn');\nlet initialsWrap = document.getElementById('initialsWrap');\nlet initialsInput = document.getElementById('initialsInput');\nlet saveScoreBtn = document.getElementById('saveScoreBtn');\n\nlet storageKey = 'breakoutPowerMixHigh';\nlet highData = { initials: 'AAA', score: 0 };\ntry {\n  let raw = localStorage.getItem(storageKey);\n  if (raw) {\n    let parsed = JSON.parse(raw);\n    if (parsed && typeof parsed.initials === 'string' && typeof parsed.score === 'number') highData = parsed;\n  }\n} catch (e) {}\n\nlet muted = false;\nlet audioCtx = null;\nlet masterGain = null;\nlet musicGain = null;\nlet musicTimer = 0;\nlet musicStep = 0;\nlet lastMusicStamp = 0;\n\nfunction ensureAudio() {\n  if (!audioCtx) {\n    let AC = window.AudioContext || window.webkitAudioContext;\n    if (!AC) return;\n    audioCtx = new AC();\n    masterGain = audioCtx.createGain();\n    musicGain = audioCtx.createGain();\n    musicGain.gain.value = 0.12;\n    masterGain.gain.value = muted ? 0 : 0.9;\n    musicGain.connect(masterGain);\n    masterGain.connect(audioCtx.destination);\n  }\n  if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();\n}\n\nfunction tone(freq, start, dur, type, vol, slide) {\n  if (!audioCtx || muted) return;\n  let osc = audioCtx.createOscillator();\n  let gain = audioCtx.createGain();\n  osc.type = type || 'sine';\n  osc.frequency.setValueAtTime(freq, start);\n  if (slide) osc.frequency.linearRampToValueAtTime(slide, start + dur);\n  gain.gain.setValueAtTime(0.0001, start);\n  gain.gain.exponentialRampToValueAtTime(vol || 0.1, start + 0.01);\n  gain.gain.exponentialRampToValueAtTime(0.0001, start + dur);\n  osc.connect(gain);\n  gain.connect(masterGain);\n  osc.start(start);\n  osc.stop(start + dur + 0.02);\n}\n\nfunction sfx(name) {\n  ensureAudio();\n  if (!audioCtx || muted) return;\n  let t = audioCtx.currentTime;\n  if (name === 'hit') tone(420, t, 0.06, 'square', 0.05, 520);\n  if (name === 'brick') { tone(290, t, 0.07, 'triangle', 0.06, 610); tone(560, t + 0.02, 0.07, 'square', 0.04, 300); }\n  if (name === 'power') { tone(660, t, 0.12, 'triangle', 0.08, 990); tone(990, t + 0.06, 0.12, 'sine', 0.05, 1320); }\n  if (name === 'level') { tone(392, t, 0.12, 'square', 0.06, 523); tone(523, t + 0.12, 0.12, 'square', 0.06, 659); tone(659, t + 0.24, 0.2, 'triangle', 0.08, 784); }\n  if (name === 'lose') { tone(340, t, 0.16, 'sawtooth', 0.06, 210); tone(220, t + 0.14, 0.24, 'sawtooth', 0.07, 110); }\n  if (name === 'gameover') { tone(260, t, 0.18, 'sawtooth', 0.07, 180); tone(180, t + 0.18, 0.25, 'triangle', 0.08, 90); }\n  if (name === 'high') { tone(523, t, 0.11, 'square', 0.07, 659); tone(659, t + 0.11, 0.11, 'square', 0.07, 784); tone(784, t + 0.22, 0.22, 'triangle', 0.08, 1047); }\n  if (name === 'laser') { tone(920, t, 0.08, 'sawtooth', 0.06, 420); }\n  if (name === 'bomb') { tone(180, t, 0.18, 'sawtooth', 0.08, 70); }\n}\n\nfunction musicTick(ts) {\n  if (!audioCtx || muted || state !== 'playing') return;\n  if (!lastMusicStamp) lastMusicStamp = ts;\n  let bpm = 105 + levelIndex * 9;\n  let beatMs = 60000 / bpm;\n  if (ts - lastMusicStamp >= beatMs) {\n    lastMusicStamp = ts;\n    let scales = [261.63,293.66,329.63,392.0,440.0,523.25,659.25,783.99];\n    let patterns = [\n      [0,2,4,2,5,4,2,1],\n      [0,3,5,3,6,5,3,2],\n      [0,2,5,4,6,4,2,7],\n      [0,4,2,5,3,6,4,7],\n      [7,6,5,4,3,2,1,0],\n      [0,2,4,6,7,6,4,2],\n      [0,5,4,6,5,7,6,4],\n      [0,2,1,4,3,6,5,7]\n    ];\n    let p = patterns[levelIndex % patterns.length];\n    let rootShift = Math.floor(levelIndex / 2) * 0.06 + 1;\n    let note = scales[p[musicStep % p.length]] * rootShift;\n    let t = audioCtx.currentTime;\n    let osc = audioCtx.createOscillator();\n    let gain = audioCtx.createGain();\n    osc.type = musicStep % 4 === 0 ? 'triangle' : 'square';\n    osc.frequency.setValueAtTime(note, t);\n    gain.gain.setValueAtTime(0.0001, t);\n    gain.gain.linearRampToValueAtTime(0.035 + levelIndex * 0.004, t + 0.01);\n    gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.22);\n    osc.connect(gain);\n    gain.connect(musicGain);\n    osc.start(t);\n    osc.stop(t + 0.24);\n    if (musicStep % 2 === 0) {\n      let bass = audioCtx.createOscillator();\n      let bg = audioCtx.createGain();\n      bass.type = 'sine';\n      bass.frequency.setValueAtTime(note / 2, t);\n      bg.gain.setValueAtTime(0.0001, t);\n      bg.gain.linearRampToValueAtTime(0.025, t + 0.005);\n      bg.gain.exponentialRampToValueAtTime(0.0001, t + 0.18);\n      bass.connect(bg);\n      bg.connect(musicGain);\n      bass.start(t);\n      bass.stop(t + 0.19);\n    }\n    musicStep++;\n  }\n}\n\nlet levelDefs = [\n  { name: 'NEON START', bg: '#0f1722', rows: 5, cols: 7, speed: 4.2, pattern: 'full', moving: false, steel: 0, hazards: false },\n  { name: 'GAP GRID', bg: '#10131f', rows: 6, cols: 7, speed: 4.6, pattern: 'gaps', moving: false, steel: 2, hazards: false },\n  { name: 'SHIFT WAVE', bg: '#14101f', rows: 6, cols: 8, speed: 5.0, pattern: 'wave', moving: true, steel: 3, hazards: false },\n  { name: 'CORE LOCK', bg: '#1a1212', rows: 7, cols: 8, speed: 5.3, pattern: 'ring', moving: true, steel: 6, hazards: true },\n  { name: 'LASER STORM', bg: '#101a14', rows: 7, cols: 8, speed: 5.7, pattern: 'slashes', moving: true, steel: 7, hazards: true },\n  { name: 'MIRROR MAZE', bg: '#0f1018', rows: 8, cols: 8, speed: 6.0, pattern: 'maze', moving: true, steel: 8, hazards: true },\n  { name: 'GRAVITY DROP', bg: '#18120f', rows: 8, cols: 9, speed: 6.3, pattern: 'pyramid', moving: true, steel: 10, hazards: true },\n  { name: 'FINAL CORE', bg: '#170d1a', rows: 9, cols: 9, speed: 6.8, pattern: 'fortress', moving: true, steel: 12, hazards: true }\n];\n\nlet paddle = { x: W/2 - 45, y: H - 80, w: 90, h: 14, speed: 7, targetX: W/2 - 45, shield: 0, magnet: 0, laser: 0, fire: 0 };\nlet gameBalls = [];\nlet bricks = [];\nlet powerUps = [];\nlet particles = [];\nlet lasers = [];\nlet hazards = [];\nlet score = 0;\nlet lives = 3;\nlet levelIndex = 0;\nlet state = 'intro';\nlet stateTimer = 0;\nlet keys = {};\nlet pointerDown = false;\nlet combo = 0;\nlet comboTimer = 0;\nlet powerSpawnTimer = 0;\nlet levelIntroTimer = 0;\nlet pendingHigh = false;\nlet hudDirty = true;\nlet activeEffects = {\n  shield: 0,\n  speed: 0,\n  slow: 0,\n  multi: 0,\n  laser: 0,\n  magnet: 0,\n  double: 0,\n  invinc: 0,\n  ghost: 0,\n  fire: 0,\n  freeze: 0,\n  multiplier: 0\n};\n\nlet powerTypes = [\n  { type: 'life', label: '1UP', color: '#00ff88' },\n  { type: 'shield', label: 'SHD', color: '#4fc3f7' },\n  { type: 'speed', label: 'SPD', color: '#ffd166' },\n  { type: 'slow', label: 'SLW', color: '#b388ff' },\n  { type: 'multi', label: 'MBL', color: '#ff6b35' },\n  { type: 'laser', label: 'LSR', color: '#ff4f81' },\n  { type: 'magnet', label: 'MAG', color: '#7afcff' },\n  { type: 'double', label: '2X', color: '#f4ff81' },\n  { type: 'invinc', label: 'INV', color: '#ffffff' },\n  { type: 'bomb', label: 'BMB', color: '#ff3d00' },\n  { type: 'ghost', label: 'GST', color: '#9fa8da' },\n  { type: 'fire', label: 'FIR', color: '#ff8a65' },\n  { type: 'freeze', label: 'FRZ', color: '#80deea' },\n  { type: 'mystery', label: '?', color: '#ce93d8' }\n];\n\nfunction updateHUD() {\n  if (!hudDirty) return;\n  scoreEl.textContent = Math.floor(score);\n  livesEl.textContent = lives;\n  levelEl.textContent = (levelIndex + 1);\n  highEl.textContent = (highData.initials || 'AAA') + ' ' + (highData.score || 0);\n  activeBar.innerHTML = '';\n  let added = 0;\n  for (let k in activeEffects) {\n    if (activeEffects[k] > 0) {\n      let d = document.createElement('div');\n      d.className = 'tag';\n      d.textContent = k.toUpperCase() + ' ' + (activeEffects[k] / 1000).toFixed(1) + 's';\n      activeBar.appendChild(d);\n      added++;\n    }\n  }\n  if (combo > 1) {\n    let d2 = document.createElement('div');\n    d2.className = 'tag';\n    d2.style.borderColor = 'rgba(255,107,53,0.5)';\n    d2.style.color = '#ff6b35';\n    d2.textContent = 'COMBO x' + combo;\n    activeBar.appendChild(d2);\n  }\n  if (!added && combo <= 1) {\n    let d3 = document.createElement('div');\n    d3.className = 'tag';\n    d3.textContent = 'No active power-ups';\n    activeBar.appendChild(d3);\n  }\n  hudDirty = false;\n}\n\nfunction resetBall(stick) {\n  gameBalls = [{ x: paddle.x + paddle.w/2, y: paddle.y - 12, vx: 3.1, vy: -4.4, r: 8, stuck: !!stick, ghost: false, fire: false, name: 'ball' }];\n}\n\nfunction buildLevel(i) {\n  let def = levelDefs[i];\n  document.getElementById('wrap').style.background = 'radial-gradient(circle at top, ' + def.bg + ' 0%, #0a0a0a 58%, #050505 100%)';\n  bricks = [];\n  powerUps = [];\n  particles = [];\n  lasers = [];\n  hazards = [];\n  combo = 0;\n  comboTimer = 0;\n  for (let k in activeEffects) activeEffects[k] = 0;\n  paddle.w = 90;\n  paddle.speed = 7;\n  let top = 150;\n  let margin = 18;\n  let cols = def.cols;\n  let rows = def.rows;\n  let gap = 4;\n  let bw = Math.floor((W - margin * 2 - gap * (cols - 1)) / cols);\n  let bh = 24;\n  let steelPlaced = 0;\n  for (let r = 0; r < rows; r++) {\n    for (let c = 0; c < cols; c++) {\n      let place = true;\n      if (def.pattern === 'gaps' && (r + c) % 3 === 0) place = false;\n      if (def.pattern === 'wave' && ((r % 2 === 0 && c === 0) || (r % 2 === 1 && c === cols - 1))) place = false;\n      if (def.pattern === 'ring' && r > 1 && r < rows - 2 && c > 1 && c < cols - 2) place = false;\n      if (def.pattern === 'slashes' && (c === r || c === cols - r - 1)) place = false;\n      if (def.pattern === 'maze' && (r % 2 === 1 && c % 3 === 1)) place = false;\n      if (def.pattern === 'pyramid' && (c < Math.abs(Math.floor(cols/2) - Math.floor(r/1.6)) || c > cols - 1 - Math.abs(Math.floor(cols/2) - Math.floor(r/1.6)))) place = false;\n      if (def.pattern === 'fortress' && (r === 4 && c > 1 && c < cols - 2)) place = false;\n      if (!place) continue;\n      let hp = 1 + Math.floor(i / 2);\n      let steel = steelPlaced < def.steel && ((r + c + i) % 4 === 0);\n      if (steel) { hp += 2; steelPlaced++; }\n      bricks.push({\n        x: margin + c * (bw + gap),\n        y: top + r * (bh + gap),\n        w: bw,\n        h: bh,\n        hp: hp,\n        maxHp: hp,\n        steel: steel,\n        color: 'hsl(' + ((r*35 + c*18 + i*25) % 360) + ' 85% 58%)',\n        alive: true,\n        movePhase: Math.random() * Math.PI * 2\n      });\n    }\n  }\n  if (def.hazards) {\n    for (let h = 0; h < 2 + Math.floor(i / 2); h++) {\n      hazards.push({ x: 40 + h * 80, y: 120 + h * 30, w: 52, h: 8, dir: h % 2 ? 1 : -1, speed: 1.2 + i * 0.15 });\n    }\n  }\n  paddle.x = W/2 - paddle.w/2;\n  paddle.targetX = paddle.x;\n  resetBall(true);\n  levelIntroTimer = 1300;\n  state = 'levelIntro';\n  overlay.style.display = 'flex';\n  overlayTitle.textContent = 'LEVEL ' + (i + 1);\n  overlayTitle.style.color = '#00ff88';\n  overlaySub.textContent = def.name;\n  hudDirty = true;\n  sfx('level');\n}\n\nfunction spawnParticles(x, y, color, count) {\n  for (let i = 0; i < count; i++) {\n    particles.push({ x: x, y: y, vx: (Math.random() - 0.5) * 4, vy: (Math.random() - 0.5) * 4 - 1, life: 500 + Math.random() * 300, max: 800, color: color, size: 2 + Math.random() * 3 });\n  }\n}\n\nfunction spawnPower(x, y, forced) {\n  if (!forced && Math.random() > 0.28) return;\n  let p = powerTypes[Math.floor(Math.random() * powerTypes.length)];\n  powerUps.push({ x: x, y: y, vy: 1.7 + Math.random() * 0.7, r: 12, type: p.type, label: p.label, color: p.color });\n}\n\nfunction applyPower(type) {\n  if (type === 'mystery') {\n    let choices = powerTypes.filter(function(p){ return p.type !== 'mystery'; });\n    applyPower(choices[Math.floor(Math.random() * choices.length)].type);\n    return;\n  }\n  if (type === 'life') lives++;\n  if (type === 'shield') activeEffects.shield = 12000;\n  if (type === 'speed') { activeEffects.speed = 9000; paddle.speed = 10; }\n  if (type === 'slow') activeEffects.slow = 9000;\n  if (type === 'multi') {\n    activeEffects.multi = 8000;\n    let clones = [];\n    for (let i = 0; i < gameBalls.length; i++) {\n      let ball = gameBalls[i];\n      clones.push({ x: ball.x, y: ball.y, vx: -ball.vx, vy: ball.vy - 0.8, r: ball.r, stuck: false, ghost: !!activeEffects.ghost, fire: !!activeEffects.fire, name: 'ball' });\n      clones.push({ x: ball.x, y: ball.y, vx: ball.vx * 0.8 + 1.1, vy: -Math.abs(ball.vy), r: ball.r, stuck: false, ghost: !!activeEffects.ghost, fire: !!activeEffects.fire, name: 'ball' });\n    }\n    gameBalls = gameBalls.concat(clones.slice(0, 4));\n  }\n  if (type === 'laser') activeEffects.laser = 10000;\n  if (type === 'magnet') activeEffects.magnet = 10000;\n  if (type === 'double') activeEffects.double = 12000;\n  if (type === 'invinc') activeEffects.invinc = 7000;\n  if (type === 'bomb') {\n    sfx('bomb');\n    let removed = 0;\n    for (let i = 0; i < bricks.length; i++) {\n      let br = bricks[i];\n      if (br.alive && Math.random() < 0.33) {\n        br.alive = false;\n        removed++;\n        score += 25;\n        spawnParticles(br.x + br.w/2, br.y + br.h/2, br.color, 10);\n      }\n    }\n    if (removed === 0) score += 100;\n  }\n  if (type === 'ghost') { activeEffects.ghost = 10000; for (let i=0;i<gameBalls.length;i++) gameBalls[i].ghost = true; }\n  if (type === 'fire') { activeEffects.fire = 10000; for (let i=0;i<gameBalls.length;i++) gameBalls[i].fire = true; }\n  if (type === 'freeze') activeEffects.freeze = 7000;\n  score += 35;\n  hudDirty = true;\n  sfx('power');\n}\n\nfunction hitBrick(br, ball) {\n  if (!br.alive) return;\n  let dmg = ball.fire ? 2 : 1;\n  br.hp -= dmg;\n  if (br.hp <= 0) {\n    br.alive = false;\n    combo++;\n    comboTimer = 1600;\n    let mult = activeEffects.double > 0 ? 2 : 1;\n    let extra = activeEffects.multiplier > 0 ? 3 : 1;\n    score += (br.steel ? 30 : 18) * mult * extra + combo;\n    spawnParticles(br.x + br.w/2, br.y + br.h/2, br.color, 12);\n    spawnPower(br.x + br.w/2, br.y + br.h/2, false);\n    sfx('brick');\n  } else {\n    score += 4;\n    spawnParticles(br.x + br.w/2, br.y + br.h/2, '#fff', 4);\n    sfx('hit');\n  }\n  hudDirty = true;\n}\n\nfunction rectCircleCollide(rx, ry, rw, rh, cx, cy, cr) {\n  let tx = Math.max(rx, Math.min(cx, rx + rw));\n  let ty = Math.max(ry, Math.min(cy, ry + rh));\n  let dx = cx - tx;\n  let dy = cy - ty;\n  return dx * dx + dy * dy <= cr * cr;\n}\n\nfunction update(dt) {\n  if (state === 'intro') return;\n  if (state === 'levelIntro') {\n    levelIntroTimer -= dt;\n    if (levelIntroTimer <= 0) {\n      state = 'playing';\n      overlay.style.display = 'none';\n    }\n    return;\n  }\n  if (state === 'gameover' || state === 'victory') return;\n\n  let moveDir = 0;\n  if (keys['ArrowLeft'] || keys['a']) moveDir -= 1;\n  if (keys['ArrowRight'] || keys['d']) moveDir += 1;\n  if (moveDir !== 0) paddle.x += moveDir * paddle.speed;\n  else paddle.x += (paddle.targetX - paddle.x) * 0.22;\n  paddle.x = Math.max(8, Math.min(W - 8 - paddle.w, paddle.x));\n\n  for (let k in activeEffects) {\n    if (activeEffects[k] > 0) {\n      activeEffects[k] -= dt;\n      if (activeEffects[k] < 0) activeEffects[k] = 0;\n      hudDirty = true;\n    }\n  }\n  if (activeEffects.speed <= 0) paddle.speed = 7;\n  if (activeEffects.ghost <= 0) { for (let i=0;i<gameBalls.length;i++) gameBalls[i].ghost = false; }\n  if (activeEffects.fire <= 0) { for (let i=0;i<gameBalls.length;i++) gameBalls[i].fire = false; }\n\n  comboTimer -= dt;\n  if (comboTimer <= 0 && combo > 0) { combo = 0; hudDirty = true; }\n\n  powerSpawnTimer += dt;\n  if (powerSpawnTimer > 9000) {\n    powerSpawnTimer = 0;\n    let p = powerTypes[Math.floor(Math.random() * powerTypes.length)];\n    powerUps.push({ x: 30 + Math.random() * (W - 60), y: 120, vy: 1.6, r: 12, type: p.type, label: p.label, color: p.color });\n  }\n\n  for (let i = 0; i < hazards.length; i++) {\n    let hz = hazards[i];\n    let hs = activeEffects.freeze > 0 ? 0.25 : 1;\n    hz.x += hz.dir * hz.speed * hs;\n    if (hz.x < 10 || hz.x + hz.w > W - 10) hz.dir *= -1;\n  }\n\n  let speedScale = activeEffects.slow > 0 ? 0.72 : 1;\n  for (let i = gameBalls.length - 1; i >= 0; i--) {\n    let ball = gameBalls[i];\n    if (ball.stuck) {\n      ball.x = paddle.x + paddle.w/2;\n      ball.y = paddle.y - 12;\n      continue;\n    }\n    ball.x += ball.vx * speedScale;\n    ball.y += ball.vy * speedScale;\n    if (ball.x - ball.r < 0) { ball.x = ball.r; ball.vx *= -1; sfx('hit'); }\n    if (ball.x + ball.r > W) { ball.x = W - ball.r; ball.vx *= -1; sfx('hit'); }\n    if (ball.y - ball.r < 110) { ball.y = 110 + ball.r; ball.vy *= -1; sfx('hit'); }\n\n    if (ball.y + ball.r > H) {\n      if (activeEffects.shield > 0) {\n        activeEffects.shield = 0;\n        ball.y = H - 30;\n        ball.vy = -Math.abs(ball.vy);\n        hudDirty = true;\n        sfx('hit');\n      } else if (activeEffects.invinc > 0) {\n        ball.y = H - 30;\n        ball.vy = -Math.abs(ball.vy);\n      } else {\n        gameBalls.splice(i, 1);\n        if (gameBalls.length === 0) {\n          lives--;\n          hudDirty = true;\n          sfx('lose');\n          if (lives <= 0) {\n            endGame(false);\n            return;\n          } else {\n            resetBall(true);\n          }\n        }\n        continue;\n      }\n    }\n\n    if (rectCircleCollide(paddle.x, paddle.y, paddle.w, paddle.h, ball.x, ball.y, ball.r) && ball.vy > 0) {\n      let hitPos = (ball.x - (paddle.x + paddle.w / 2)) / (paddle.w / 2);\n      ball.vx = hitPos * 5.4;\n      ball.vy = -Math.max(3.5, Math.abs(ball.vy));\n      if (activeEffects.magnet > 0 && Math.abs(hitPos) < 0.35) ball.stuck = true;\n      sfx('hit');\n    }\n\n    for (let j = 0; j < hazards.length; j++) {\n      let hz2 = hazards[j];\n      if (rectCircleCollide(hz2.x, hz2.y, hz2.w, hz2.h, ball.x, ball.y, ball.r)) {\n        ball.vy *= -1;\n        ball.vx += hz2.dir * 0.4;\n        sfx('hit');\n      }\n    }\n\n    for (let j = 0; j < bricks.length; j++) {\n      let br = bricks[j];\n      if (!br.alive) continue;\n      let bx = br.x;\n      if (levelDefs[levelIndex].moving) bx += Math.sin(performance.now() * 0.001 + br.movePhase) * 8;\n      br.renderX = bx;\n      if (rectCircleCollide(bx, br.y, br.w, br.h, ball.x, ball.y, ball.r)) {\n        hitBrick(br, ball);\n        if (!ball.ghost) {\n          let prevX = ball.x - ball.vx * speedScale;\n          let prevY = ball.y - ball.vy * speedScale;\n          let horiz = prevX < bx || prevX > bx + br.w;\n          if (horiz) ball.vx *= -1; else ball.vy *= -1;\n        }\n        if (ball.fire && br.alive) hitBrick(br, ball);\n        break;\n      }\n    }\n  }\n\n  for (let i = lasers.length - 1; i >= 0; i--) {\n    let l = lasers[i];\n    l.y -= 10;\n    if (l.y < 100) { lasers.splice(i, 1); continue; }\n    for (let j = 0; j < bricks.length; j++) {\n      let br = bricks[j];\n      if (!br.alive) continue;\n      let bx = br.renderX != null ? br.renderX : br.x;\n      if (l.x > bx && l.x < bx + br.w && l.y > br.y && l.y < br.y + br.h) {\n        hitBrick(br, { fire: true });\n        lasers.splice(i, 1);\n        break;\n      }\n    }\n  }\n\n  for (let i = powerUps.length - 1; i >= 0; i--) {\n    let p = powerUps[i];\n    p.y += p.vy;\n    if (p.y > H + 30) { powerUps.splice(i, 1); continue; }\n    if (p.x > paddle.x && p.x < paddle.x + paddle.w && p.y + p.r > paddle.y && p.y - p.r < paddle.y + paddle.h) {\n      applyPower(p.type);\n      powerUps.splice(i, 1);\n    }\n  }\n\n  for (let i = particles.length - 1; i >= 0; i--) {\n    let p = particles[i];\n    p.x += p.vx;\n    p.y += p.vy;\n    p.vy += 0.03;\n    p.life -= dt;\n    if (p.life <= 0) particles.splice(i, 1);\n  }\n\n  let remain = 0;\n  for (let i = 0; i < bricks.length; i++) if (bricks[i].alive) remain++;\n  if (remain === 0) {\n    levelIndex++;\n    if (levelIndex >= levelDefs.length) endGame(true);\n    else buildLevel(levelIndex);\n    return;\n  }\n  hudDirty = true;\n}\n\nfunction endGame(win) {\n  state = win ? 'victory' : 'gameover';\n  overlay.style.display = 'flex';\n  overlayTitle.textContent = win ? 'VICTORY' : 'GAME OVER';\n  overlayTitle.style.color = win ? '#00ff88' : '#ff6b35';\n  overlaySub.textContent = 'Score ' + score + ' • High ' + highData.initials + ' ' + highData.score + ' • Tap to restart';\n  if (win) sfx('level'); else sfx('gameover');\n  if (score > highData.score) {\n    pendingHigh = true;\n    initialsWrap.style.display = 'flex';\n    initialsInput.value = 'AAA';\n    setTimeout(function(){ initialsInput.focus(); initialsInput.select(); }, 30);\n  }\n}\n\nfunction saveHigh() {\n  let v = (initialsInput.value || 'AAA').toUpperCase().replace(/[^A-Z]/g, '').slice(0,3);\n  while (v.length < 3) v += 'A';\n  highData = { initials: v, score: score };\n  try { localStorage.setItem(storageKey, JSON.stringify(highData)); } catch (e) {}\n  pendingHigh = false;\n  initialsWrap.style.display = 'none';\n  overlaySub.textContent = 'Score ' + score + ' • High ' + highData.initials + ' ' + highData.score + ' • Tap to restart';\n  hudDirty = true;\n  sfx('high');\n}\n\nfunction launchBalls() {\n  for (let i = 0; i < gameBalls.length; i++) {\n    if (gameBalls[i].stuck) {\n      gameBalls[i].stuck = false;\n      let dir = ((gameBalls[i].x - (paddle.x + paddle.w/2)) / (paddle.w/2));\n      if (!dir) dir = (Math.random() > 0.5 ? 0.5 : -0.5);\n      gameBalls[i].vx = dir * 4.2;\n      gameBalls[i].vy = -levelDefs[levelIndex].speed;\n    }\n  }\n}\n\nfunction restartGame() {\n  score = 0;\n  lives = 3;\n  levelIndex = 0;\n  pendingHigh = false;\n  initialsWrap.style.display = 'none';\n  buildLevel(0);\n  hudDirty = true;\n}\n\nfunction drawBackground() {\n  ctx.fillStyle = 'rgba(255,255,255,0.03)';\n  for (let i = 0; i < 28; i++) {\n    let x = (i * 57 + performance.now() * 0.01) % W;\n    let y = (i * 103) % H;\n    ctx.fillRect(x, y, 2, 2);\n  }\n  ctx.fillStyle = 'rgba(79,195,247,0.08)';\n  ctx.fillRect(0, 104, W, 2);\n}\n\nfunction draw() {\n  ctx.clearRect(0, 0, W, H);\n  drawBackground();\n\n  for (let i = 0; i < hazards.length; i++) {\n    let hz = hazards[i];\n    ctx.fillStyle = '#ff1744';\n    ctx.fillRect(hz.x, hz.y, hz.w, hz.h);\n    ctx.fillStyle = '#fff';\n    for (let s = 0; s < hz.w; s += 10) ctx.fillRect(hz.x + s, hz.y, 5, hz.h);\n  }\n\n  for (let i = 0; i < bricks.length; i++) {\n    let br = bricks[i];\n    if (!br.alive) continue;\n    let x = br.renderX != null ? br.renderX : br.x;\n    ctx.fillStyle = br.color;\n    ctx.globalAlpha = 0.9;\n    ctx.fillRect(x, br.y, br.w, br.h);\n    if (br.steel) {\n      ctx.strokeStyle = '#cfd8dc';\n      ctx.lineWidth = 2;\n      ctx.strokeRect(x + 1, br.y + 1, br.w - 2, br.h - 2);\n    }\n    ctx.globalAlpha = 1;\n    ctx.fillStyle = 'rgba(255,255,255,0.25)';\n    ctx.fillRect(x, br.y, br.w, 4);\n    for (let hp = 0; hp < br.hp; hp++) {\n      ctx.fillStyle = '#000';\n      ctx.fillRect(x + 4 + hp * 7, br.y + br.h - 6, 4, 3);\n    }\n  }\n\n  for (let i = 0; i < powerUps.length; i++) {\n    let p = powerUps[i];\n    ctx.fillStyle = p.color;\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.strokeStyle = '#fff';\n    ctx.lineWidth = 2;\n    ctx.stroke();\n    ctx.fillStyle = '#000';\n    ctx.font = 'bold 10px Arial';\n    ctx.textAlign = 'center';\n    ctx.textBaseline = 'middle';\n    ctx.fillText(p.label, p.x, p.y + 1);\n  }\n\n  for (let i = 0; i < lasers.length; i++) {\n    let l = lasers[i];\n    ctx.strokeStyle = '#ff4f81';\n    ctx.lineWidth = 3;\n    ctx.beginPath();\n    ctx.moveTo(l.x, l.y);\n    ctx.lineTo(l.x, l.y - 18);\n    ctx.stroke();\n  }\n\n  if (activeEffects.shield > 0) {\n    ctx.strokeStyle = 'rgba(79,195,247,0.8)';\n    ctx.lineWidth = 4;\n    ctx.beginPath();\n    ctx.arc(paddle.x + paddle.w/2, paddle.y + 10, paddle.w/1.5, Math.PI, Math.PI * 2);\n    ctx.stroke();\n  }\n\n  ctx.fillStyle = activeEffects.fire > 0 ? '#ff6b35' : '#00ff88';\n  ctx.fillRect(paddle.x, paddle.y, paddle.w, paddle.h);\n  ctx.fillStyle = '#fff';\n  ctx.fillRect(paddle.x + 10, paddle.y + 3, paddle.w - 20, 3);\n\n  for (let i = 0; i < gameBalls.length; i++) {\n    let ball = gameBalls[i];\n    let g = ctx.createRadialGradient(ball.x - 2, ball.y - 2, 1, ball.x, ball.y, ball.r + 6);\n    if (ball.fire) {\n      g.addColorStop(0, '#ffffff');\n      g.addColorStop(0.35, '#fff59d');\n      g.addColorStop(0.7, '#ff6b35');\n      g.addColorStop(1, 'rgba(255,107,53,0.18)');\n    } else if (ball.ghost) {\n      g.addColorStop(0, '#ffffff');\n      g.addColorStop(0.45, '#cfd8dc');\n      g.addColorStop(1, 'rgba(176,190,197,0.18)');\n    } else {\n      g.addColorStop(0, '#ffffff');\n      g.addColorStop(0.45, '#b3e5fc');\n      g.addColorStop(0.78, '#4fc3f7');\n      g.addColorStop(1, 'rgba(79,195,247,0.18)');\n    }\n    ctx.fillStyle = g;\n    ctx.beginPath();\n    ctx.arc(ball.x, ball.y, ball.r, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.strokeStyle = 'rgba(255,255,255,0.95)';\n    ctx.lineWidth = 1.5;\n    ctx.stroke();\n    ctx.fillStyle = 'rgba(255,255,255,0.9)';\n    ctx.beginPath();\n    ctx.arc(ball.x - ball.r * 0.28, ball.y - ball.r * 0.28, Math.max(1.5, ball.r * 0.22), 0, Math.PI * 2);\n    ctx.fill();\n    if (ball.stuck) {\n      ctx.strokeStyle = 'rgba(0,255,136,0.8)';\n      ctx.lineWidth = 2;\n      ctx.beginPath();\n      ctx.arc(ball.x, ball.y, ball.r + 4, 0, Math.PI * 2);\n      ctx.stroke();\n    }\n  }\n\n  for (let i = 0; i < particles.length; i++) {\n    let p = particles[i];\n    ctx.globalAlpha = Math.max(0, p.life / p.max);\n    ctx.fillStyle = p.color;\n    ctx.fillRect(p.x, p.y, p.size, p.size);\n  }\n  ctx.globalAlpha = 1;\n\n  if (state === 'intro') {\n    overlay.style.display = 'flex';\n    overlayTitle.textContent = 'BREAKOUT POWER MIX';\n    overlayTitle.style.color = '#00ff88';\n    overlaySub.textContent = 'Tap to start • 8 levels • 14 power-ups • beat the high score';\n  }\n}\n\nlet last = performance.now();\nfunction loop(ts) {\n  let dt = ts - last;\n  if (dt > 32) dt = 32;\n  last = ts;\n  musicTick(ts);\n  update(dt);\n  draw();\n  updateHUD();\n  window.__canvasAnimId = requestAnimationFrame(loop);\n}\n\nfunction pointerX(ev) {\n  let rect = canvas.getBoundingClientRect();\n  let touch = ev.touches && ev.touches[0] ? ev.touches[0] : ev;\n  return (touch.clientX - rect.left) * (W / rect.width);\n}\n\ncanvas.addEventListener('pointerdown', function(e) {\n  ensureAudio();\n  pointerDown = true;\n  paddle.targetX = pointerX(e) - paddle.w / 2;\n  if (state === 'intro') {\n    restartGame();\n    return;\n  }\n  if ((state === 'gameover' || state === 'victory') && !pendingHigh) {\n    restartGame();\n    return;\n  }\n  if (state === 'playing') {\n    launchBalls();\n    if (activeEffects.laser > 0) {\n      lasers.push({ x: paddle.x + 12, y: paddle.y });\n      lasers.push({ x: paddle.x + paddle.w - 12, y: paddle.y });\n      sfx('laser');\n    }\n  }\n});\ncanvas.addEventListener('pointermove', function(e) {\n  paddle.targetX = pointerX(e) - paddle.w / 2;\n});\ncanvas.addEventListener('pointerup', function() { pointerDown = false; });\ncanvas.addEventListener('touchstart', function(e) { e.preventDefault(); }, { passive: false });\ncanvas.addEventListener('touchmove', function(e) { e.preventDefault(); }, { passive: false });\nwindow.addEventListener('keydown', function(e) {\n  keys[e.key] = true;\n  if (e.key === ' ' || e.key === 'Enter') {\n    ensureAudio();\n    if (state === 'intro') restartGame();\n    else if ((state === 'gameover' || state === 'victory') && !pendingHigh) restartGame();\n    else if (state === 'playing') launchBalls();\n  }\n  if (e.key === 'x' && activeEffects.laser > 0 && state === 'playing') {\n    lasers.push({ x: paddle.x + 12, y: paddle.y });\n    lasers.push({ x: paddle.x + paddle.w - 12, y: paddle.y });\n    sfx('laser');\n  }\n});\nwindow.addEventListener('keyup', function(e) { keys[e.key] = false; });\n\nmuteBtn.addEventListener('click', function() {\n  muted = !muted;\n  if (masterGain) masterGain.gain.value = muted ? 0 : 0.9;\n  muteBtn.textContent = 'MUTE: ' + (muted ? 'ON' : 'OFF');\n});\n\ninitialsInput.addEventListener('input', function() {\n  initialsInput.value = initialsInput.value.toUpperCase().replace(/[^A-Z]/g, '').slice(0, 3);\n});\nsaveScoreBtn.addEventListener('click', saveHigh);\ninitialsInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') saveHigh(); });\n\nupdateHUD();\nwindow.__canvasAnimId = requestAnimationFrame(loop);\n</script>\n</body>\n</html>",
