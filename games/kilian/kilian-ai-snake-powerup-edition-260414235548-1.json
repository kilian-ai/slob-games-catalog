{
  "name": "Snake Powerup Edition",
  "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>Snake — PowerUp Edition</title><style>*{box-sizing:border-box;margin:0;padding:0}body{width:390px;height:844px;overflow:hidden;margin:0;background:#0a0a0a;color:#e0e0e0;font-family:'Inter',system-ui,sans-serif}#hdr{display:flex;align-items:center;justify-content:space-between;padding:18px 18px 8px 18px}#hdr .title{font-size:22px;font-weight:700;}#score{font-size:22px;font-weight:700;color:#00ff88}#hs{font-size:13px;color:#44bf8a;margin-top:4px;letter-spacing:1px}#hud{position:absolute;top:58px;left:0;width:390px;display:flex;align-items:center;justify-content:center;z-index:10;font-size:14px;gap:16px}#hud .activepwr{background:#222;padding:3px 8px;border-radius:7px;display:flex;align-items:center;margin-right:0.5em;border:1.5px solid #393}#hud .icon{margin-right:4px;font-size:16px}#cw{display:flex;justify-content:center;}canvas{border-radius:10px;border:1.5px solid #222;background:#181818;}#ctrl{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px;margin-top:6px;}#ctrl .row{display:flex;gap:4px}.btn{width:68px;height:52px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:12px;font-size:20px;display:flex;align-items:center;justify-content:center;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:background .1s}.btn:active,.btn.pressed{background:rgba(0,255,136,.19);border-color:#00ff88}#overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(10,10,10,.93);text-align:center;z-index:999;transition:background .3s}#overlay.off{display:none}#overlay h2{font-size:33px;font-weight:700;margin-bottom:10px}#overlay p{color:#77ccc9;font-size:15px;margin-bottom:22px}#overlay button{margin-top:8px;background:rgba(0,255,136,.19);border:1px solid #00ff88;color:#00ff88;padding:13px 36px 11px 36px;border-radius:10px;font-size:16px;cursor:pointer;font-family:inherit}#pwinv{text-align:center;margin:10px 0 4px;font-size:13px;color:#00ff88}#initialsPrompt{background:#101e11;padding:25px 18px 18px 18px;border-radius:14px;border:2px solid #00ff88;box-shadow:0 4px 20px #00392765;font-size:17px;position:absolute;inset:0;margin:auto;display:none;flex-direction:column;align-items:center;justify-content:center;z-index:1001}#initialsPrompt input{margin:7px 0 12px 0;width:90px;font-size:22px;letter-spacing:5px;text-align:center;background:#090;border:none;border-radius:5px;color:#0a0a0a;font-weight:700;padding:5px 8px}#initialsPrompt label{color:#00ff88;font-size:15px;margin-bottom:2px}#initialsPrompt button{background:#222;border:1px solid #00ff88;color:#00ff88;padding:7px 30px 7px 30px;border-radius:8px;font-size:15px;cursor:pointer}#muteBtn{position:absolute;bottom:12px;right:28px;z-index:900;border:none;background:#111;width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 7px #080a08;cursor:pointer}#muteBtn svg{width:26px;height:26px;fill:#00ff88;}@media (max-width:400px){body{max-width:100vw;}} </style></head><body><div id=\"hdr\"><div><span class=\"title\"><span class=\"accent\">Snake</span> <span style=\"color:#4fc3f7;font-size:17px;letter-spacing:1px;\">PowerUp</span></span><div id=\"hs\">AAA 0</div></div><div id=\"score\">0</div></div><div id=\"hud\"></div><div id=\"cw\"><canvas id=\"c\" width=\"390\" height=\"560\"></canvas></div><div id=\"ctrl\"><div class=\"row\"><div class=\"btn\" id=\"bU\">▲</div></div><div class=\"row\"><div class=\"btn\" id=\"bL\">◄</div><div style=\"width:68px\"></div><div class=\"btn\" id=\"bR\">►</div></div><div class=\"row\"><div class=\"btn\" id=\"bD\">▼</div></div></div><div id=\"pwinv\"></div><div id=\"overlay\"><h2 id=\"otitle\">🐍 Snake PowerUp</h2><p id=\"otext\">Eat, grow, survive. Arrow keys or buttons to move!<br><span style=\"color:#4fc3f7;\">Collect power-ups for wild effects!</span></p><button id=\"obtn\">Start</button></div><div id=\"initialsPrompt\"><label for=\"initials\">New High Score! Enter Initials</label><input id=\"initials\" type=\"text\" maxlength=\"3\" autocomplete=\"off\"/><button id=\"submitInit\">OK</button></div><button id=\"muteBtn\" title=\"Mute\"><svg id=\"sndon\" viewBox=\"0 0 24 24\"><path d=\"M12 4l-7 7H1v2h4l7 7zm7.071 1.929a1 1 0 00-1.414 1.414A10.96 10.96 0 0121 12a10.96 10.96 0 01-3.343 7.657 1 1 0 001.414 1.414A12.96 12.96 0 0023 12a12.96 12.96 0 00-3.929-9.071z\"></path></svg><svg id=\"sndoff\" style=\"display:none\" viewBox=\"0 0 24 24\"><path d=\"M16.192 4.807A9 9 0 013 12a8.978 8.978 0 003 6.735V21a1 1 0 001.707.707l2.784-2.784A8.98 8.98 0 0012 21c4.418 0 8-3.582 8-8 0-2.209-.896-4.21-2.344-5.657l1.414-1.414a1 1 0 00-1.415-1.414l-1.413 1.414zM6.586 16l-.879.88A10.962 10.962 0 011 12c0-2.751 1.01-5.258 2.707-7.121l-.587-.587a1 1 0 00-1.415 1.415z\"></path></svg></button><script>const cvs=document.getElementById('c'),ctx=cvs.getContext('2d');const C=26,R=40,CW=cvs.width/C,CH=cvs.height/R;let game={};let running=false,level=1,maxLevel=8,paused=false,score=0,highScoreVal=0,highScoreInit='AAA',pendingInitials=false,muted=false,sfx={},music={},musicLvl=0;let pwrs=[{id:'life',label:'❤️',clr:'#ff3867',info:'Extra Life'},{id:'shr',label:'S',clr:'#4fc3f7',info:'Shrink'},{id:'spd',label:'⚡',clr:'#ffd600',info:'Speed+'},{id:'slow',label:'🐢',clr:'#00ff88',info:'Slowmo'},{id:'ghost',label:'👻',clr:'#9c30fe',info:'Ghost'},{id:'x2',label:'2X',clr:'#00e676',info:'Double Score'},{id:'bomb',label:'💣',clr:'#ff6b35',info:'Bomb'},{id:'mag',label:'🧲',clr:'#00eaff',info:'Magnet'}];let powerActive={},pwtimers={},pwIcons=[];function rn(n){return Math.floor(Math.random()*n)}function shuffle(arr){for(let i=arr.length-1;i>0;i--){let j=rn(i+1);[arr[i],arr[j]]=[arr[j],arr[i]]}}function saveHiscore(init,score){highScoreVal=score;highScoreInit=init;localStorage.setItem('snakePUHiscore',JSON.stringify({init,score}))}function loadHiscore(){try{let o=JSON.parse(localStorage.getItem('snakePUHiscore'));if(o&&o.score!==undefined){highScoreVal=o.score;highScoreInit=(o.init||'AAA').toUpperCase()}else{highScoreVal=0;highScoreInit='AAA'}}catch(e){highScoreVal=0;highScoreInit='AAA'}}function updateHiscoreDisplay(){let el=document.getElementById('hs');el.textContent=highScoreInit+' '+highScoreVal}function powerStatusHUD(){let hud=document.getElementById('hud');hud.innerHTML='';Object.keys(powerActive).forEach(k=>{if(powerActive[k]){let p=pwrs.find(x=>x.id===k);if(p){let d=document.createElement('span');d.className='activepwr';d.innerHTML=`<span class=\"icon\">${p.label}</span>${p.info}`;hud.appendChild(d);}}})}function showOverlay(msg1,msg2,btn){let ov=document.getElementById('overlay');ov.classList.remove('off');document.getElementById('otitle').innerText=msg1;document.getElementById('otext').innerHTML=msg2||'';document.getElementById('obtn').innerText=btn||'Start'}function hideOverlay(){document.getElementById('overlay').classList.add('off')}function showInitPrompt(){pendingInitials=true;let px=document.getElementById('initialsPrompt');px.style.display='flex';px.querySelector('input').value='';px.querySelector('input').focus()}function hideInitPrompt(){pendingInitials=false;document.getElementById('initialsPrompt').style.display='none'}function spawnFood(){let offtiles=[...game.snake,...game.barriers,...game.pwicons.map(p=>({x:p.x,y:p.y}))];let p;do{p={x:rn(C),y:rn(R)}}while(offtiles.some(t=>t.x===p.x&&t.y===p.y));game.food=p}function spawnBarrier(n){game.barriers=[];for(let i=0;i<n;i++){let p;do{p={x:rn(C),y:rn(R)}}while(game.snake.some(s=>s.x===p.x&&s.y===p.y)||game.food&&(game.food.x===p.x&&game.food.y===p.y));game.barriers.push(p)}}function spawnPowerIcon(forceIdx){let idx=(forceIdx!==undefined)?forceIdx:rn(pwrs.length);let t;do{t={x:rn(C),y:rn(R)}}while(game.snake.some(s=>s.x===t.x&&s.y===t.y)||game.food&&(game.food.x===t.x&&game.food.y===t.y)||game.barriers.some(b=>b.x===t.x&&b.y===t.y)||game.pwicons.some(p=>p.x===t.x&&p.y===t.y));game.pwicons.push({x:t.x,y:t.y,ptype:pwrs[idx].id,age:0,lbl:pwrs[idx].label,clr:pwrs[idx].clr})}function draw(){ctx.clearRect(0,0,cvs.width,cvs.height);ctx.fillStyle='#191b1a';ctx.fillRect(0,0,cvs.width,cvs.height);if(level%2==0){let g=ctx.createLinearGradient(0,0,0,cvs.height);g.addColorStop(0,'#18303a');g.addColorStop(1,'#0a2518');ctx.fillStyle=g;ctx.fillRect(0,0,cvs.width,cvs.height);}ctx.strokeStyle='#242927';ctx.lineWidth=1;for(let i=0;i<=C;i++){ctx.beginPath();ctx.moveTo(i*CW,0);ctx.lineTo(i*CW,cvs.height);ctx.stroke()}for(let j=0;j<=R;j++){ctx.beginPath();ctx.moveTo(0,j*CH);ctx.lineTo(cvs.width,j*CH);ctx.stroke()}ctx.save();if(game.barriers)for(let b of game.barriers){ctx.fillStyle='#444e4e';ctx.beginPath();ctx.arc(b.x*CW+CW/2,b.y*CH+CH/2,CH/2.2,0,Math.PI*2);ctx.fill()}ctx.restore();if(game.pwicons)for(let p of game.pwicons){ctx.save();ctx.globalAlpha=0.88;ctx.fillStyle=p.clr;ctx.beginPath();ctx.arc(p.x*CW+CW/2,p.y*CH+CH/2,CW*0.45,0,Math.PI*2);ctx.fill();ctx.fillStyle='#181818';ctx.font=`bold ${Math.floor(CW*0.99)}px Inter,sans-serif`;ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(p.lbl, p.x*CW+CW/2, p.y*CH+CH/2+1);ctx.restore();}ctx.save();ctx.shadowColor='#00ff88';ctx.shadowBlur=10;ctx.fillStyle='#00ff88';ctx.beginPath();ctx.arc(game.food.x*CW+CW/2,game.food.y*CH+CH/2,Math.min(CW,CH)*.355,0,2*Math.PI);ctx.fill();ctx.shadowBlur=0;ctx.restore();for(let i=game.snake.length-1;i>=0;i--){let s=game.snake[i];let alpha=1-(i/game.snake.length)*.5;ctx.save();ctx.globalAlpha=alpha;ctx.fillStyle=i==0?'#00ff88':'#4fc3f7';ctx.fillRect(s.x*CW+1.6,s.y*CH+1.6,CW-3.2,CH-3.2);ctx.restore()}if(powerActive['shield']){let h=game.snake[0];ctx.save();ctx.strokeStyle='#ffd600';ctx.lineWidth=4;ctx.globalAlpha=.65;ctx.beginPath();ctx.arc(h.x*CW+CW/2,h.y*CH+CH/2,CW/1.6,0,2*Math.PI);ctx.stroke();ctx.restore();}}function resetGameObjects(){let mx=Math.floor(C/2),my=Math.floor(R/2);game.snake=[{x:mx,y:my},{x:mx-1,y:my},{x:mx-2,y:my}];game.snakeDir={x:1,y:0};game.snakeNext={x:1,y:0};game.snakeLen=3;game.food={};game.barriers=[];game.lives=1;game.pwicons=[];game.levelTimer=0;}function startLevel(){game.pwicons=[];game.levelTimer=0;for(let k in powerActive){powerActive[k]=false;clearTimeout(pwtimers[k])}powerStatusHUD();resetGameObjects();score=0;document.getElementById('score').textContent=score;spawnFood();let barriers=Math.max(0,level-2)*3;spawnBarrier(barriers);draw();showOverlay('LEVEL '+level,' ','Go!');setTimeout(()=>{hideOverlay();running=true;loop();musicPlay(level)},1050);}function nextLevel(){level++;if(level>maxLevel){victoryScreen();return}showOverlay('LEVEL '+level+'<br><span style=\"font-size:17px;color:#ffd600;\">Get Ready!</span>',' ','Go!');setTimeout(()=>{startLevel()},1200);}function gameOver(){running=false;musicStop();sfxOver();showOverlay('Game Over','Score: '+score,'Play Again');checkHiScore();}function victoryScreen(){running=false;musicStop();sfxVictory();showOverlay('VICTORY!','You completed every level!<br>Score: '+score,'Play Again');checkHiScore();}function loop(){if(!running)return;window.__canvasAnimId&&cancelAnimationFrame(window.__canvasAnimId);window.__canvasAnimId=requestAnimationFrame(loop);step();draw();}function tryDir(d){if(!running)return;let same=game.snakeDir.x===d.x&&game.snakeDir.y===d.y;let opp=game.snakeDir.x===-d.x&&game.snakeDir.y===-d.y;if(!opp){game.snakeNext=d;sfxTurn()}}function onKeyDown(e){let key=e.key.toLowerCase();if(pendingInitials)return;let d=null;if(key==='arrowup'||key==='w') d={x:0,y:-1};else if(key==='arrowdown'||key==='s')d={x:0,y:1};else if(key==='arrowleft'||key==='a')d={x:-1,y:0};else if(key==='arrowright'||key==='d')d={x:1,y:0};if(d)tryDir(d);if(!running&&(key===' '||key==='enter')){if(level>maxLevel||!level)level=1;startLevel();}}function step(){let speedBase=110,speedMod=0;if(powerActive.spd)speedMod-=30;if(powerActive.slow)speedMod+=50;let now=performance.now(),tick=(game._lastTick||0);if(now-tick<Math.max(45,speedBase+speedMod))return;game._lastTick=now;let nx={x:(game.snake[0].x+game.snakeNext.x+C)%C,y:(game.snake[0].y+game.snakeNext.y+R)%R};if(powerActive['ghost']){}else if(game.barriers.some(b=>b.x===nx.x&&b.y===nx.y)){if(powerActive['shield']){powerActive['shield']=false;sfxShield();}else{game.lives--;if(game.lives<0){gameOver();return}sfxDeath();resetGameObjects();return;}}else if(game.snake.slice(1).some(s=>s.x===nx.x&&s.y===nx.y)){if(powerActive['ghost']){}else{gameOver();return}}game.snakeDir={...game.snakeNext};game.snake.unshift(nx);if(game.snake.length>game.snakeLen)game.snake.pop();if(nx.x===game.food.x&&nx.y===game.food.y){score+=(powerActive['x2']?2:1)*level;document.getElementById('score').textContent=score;sfxEat();game.snakeLen+=1;if(Math.random()<.49){spawnPowerIcon()}spawnFood();if(game.snakeLen>15+level*2)nextLevel();if(Math.random()<.12){spawnBarrier(1);}}for(let i=game.pwicons.length-1;i>=0;i--){let p=game.pwicons[i];p.age++;if(p.age>180){game.pwicons.splice(i,1);continue;}if(nx.x===p.x&&nx.y===p.y){activatePower(p.ptype);game.pwicons.splice(i,1);}}if(powerActive['mag']){if(Math.abs(game.snake[0].x-game.food.x)<4&&Math.abs(game.snake[0].y-game.food.y)<4){game.food.x+=(game.food.x>game.snake[0].x?-1:game.food.x<game.snake[0].x?1:0);game.food.y+=(game.food.y>game.snake[0].y?-1:game.food.y<game.snake[0].y?1:0);}}Object.keys(pwtimers).forEach(k=>{if(powerActive[k]&&pwtimers[k]&&Date.now()>pwtimers[k]){powerActive[k]=false;delete pwtimers[k];powerStatusHUD();}});powerStatusHUD();}function activatePower(id){switch(id){case'life':game.lives++;sfxLife();powerActive.life=true;setTimeout(()=>{powerActive.life=false;powerStatusHUD();},1750);break;case'spd':powerActive.spd=true;pwtimers.spd=Date.now()+5500;sfxPwr();break;case'slow':powerActive.slow=true;pwtimers.slow=Date.now()+7000;sfxPwr();break;case'shr':game.snakeLen=Math.max(3,game.snakeLen-3);sfxShrink();powerActive.shr=true;setTimeout(()=>{powerActive.shr=false;powerStatusHUD();},1500);break;case'ghost':powerActive.ghost=true;pwtimers.ghost=Date.now()+5000;sfxGhost();break;case'x2':powerActive.x2=true;pwtimers.x2=Date.now()+8000;sfxX2();break;case'bomb':game.barriers=[];sfxBomb();powerActive.bomb=true;setTimeout(()=>{powerActive.bomb=false;powerStatusHUD();},1200);break;case'mag':powerActive.mag=true;pwtimers.mag=Date.now()+6000;sfxMag();break;}powerStatusHUD();}function checkHiScore(){if(score>highScoreVal){showInitPrompt();}}function finishInitials(){let inp=document.getElementById('initials');let v=inp.value.toUpperCase().replace(/[^A-Z0-9]/g,'').slice(0,3)||'AAA';saveHiscore(v,score);updateHiscoreDisplay();hideInitPrompt();}loadHiscore();updateHiscoreDisplay();document.getElementById('obtn').onclick=()=>{level=1;startLevel();};['bU','bD','bL','bR'].forEach((id,i)=>{let m=[{x:0,y:-1},{x:0,y:1},{x:-1,y:0},{x:1,y:0}];document.getElementById(id).onclick=()=>tryDir(m[i]);});window.addEventListener('keydown',onKeyDown);document.getElementById('submitInit').onclick=finishInitials;document.getElementById('initials').onkeydown=e=>{if(e.key==='Enter')finishInitials();};function sfxInit(){let ctx;if(window.audioCtx)ctx=window.audioCtx;else{ctx=new(window.AudioContext||window.webkitAudioContext)();window.audioCtx=ctx;}function oneShot(freq,type,vol,dur,env){let o=ctx.createOscillator();let g=ctx.createGain();o.type=type||'sine';o.frequency.value=freq;g.gain.value=0;o.connect(g);g.connect(ctx.destination);let now=ctx.currentTime;let a1=env?.a1||0.01,a2=env?.a2||0.05,dv=vol||.2;g.gain.setValueAtTime(0,now);g.gain.linearRampToValueAtTime(dv,now+a1);g.gain.linearRampToValueAtTime(env?.s||0.01,now+a1+a2);g.gain.linearRampToValueAtTime(0,now+a1+a2+(env?.r||0.06));o.start(now);o.stop(now+a1+a2+(env?.r||0.09));}sfx={Eat:()=>{oneShot(432+rn(80),'triangle',.22,.10,{a1:.005,a2:.07,s:.11,r:.04})},Turn:()=>{oneShot(210+rn(80),'square',.08,0.10,{a1:.006,a2:.04,s:.05,r:.04})},Shield:()=>{oneShot(555,'triangle',.18,0.2,{a1:.012,a2:.09,s:.11,r:.07})},Life:()=>{for(let i=0;i<3;i++)setTimeout(()=>{oneShot(760+(i*120),'triangle',.18,0.14,{a1:.01,a2:.06,s:.13,r:.04})},i*55);},Death:()=>{for(let i=0;i<4;i++)setTimeout(()=>{oneShot(90-(i*16),'square',.18,.16,{a1:.008,a2:.05,s:.06,r:.04})},i*45);},Bomb:()=>{for(let i=0;i<5;i++)setTimeout(()=>oneShot(90+80*i,'sawtooth',.17,.13,{a1:.013,a2:.05,s:.09,r:.05}),i*23);},Shrink:()=>{oneShot(800,'triangle',.16,.11,{a1:.01,a2:.05,s:.1,r:.05})},Ghost:()=>{oneShot(210,'triangle',.14,.14,{a1:.014,a2:.09,s:.12,r:.05})},Pwr:()=>{oneShot(660+rn(60),'sawtooth',.19,.12,{a1:.01,a2:.04,s:.09,r:.04})},X2:()=>{for(let i=0;i<2;i++)setTimeout(()=>{oneShot(488+(i*58),'square',.13,.13,{a1:.01,a2:.07,s:.12,r:.05})},i*20)},Mag:()=>{oneShot(430,'triangle',.14,.13,{a1:.014,a2:.08,s:.13,r:.05})},Over:()=>{oneShot(72,'triangle',.17,.38,{a1:.016,a2:.17,s:.25,r:.20})},Victory:()=>{for(let i=0;i<6;i++)setTimeout(()=>{oneShot(420+(i*65),'triangle',.2,.16,{a1:.011,a2:.08,s:.15,r:.06})},i*45);}};}function sfxEat(){if(!muted)sfx.Eat();}function sfxTurn(){if(!muted)sfx.Turn();}function sfxShield(){if(!muted)sfx.Shield();}function sfxLife(){if(!muted)sfx.Life();}function sfxDeath(){if(!muted)sfx.Death();}function sfxBomb(){if(!muted)sfx.Bomb();}function sfxShrink(){if(!muted)sfx.Shrink();}function sfxGhost(){if(!muted)sfx.Ghost();}function sfxPwr(){if(!muted)sfx.Pwr();}function sfxX2(){if(!muted)sfx.X2();}function sfxMag(){if(!muted)sfx.Mag();}function sfxOver(){if(!muted)sfx.Over();}function sfxVictory(){if(!muted)sfx.Victory();}sfxInit();function musicInit(){let ctx=(window.audioCtx)||(window.audioCtx=new(window.AudioContext||window.webkitAudioContext)());let seq,beatI=0,mysrc,mGain;function note(freq,d_,w,t=0){let o=ctx.createOscillator();let g=ctx.createGain();o.frequency.value=freq;o.type=w;o.connect(g);g.connect(mGain);let now=ctx.currentTime+aoff;g.gain.value=0;g.gain.linearRampToValueAtTime(.12,now);g.gain.linearRampToValueAtTime(.05,now+0.23*d_);g.gain.linearRampToValueAtTime(0,now+0.38*d_);o.start(now);o.stop(now+d_);}function playBGSeq(lv){seq=[ [350,450,580,700],[460,545,420,630],[240,670,410,325,510,750],[333,567,