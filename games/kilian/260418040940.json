{
  "name": "Space Invaders Clone",
  "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=390, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover\">\n  <title>Space Blasters DX</title>\n  <style>\n    html, body {\n      background: #0a0a0a;\n      height: 100%;\n      margin: 0;\n      padding: 0;\n      overscroll-behavior-y: none;\n    }\n    body {\n      width: 100vw;\n      height: 100vh;\n      box-sizing: border-box;\n      padding-top: env(safe-area-inset-top);\n      padding-bottom: env(safe-area-inset-bottom);\n    }\n    #cvwrap {\n      width: 100vw;\n      height: 100vh;\n      touch-action: none;\n      overflow: hidden;\n      position: fixed;\n      inset: 0;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      z-index: 0;\n    }\n    canvas {\n      display: block;\n      width: 100vw;\n      height: 100vh;\n      max-width: 100vw;\n      max-height: 100vh;\n      background: #0a0a0a;\n      image-rendering: pixelated;\n      touch-action: none;\n    }\n    #mute-btn {\n      position: absolute;\n      right: 1.5vw;\n      top: calc(env(safe-area-inset-top, 0px) + 12px);\n      background: #252525ee;\n      border-radius: 50%;\n      border: 2px solid #4fc3f7;\n      color: #00ff88;\n      font-size: 1.7em;\n      width: 48px;\n      height: 48px;\n      z-index: 22;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin: 0;\n      padding: 0;\n      outline: none;\n      transition: background 0.2s;\n    }\n    #mute-btn[aria-pressed=\"true\"] {\n      background: #362424ee;\n      color: #ff6b35;\n      border-color: #ff6b35;\n    }\n    @media (orientation: landscape) {\n      #cvwrap, canvas {\n        max-width: 100vw;\n        max-height: 100vh;\n      }\n    }\n  </style>\n</head>\n<body>\n  <div id=\"cvwrap\"><canvas width=\"390\" height=\"844\"></canvas></div>\n  <button id=\"mute-btn\" title=\"Mute/unmute sound\" aria-pressed=\"false\"> <span id=\"mutetogg\">🔊</span></button>\n  <script>\n    // --- Sprite preloading ---\n    let spritePaths = {\n      player: 'sprites/player.png',\n      alien1: 'sprites/alien1.png',\n      alien2: 'sprites/alien2.png',\n      ufo: 'sprites/ufo.png',\n      shield: 'sprites/shield_piece.png',\n      player_laser: 'sprites/player_laser.png',\n      alien_laser: 'sprites/alien_laser.png',\n      powerups: {\n        mystery: 'sprites/powerup_mystery.png',\n        life: 'sprites/powerup_life.png',\n        speed: 'sprites/powerup_speed.png',\n        shield: 'sprites/powerup_shield.png',\n        scorex2: 'sprites/powerup_scorex2.png',\n        bomb: 'sprites/powerup_bomb.png',\n        magnet: 'sprites/powerup_magnet.png',\n      }\n    };\n    let sprites = {};\n    async function preloadSprites(cb) {\n      let keys = [\n        ['player', spritePaths.player],\n        ['alien1', spritePaths.alien1],\n        ['alien2', spritePaths.alien2],\n        ['ufo', spritePaths.ufo],\n        ['shield', spritePaths.shield],\n        ['player_laser', spritePaths.player_laser],\n        ['alien_laser', spritePaths.alien_laser],\n        ['powerup_mystery', spritePaths.powerups.mystery],\n        ['powerup_life', spritePaths.powerups.life],\n        ['powerup_speed', spritePaths.powerups.speed],\n        ['powerup_shield', spritePaths.powerups.shield],\n        ['powerup_scorex2', spritePaths.powerups.scorex2],\n        ['powerup_bomb', spritePaths.powerups.bomb],\n        ['powerup_magnet', spritePaths.powerups.magnet],\n      ];\n      let remain = keys.length;\n      for (let [key, path] of keys) {\n        await traits.loadVFSImage(path).then(img=>{sprites[key]=img; remain--;});\n      }\n      cb && cb();\n    }\n    // Responsive canvas scaler\n    let cv = document.querySelector('canvas');\n    let baseW = 390, baseH = 844;\n    function fitCanvas() {\n      let vw = window.visualViewport ? window.visualViewport.width : window.innerWidth;\n      let vh = window.visualViewport ? window.visualViewport.height : window.innerHeight;\n      let scale = Math.min(vw/baseW, vh/baseH);\n      cv.style.width = (baseW*scale)+\"px\";\n      cv.style.height = (baseH*scale)+\"px\";\n    }\n    window.visualViewport && visualViewport.addEventListener('resize', fitCanvas);\n    window.addEventListener('resize', fitCanvas);\n    fitCanvas();\n\n    // --- WebAudio ---\n    let audioCtx = null, muted = false, musicGain, sfxGain;\n    let bgMusicStart = false, bgMusicOscs = [];\n    function audioInit() {\n      if (audioCtx) return;\n      audioCtx = new (window.AudioContext||window.webkitAudioContext)();\n      musicGain = audioCtx.createGain();\n      musicGain.gain.value = muted ? 0 : 0.11;\n      musicGain.connect(audioCtx.destination);\n      sfxGain = audioCtx.createGain();\n      sfxGain.gain.value = muted ? 0 : 0.36;\n      sfxGain.connect(audioCtx.destination);\n    }\n    function playSFX(name) {\n      if (!audioCtx||muted) return;\n      let t = audioCtx.currentTime;\n      let o = audioCtx.createOscillator();\n      let g = audioCtx.createGain();\n      let f, typ = 'square', vol = 0.14, d = 0.16;\n      switch(name) {\n        case 'laser': f=780; typ='triangle'; break;\n        case 'alienlaser': f=370; typ='sawtooth'; d=0.2; break;\n        case 'alienhit': f=200; typ='square'; vol=0.21; d=0.21; break;\n        case 'ufo': f=660; typ='triangle'; d=0.32; break;\n        case 'powerup': f=1200; typ='triangle'; vol=0.23; d=0.19; break;\n        case 'levelup': f=970; typ='square'; vol=0.18; d=0.17; break;\n        case 'bonus': f=1480; typ='triangle'; vol=0.23; d=0.13; break;\n        case 'gameover': f=120; typ='sawtooth'; vol=0.22; d=0.44; break;\n        case 'highscore': f=1820; typ='triangle';vol=0.17;d=0.22;break;\n        case 'jump': f=540; typ='triangle'; vol=0.16; d=0.11; break;\n        default: f=520; break;\n      }\n      o.type = typ; o.frequency.setValueAtTime(f, t);\n      g.gain.value=vol;\n      o.connect(g); g.connect(sfxGain);\n      o.start(t);g.gain.linearRampToValueAtTime(0, t + d);\n      o.stop(t + d);\n    }\n    function startBgMusic(level) {\n      if (bgMusicOscs.length) {for(let o of bgMusicOscs) o.stop(); bgMusicOscs=[];}\n      if (!audioCtx||muted) return;\n      let root = 216 + (level*14), steps = [0,5,7,12,15,17,19];\n      let bps = 2 + 0.22*level, period = 60/bps, partLen=7;\n      let now = audioCtx.currentTime, n = 0;\n      for (let i=0;i<partLen;i++) {\n        let osc = audioCtx.createOscillator();\n        osc.type = (i%2==0)?'triangle':'square';\n        osc.frequency.value = root * Math.pow(2,steps[i]/12);\n        let gain = audioCtx.createGain();\n        gain.gain.value = 0.13-(0.013*i);\n        osc.connect(gain); gain.connect(musicGain);\n        osc.start(now + i*period);\n        osc.stop(now + (i+1)*period);\n        bgMusicOscs.push(osc);\n      }\n      setTimeout(()=>startBgMusic(level), partLen*period*1000);\n    }\n    function toggleMute() {\n      muted = !muted;\n      document.getElementById('mute-btn').setAttribute('aria-pressed', muted + '');\n      document.getElementById('mutetogg').textContent = muted ? '🔇' : '🔊';\n      if (audioCtx) {\n        musicGain.gain.value = muted ? 0 : 0.11;\n        sfxGain.gain.value = muted ? 0 : 0.36;\n      }\n    }\n    document.getElementById('mute-btn').onclick = function() {\n      audioInit();\n      toggleMute();\n    };\n    // High Score storage\n    function getHS() {\n      try{\n      let dat = localStorage.getItem('sb_dx_hs');\n      if (!dat) return {score:0, initials:'AAA'};\n      return JSON.parse(dat);\n      }catch(e){return {score:0, initials:'AAA'};}\n    }\n    function setHS(score, initials) {\n      localStorage.setItem('sb_dx_hs', JSON.stringify({score, initials}));\n    }\n    preloadSprites(startGame);\n    // --- Main Game Logic ---\n    function startGame() {\n      if(window.__canvasAnimId) cancelAnimationFrame(window.__canvasAnimId);\n      let ctx = cv.getContext('2d');\n      let W = 390, H = 844;\n      let groundY = H-70;\n      let player = {x:W/2, y:groundY, w:48, h:50, dx:0, speed:5, canFire:true, fireCD:380, shield:0, dead:false, invTimer:0, vy:0, onGround:true, jumpPower:11.8, facing:1};\n      let level = 1, finalLevel=8;\n      let lives = 3;\n      let score = 0;\n      let aliens = [], alienLasers = [], playerLasers = [], shields = [], powerups=[], activePowerups={}, powerupTimer=0, powerupStatusHistory=[], ufo = null, ufoTimer=0;\n      let highscore = getHS();\n      let initialsPrompt = null;\n      let inputInitials = '';\n      let gameState = 'intro';\n      let levelIntroTimer=0, levelTransitionMs=1200;\n      let frameCt=0;\n      let magnetActive=false;\n      let moveLeftHeld=false, moveRightHeld=false, fireHeld=false, jumpHeld=false;\n      let lastGroundTouch = 0;\n      let jumpBuffered = 0;\n      let touchMode = {left:false,right:false,fire:false,jump:false};\n      let waveTimer = 0;\n      let waveIndex = 0;\n      let waveSpeedScale = 0.7;\n      //--- Power-up configs\n      let powerupList = [\n        {key:'life', label:'EXTRA LIFE'},\n        {key:'shield', label:'SHIELD'},\n        {key:'speed', label:'SPEED'},\n        {key:'scorex2', label:'SCORE x2'},\n        {key:'bomb', label:'BOMB'},\n        {key:'magnet', label:'MAGNET'},\n        {key:'mystery', label:'MYSTERY'}\n      ];\n      function resetPowerups(){activePowerups={};powerupStatusHistory=[];}\n      function activatePowerup(k) {\n        activePowerups[k] = 990;\n        if (['life','bomb'].indexOf(k)==-1)\n          powerupStatusHistory.unshift({key:k, time:990});\n        if (k=='life') {lives = Math.min(lives+1, 9);playSFX('bonus');}\n        if (k=='shield') {player.shield=690;playSFX('powerup');}\n        if (k=='speed') {player.speed=8.5;playSFX('powerup');}\n        if (k=='scorex2') {playSFX('powerup');}\n        if (k=='bomb') {aliens=[]; playSFX('bonus');}\n        if (k=='magnet') {magnetActive=true;playSFX('powerup');}\n        if (k=='mystery') {\n          let arr = powerupList.slice(0, powerupList.length-1);\n          let roll = arr[Math.floor(Math.random()*arr.length)].key;\n          activatePowerup(roll);\n        }\n      }\n      function deactivatePowerup(k) {\n        delete activePowerups[k];\n        if (k=='speed') player.speed=5;\n        if (k=='magnet') magnetActive=false;\n      }\n      function drawPowerupTimers(ctx) {\n        let x=W-4, y=52;\n        let xs=-38;\n        let shown=0;\n        for (let key in activePowerups) {\n          if (!sprites['powerup_'+key]) continue;\n          ctx.drawImage(sprites['powerup_'+key], x+xs*shown-30, y, 32, 32);\n          let prg = Math.max(0,activePowerups[key])/990;\n          ctx.save();ctx.globalAlpha=0.5;\n          ctx.fillStyle='#00ff8888'; ctx.fillRect(x+xs*shown-30, y+29, 32*prg, 4);\n          ctx.restore();\n          shown++;\n        }\n        if(shown<2 && powerupStatusHistory.length>0) {\n          let entry=powerupStatusHistory[0];\n          ctx.drawImage(sprites['powerup_'+entry.key], x+xs*shown-30, y, 32, 32);\n          let prg = Math.max(0,entry.time)/990;\n          ctx.save();ctx.globalAlpha=0.17;\n          ctx.fillStyle='#4fc3f7';ctx.fillRect(x+xs*shown-30, y+29, 32*prg, 4);\n          ctx.restore();\n        }\n      }\n      function formatScore(n) {let s=n+'';while(s.length<6)s='0'+s;return s;}\n      function getWaveProgress() {\n        let total = Math.max(420, 760 - level * 34);\n        let prog = 1 - (waveTimer / total);\n        if (prog < 0) prog = 0;\n        if (prog > 1) prog = 1;\n        return prog;\n      }\n      function getAlienSpeed() {\n        let living = aliens.filter(a=>a.alive).length;\n        let base = 0.34 + 0.04*level + (living<7 ? 0.12 : 0);\n        let waveRamp = 0.72 + getWaveProgress() * (0.95 + level*0.08);\n        return base * waveRamp;\n      }\n      function getAlienFireRate() {\n        return 0.006 + 0.0018*level + getWaveProgress()*(0.0032 + 0.0009*level);\n      }\n      function getUFORate() {\n        return 0.0023 + 0.00095*level + getWaveProgress()*0.0009;\n      }\n      function layoutAliens() {\n        aliens=[];\n        let nRows = 6+Math.floor(level/2);\n        let nCols = 10+level;\n        let maxCols = 14;\n        let maxRows = 8;\n        nRows = Math.min(nRows, maxRows);\n        nCols = Math.min(nCols, maxCols);\n        let type2rows = [];\n        for(let i=0;i<nRows;i++) type2rows[i]=(Math.random()<0.38+0.11*level)?2:1;\n        let startY=110+(level*5);\n        let paddingX = 8;\n        let availableX = 390 - 2*paddingX - nCols*32;\n        let gapX = availableX>0?(availableX/(nCols-1)):0;\n        for(let row=0;row<nRows;row++) {\n          for(let c=0;c<nCols;c++) {\n            let x=paddingX + c*(32+gapX); let y=startY+(row*35); let t=type2rows[row];\n            aliens.push({x, y, w:32, h:30, type:t, alive:true, fireCD:120+Math.random()*100, bobP:Math.random()*Math.PI*2 });\n          }\n        }\n      }\n      function layoutShields() {\n        shields=[];\n        let y0=H-210;\n        let num=level<5?4:3;\n        for(let s=0;s<num;s++) for (let px=0;px<3;px++) for(let py=0;py<2;py++)\n          shields.push({x:68+s*80+px*17, y:y0+py*15, w:16, h:14, hp:2});\n      }\n      function newLevel(lv) {\n        gameState='intro';\n        level=lv;\n        resetPowerups();\n        player.x=W/2;\n        player.y=groundY;\n        player.vy=0;\n        player.onGround=true;\n        player.dead=false;player.invTimer=0;player.shield=0;player.speed=5;\n        layoutAliens();\n        layoutShields();\n        powerups=[];playerLasers=[];alienLasers=[];ufo=null;\n        waveIndex = 0;\n        waveTimer = Math.max(420, 760 - level * 34);\n        waveSpeedScale = 0.7;\n        levelIntroTimer = levelTransitionMs;\n        audioInit(); startBgMusic(level);\n        setTimeout(()=>{gameState='play'; levelIntroTimer=0;},levelTransitionMs);\n      }\n      function spawnPowerup(x,y,prob) {\n        if (Math.random()<prob) {\n          let want = powerupList[Math.floor(Math.random()*powerupList.length)].key;\n          powerups.push({x:x, y:y, w:28, h:28, vy:2.0+Math.random()*0.85, type:want});\n        }\n      }\n      function spawnUFO() {\n        if(ufo) return;\n        let side = Math.random()<0.5?0:1;\n        ufo={x:side?W+38:-38, y:80+Math.random()*44, w:38, h:30, vx:side?-(4.0 + level*0.12 + getWaveProgress()*1.2):(4.0 + level*0.12 + getWaveProgress()*1.2), hp:3, ttl:380};\n      }\n      function endGame(win) {\n        gameState=win?'victory':'gameover';\n        audioInit();\n        if (score>highscore.score) {\n          initialsPrompt = true;\n          inputInitials = '';\n        }\n        setTimeout(()=>{gameState='highscore';},1480);\n      }\n      function drawHud(ctx) {\n        ctx.save();\n        ctx.globalAlpha=0.88;\n        ctx.fillStyle=\"#17171a\";\n        ctx.fillRect(0,0,W,44);\n        ctx.restore();\n        ctx.font=\"700 21px monospace\";\n        ctx.fillStyle=\"#00ff88\";\n        ctx.textBaseline=\"top\";\n        ctx.fillText(\"SCORE\",12,10);\n        ctx.fillText(formatScore(score),12,24);\n        ctx.fillStyle=\"#4fc3f7\";\n        ctx.fillText(\"LIVES\",134,10);\n        for(let i=0;i<lives;i++) ctx.drawImage(sprites.player, 202+i*23,9,20,21);\n        ctx.font=\"700 16px monospace\";\n        ctx.fillStyle=\"#ff6b35\";\n        ctx.fillText(\"HI \" + highscore.initials + ' ' + formatScore(highscore.score), 16, 45);\n        ctx.font=\"700 12px monospace\";\n        ctx.fillStyle=\"#80efd9\";\n        ctx.fillText(\"MOVE ← →  JUMP ↑/X  FIRE SPACE/Z\", 12, 66);\n      }\n      function drawLevelIntro() {\n        ctx.save();\n        ctx.globalAlpha = 0.89;\n        ctx.fillStyle = \"#181c21\";\n        ctx.fillRect(0,0,W,H);\n        ctx.globalAlpha = 1;\n        ctx.font = \"900 35px monospace\";\n        ctx.fillStyle = \"#00ff88\";\n        ctx.textAlign = \"center\";\n        ctx.fillText(`LEVEL ${level}`,W/2, H/2-38);\n        let names = [\"STARRY SKY\", \"RAID SIEGE\", \"SHIELD CHAOS\", \"SWARM BLAST\",\"DANGER HALL\",\"INVADER WARP\",\"ASTRO NIGHT\",\"ACE ENDGAME\"];\n        ctx.font = \"bold 20px monospace\";\n        ctx.fillStyle = \"#ff6b35\";\n        ctx.fillText(names[level-1]||\"BATTLEFIELD\",W/2,H/2+10);\n        ctx.font = \"bold 15px monospace\";\n        ctx.fillStyle = \"#4fc3f7\";\n        ctx.fillText(\"Move, jump dodge, collect power-ups\",W/2,H/2+42);\n        ctx.restore();\n      }\n      function drawVictory() {\n        ctx.save();\n        ctx.globalAlpha = 0.97;\n        ctx.fillStyle = \"#0a1e12\";\n        ctx.fillRect(0,0,W,H);\n        ctx.globalAlpha = 1;\n        ctx.font = \"800 45px monospace\";\n        ctx.fillStyle = \"#00ff88\";\n        ctx.textAlign = \"center\";\n        ctx.fillText(\"VICTORY!\",W/2,H/2-45);\n        ctx.font = \"bold 26px monospace\";\n        ctx.fillStyle = \"#4fc3f7\";\n        ctx.fillText(`Score: ${score}`,W/2,H/2+16);\n        ctx.font = \"bold 17px monospace\";\n        ctx.fillStyle = \"#ff6b35\";\n        ctx.fillText(`High: ${highscore.initials} ${formatScore(highscore.score)}`,W/2,H/2+50);\n        ctx.restore();\n      }\n      function drawGameOver() {\n        ctx.save();\n        ctx.globalAlpha = 0.90;\n        ctx.fillStyle = \"#1b121c\";\n        ctx.fillRect(0,0,W,H);\n        ctx.globalAlpha = 1;\n        ctx.font = \"800 40px monospace\";\n        ctx.fillStyle = \"#ff6b35\";\n        ctx.textAlign = \"center\";\n        ctx.fillText(\"GAME OVER\",W/2,H/2-35);\n        ctx.font = \"bold 25px monospace\";\n        ctx.fillStyle = \"#00ff88\";\n        ctx.fillText(`Score: ${score}`,W/2,H/2+16);\n        ctx.font = \"bold 17px monospace\";\n        ctx.fillStyle = \"#4fc3f7\";\n        ctx.fillText(`High: ${highscore.initials} ${formatScore(highscore.score)}`,W/2,H/2+47);\n        ctx.restore();\n      }\n      function drawInitialsPrompt() {\n        ctx.save();\n        ctx.globalAlpha=0.76;\n        ctx.fillStyle=\"#20204a\";\n        ctx.fillRect(W/2-120,H/2-60,240,82);\n        ctx.globalAlpha=1;\n        ctx.font=\"800 23px monospace\";\n        ctx.fillStyle=\"#00ff88\";\n        ctx.textAlign=\"center\";\n        ctx.fillText(\"NEW HIGH SCORE!\",W/2,H/2-23);\n        ctx.font=\"700 19px monospace\";\n        ctx.fillStyle=\"#4fc3f7\";\n        ctx.fillText(\"ENTER INITIALS:\",W/2,H/2+3);\n        ctx.font=\"900 31px monospace\";\n        ctx.fillStyle=\"#ff6b35\";\n        ctx.fillText(inputInitials||'___',W/2,H/2+34);\n        ctx.restore();\n      }\n      function drawTouchHints(){\n        ctx.save();\n        ctx.globalAlpha=0.17;\n        ctx.strokeStyle='#4fc3f7';\n        ctx.lineWidth=2;\n        ctx.strokeRect(10,H-150,112,112);\n        ctx.strokeRect(W-122,H-150,112,50);\n        ctx.strokeRect(W-122,H-92,112,54);\n        ctx.font='700 16px monospace';\n        ctx.textAlign='center';\n        ctx.fillStyle='#4fc3f7';\n        ctx.fillText('MOVE',66,H-95);\n        ctx.fillStyle='#00ff88';\n        ctx.fillText('FIRE',W-66,H-136);\n        ctx.fillStyle='#ff6b35';\n        ctx.fillText('JUMP',W-66,H-72);\n        ctx.restore();\n      }\n      // --- Main draw\n      function drawBgStarfield(){\n        let num=62,fx=ctx;\n        fx.save();fx.globalAlpha=0.18;for(let i=0;i<num;i++){\n          fx.fillStyle=[\"#bdfaff\",\"#80efd9\",\"#ffbb7a\",\"#fa80bc\"][i%4];\n          fx.beginPath();fx.arc(((i*59)%W),((i*119)%H),1.2+((i*13)%2),0,7);\n          fx.fill();}\n        fx.restore();}\n      function drawPlayer() {\n        if (player.invTimer && Math.floor(player.invTimer/7)%2==0) return;\n        ctx.save();\n        ctx.globalAlpha=player.dead?.66:1;\n        if(player.shield>0){ctx.save();ctx.globalAlpha=0.27+0.17*Math.sin(Date.now()/105);ctx.beginPath();ctx.arc(player.x,player.y+8,25,0,Math.PI*2);ctx.fillStyle=\"#4fc3f7\";ctx.fill();ctx.restore();}\n        let tilt = player.onGround ? player.dx*0.02 : player.dx*0.03;\n        ctx.translate(player.x, player.y);\n        ctx.rotate(tilt);\n        let bounce = player.onGround ? 0 : Math.sin(frameCt*0.35)*2;\n        ctx.drawImage(sprites.player, -player.w/2, -player.h/2+bounce, player.w, player.h);\n        ctx.restore();\n      }\n      function drawAliens() {\n        for (let i=0;i<aliens.length;i++) {\n          let a=aliens[i];if(!a.alive)continue;\n          let img = sprites[ a.type==2? 'alien2' :'alien1'];\n          let bob = Math.sin(performance.now()/310.5 + a.bobP)*4;\n          ctx.drawImage(img,a.x,a.y+bob,a.w,a.h);\n        }\n      }\n      function drawShields() {\n        for(let s of shields) if (s.hp>0)\n          ctx.drawImage(sprites.shield, s.x, s.y, s.w, s.h);\n      }\n      function drawLasers() {\n        for(let l of playerLasers) ctx.drawImage(sprites.player_laser, l.x-3, l.y, 7, 23);\n        for(let l of alienLasers) ctx.drawImage(sprites.alien_laser, l.x-3, l.y, 7, 23);\n      }\n      function drawUFO() {\n        if(ufo) ctx.drawImage(sprites.ufo, ufo.x-ufo.w/2, ufo.y-ufo.h/2, ufo.w,ufo.h);\n      }\n      function drawPowerups() {\n        for (let p of powerups) {\n          let img = sprites['powerup_'+p.type];\n          if(img) ctx.drawImage(img,p.x,p.y,p.w,p.h);\n        }\n      }\n      function setMoveStateFromTouches(){\n        moveLeftHeld = touchMode.left;\n        moveRightHeld = touchMode.right;\n        fireHeld = touchMode.fire;\n        jumpHeld = touchMode.jump;\n      }\n      function triggerJump(){\n        jumpBuffered = 10;\n      }\n      // --- INPUT ---\n      document.body.onkeydown=function(e) {\n        if(initialsPrompt){\n            if(e.key.length===1 && inputInitials.length<3 && /[a-zA-Z0-9]/.test(e.key)) { inputInitials+=e.key.toUpperCase(); playSFX('bonus'); }\n            else if(e.key==='Backspace') { inputInitials=inputInitials.slice(0,-1); }\n            else if((e.key==='Enter'||e.key===' '||inputInitials.length==3)){\n               setHS(score, inputInitials||'___');\n               initialsPrompt=false;highscore=getHS();\n               newLevel(1);return;\n            }\n            e.preventDefault();return;\n        }\n        if(e.key=='ArrowLeft'||e.key=='a'||e.key=='A') moveLeftHeld=true;\n        else if(e.key=='ArrowRight'||e.key=='d'||e.key=='D') moveRightHeld=true;\n        else if(e.key==' '||e.key=='z'||e.key=='Z') fireHeld=true;\n        else if(e.key=='ArrowUp'||e.key=='w'||e.key=='W'||e.key=='x'||e.key=='X') {\n          if(!jumpHeld) triggerJump();\n          jumpHeld=true;\n        }\n      };\n      document.body.onkeyup=function(e) {\n        if(e.key=='ArrowLeft'||e.key=='a'||e.key=='A') moveLeftHeld=false;\n        else if(e.key=='ArrowRight'||e.key=='d'||e.key=='D') moveRightHeld=false;\n        else if(e.key==' '||e.key=='z'||e.key=='Z') fireHeld=false;\n        else if(e.key=='ArrowUp'||e.key=='w'||e.key=='W'||e.key=='x'||e.key=='X') jumpHeld=false;\n      };\n      cv.ontouchstart=function(e){\n        e.preventDefault();\n        touchMode.left=false; touchMode.right=false; touchMode.fire=false; touchMode.jump=false;\n        for(let i=0;i<e.touches.length;i++){\n          let rect = cv.getBoundingClientRect();\n          let x=(e.touches[i].clientX-rect.left)*(W/rect.width);\n          let y=(e.touches[i].clientY-rect.top)*(H/rect.height);\n          if(x<130 && y>H-170) {\n            if(x<65) touchMode.left=true; else touchMode.right=true;\n          } else if(x>W-130 && y>H-170) {\n            if(y<H-96) touchMode.fire=true; else touchMode.jump=true;\n          } else {\n            if(x<W/2) touchMode.left=true; else touchMode.right=true;\n          }\n        }\n        if(touchMode.jump) triggerJump();\n        setMoveStateFromTouches();\n      };\n      cv.ontouchmove=function(e){\n        e.preventDefault();\n        touchMode.left=false; touchMode.right=false; touchMode.fire=false; touchMode.jump=false;\n        for(let i=0;i<e.touches.length;i++){\n          let rect = cv.getBoundingClientRect();\n          let x=(e.touches[i].clientX-rect.left)*(W/rect.width);\n          let y=(e.touches[i].clientY-rect.top)*(H/rect.height);\n          if(x<130 && y>H-170) {\n            if(x<65) touchMode.left=true; else touchMode.right=true;\n          } else if(x>W-130 && y>H-170) {\n            if(y<H-96) touchMode.fire=true; else touchMode.jump=true;\n          }\n        }\n        setMoveStateFromTouches();\n      };\n      cv.ontouchend=function(e){\n        e.preventDefault();\n        touchMode.left=false; touchMode.right=false; touchMode.fire=false; touchMode.jump=false;\n        for(let i=0;i<e.touches.length;i++){\n          let rect = cv.getBoundingClientRect();\n          let x=(e.touches[i].clientX-rect.left)*(W/rect.width);\n          let y=(e.touches[i].clientY-rect.top)*(H/rect.height);\n          if(x<130 && y>H-170) {\n            if(x<65) touchMode.left=true; else touchMode.right=true;\n          } else if(x>W-130 && y>H-170) {\n            if(y<H-96) touchMode.fire=true; else touchMode.jump=true;\n          }\n        }\n        setMoveStateFromTouches();\n      };\n      // --- GAME LOOP ---\n      function loop() {\n        ctx.clearRect(0,0,W,H);\n        drawBgStarfield();\n        drawHud(ctx);\n        drawPowerupTimers(ctx);\n        drawTouchHints();\n        if(gameState==='intro') {\n           drawLevelIntro();\n           window.__canvasAnimId = requestAnimationFrame(loop); return;\n        }\n        if(gameState==='victory') {drawVictory(); window.__canvasAnimId=requestAnimationFrame(loop); return;}\n        if(gameState==='gameover') {drawGameOver(); window.__canvasAnimId=requestAnimationFrame(loop); return;}\n        if(initialsPrompt) {drawInitialsPrompt(); window.__canvasAnimId=requestAnimationFrame(loop); return;}\n        drawShields();\n        drawLasers();\n        drawAliens();\n        drawUFO();\n        drawPlayer();\n        drawPowerups();\n        if (waveTimer > 0) waveTimer--;\n        else {\n          waveIndex++;\n          waveTimer = Math.max(240, 720 - level * 28 - waveIndex * 32);\n        }\n        waveSpeedScale = 0.7 + getWaveProgress() * (0.95 + level*0.08);\n        let alienSpeed = getAlienSpeed();\n        let boundary=[W-44,30], moveDown=false;\n        for(let a of aliens) if(a.alive){\n          a.x+=alienSpeed*(frameCt%2?1:-1)*((level%2)?-1:1);\n          let out=(a.x<boundary[1]||a.x+30>boundary[0]);\n          if(out&&!moveDown)moveDown=true;\n        }\n        if(moveDown){for(let a of aliens) if(a.alive){a.y+=28; a.x-=(alienSpeed*20*(frameCt%2?1:-1)*((level%2)?-1:1));}}\n        if(!ufo && Math.random()<getUFORate()) spawnUFO();\n        if(ufo){\n          ufo.x+=ufo.vx;\n          ufo.ttl-=1;\n          if(ufo.x<-44||ufo.x>W+44||ufo.ttl<=0) ufo=null;\n        }\n        if(!player.dead){\n          let target = 0;\n          if(moveLeftHeld) target -= player.speed;\n          if(moveRightHeld) target += player.speed;\n          player.dx += (target - player.dx) * 0.34;\n          if(!moveLeftHeld && !moveRightHeld) player.dx *= player.onGround ? 0.72 : 0.92;\n          player.x += player.dx;\n          if(player.x<22){player.x=22;player.dx=0;}\n          if(player.x>W-22){player.x=W-22;player.dx=0;}\n          if(player.onGround) lastGroundTouch = 8; else if(lastGroundTouch>0) lastGroundTouch--;\n          if(jumpBuffered>0) jumpBuffered--;\n          if(jumpBuffered>0 && lastGroundTouch>0){\n            player.vy = -player.jumpPower;\n            player.onGround = false;\n            jumpBuffered = 0;\n            lastGroundTouch = 0;\n            playSFX('jump');\n          }\n          player.vy += 0.52;\n          if(player.vy > 11.6) player.vy = 11.6;\n          player.y += player.vy;\n          if(player.y >= groundY){\n            if(!player.onGround && player.vy>2.5) playSFX('bonus');\n            player.y = groundY;\n            player.vy = 0;\n            player.onGround = true;\n          } else {\n            player.onGround = false;\n          }\n          if(jumpHeld && player.vy < 0) player.vy -= 0.12;\n        }\n        if(activePowerups.speed&&activePowerups.speed>0) player.speed=8.5;\n        else player.speed=5;\n        if(player.invTimer) player.invTimer--;\n        if(player.shield) player.shield--;\n        if(fireHeld && player.canFire && !player.dead) {\n          playerLasers.push({x:player.x, y:player.y-25, vy:-9.2, w:8, h:21});\n          player.canFire=false;\n          setTimeout(()=>player.canFire=true,player.fireCD-(activePowerups.speed?85:0));\n          playSFX('laser');\n        }\n        for(let l of playerLasers) l.y+=l.vy;\n        for(let l of alienLasers) l.y+=4.3+1.6*Math.random()+getWaveProgress()*0.8+level*0.03;\n        playerLasers=playerLasers.filter(l=>l.y>-25);\n        alienLasers=alienLasers.filter(l=>l.y<H+31);\n        let alienFireRate = getAlienFireRate();\n        for(let a of aliens)if(a.alive&&Math.random()<alienFireRate && aliens.indexOf(a)%3===frameCt%3){\n          alienLasers.push({x:a.x+a.w/2, y:a.y+a.h, w:7, h:19});playSFX('alienlaser');\n        }\n        if(ufo && Math.random()<0.082 + getWaveProgress()*0.04 + level*0.003){\n          alienLasers.push({x:ufo.x, y:ufo.y+15, w:7, h:19}); playSFX('ufo');\n        }\n        for(let lidx=playerLasers.length-1;lidx>=0;lidx--){\n          let l=playerLasers[lidx];\n          for(let a of aliens)if(a.alive&&rectsCollide(l,a)){\n            a.alive=false;\n            score+=(a.type==2?120:85)*(activePowerups.scorex2?2:1);\n            if(Math.random()<0.16+0.08*level) spawnPowerup(a.x+7,a.y+7,0.61); else if(Math.random()<0.13) spawnPowerup(a.x,a.y,0.13);\n            playerLasers.splice(lidx,1); playSFX('alienhit');\n          break;}}\n        if (ufo) for(let lidx=playerLasers.length-1;lidx>=0;lidx--){\n          let l=playerLasers[lidx];\n          if(rectsCollide(l,ufo)){\n            ufo.hp--; score+=220*(activePowerups.scorex2?2:1); playerLasers.splice(lidx,1);\n            spawnPowerup(ufo.x,ufo.y,0.89);\n            if(ufo.hp<=0){ufo=null; playSFX('ufo');}\n          }\n        }\n        for(let lidx=alienLasers.length-1;lidx>=0;lidx--){\n          let l=alienLasers[lidx];\n          let hitShield=false;\n          for(let s of shields) if (s.hp>0 && rectsCollide(l,s)) {s.hp--;alienLasers.splice(lidx,1);hitShield=true;break;}\n          if(hitShield) continue;\n          if(!player.dead && rectsCollide(l,player)){\n            if(player.shield>0){alienLasers.splice(lidx,1);player.shield=0;playSFX('powerup');continue;}\n            if(player.invTimer) continue;\n            player.dead=true;lives--;\n            setTimeout(()=>{player.dead=false;player.invTimer=105;player.y=groundY;player.vy=0;player.onGround=true;},690);\n            alienLasers.splice(lidx,1); playSFX('gameover');\n            if(lives<=0) {endGame(false);return;}\n          }\n        }\n        for(let a of aliens){\n          if(a.alive && !player.dead && Math.abs(a.y-player.y)<32 && Math.abs(a.x-player.x)<28){\n            if(player.shield){player.shield=0;playSFX('powerup');continue;}\n            if(player.invTimer) continue;\n            player.dead=true;lives--;\n            setTimeout(()=>{player.dead=false;player.invTimer=107;player.y=groundY;player.vy=0;player.onGround=true;},720);\n            playSFX('gameover');\n            if(lives<=0) {endGame(false);return;}\n          }\n        }\n        for(let pidx=powerups.length-1;pidx>=0;pidx--){\n          let p=powerups[pidx];\n          p.y+=p.vy;\n          if(magnetActive){\n            let px = p.x + p.w/2;\n            let py = p.y + p.h/2;\n            let dx = player.x - px;\n            let dy = player.y - py;\n            let dist = Math.hypot(dx,dy);\n            if(dist<150){\n              p.x += dx*0.12;\n              p.y += dy*0.08;\n            } else if(Math.abs(p.x-player.x)<87) p.x+=(player.x-p.x)*0.11;\n          }\n          if(rectsCollide(p,{x:player.x-player.w/2,y:player.y-player.h/2,w:player.w,h:player.h}) && !player.dead){activatePowerup(p.type);powerups.splice(pidx,1);}\n          else if(p.y>H) powerups.splice(pidx,1);\n        }\n        for(let k in activePowerups){activePowerups[k]--;if(activePowerups[k]<=0)deactivatePowerup(k);}\n        if(aliens.filter(a=>a.alive).length==0){\n          setTimeout(()=>{\n            if(level>=finalLevel) endGame(true); else newLevel(level+1);\n          },1000);\n        }\n        frameCt++;\n        window.__canvasAnimId=requestAnimationFrame(loop);\n      }\n      function rectsCollide(a, b) {\n          return !(a.x + a.w < b.x || a.x > b.x + b.w || a.y + a.h < b.y || a.y > b.y + b.h);\n      }\n      newLevel(1);\n      window.__canvasAnimId = requestAnimationFrame(loop);\n    }\n  </script>\n</body>\n</html>",
