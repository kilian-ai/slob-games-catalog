{
  "name": "BrickStorm DX",
  "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>BrickStorm DX</title><style>*{margin:0;padding:0;box-sizing:border-box}body{width:390px;height:844px;overflow:hidden;background:#0a0a0a;color:#e0e0e0;font-family:system-ui,sans-serif;user-select:none;position:relative}#hdr{display:flex;align-items:center;justify-content:space-between;padding:18px 20px 10px}#hdr .title{font-size:22px;font-weight:700}.accent{color:#00ff88}#score{font-size:22px;font-weight:700;color:#00ff88}#hs{font-size:11px;color:#555;margin-top:2px}#hud{display:flex;gap:10px;font-size:13px;font-weight:600;margin-bottom:2px;justify-content:center;align-items:center;min-height:22px;flex-wrap:wrap;padding:0 8px}#hud .pu{background:#222;padding:2px 12px 2px 8px;border-radius:11px;display:inline-flex;align-items:center;gap:4px;border:2px solid #333;font-size:12px;font-weight:700;}#hud .pu.active{border-color:#00ff88;background:#0e2}#cw{display:flex;justify-content:center;padding:0}canvas{border-radius:8px;border:1px solid #1a1a1a;width:390px;height:700px;display:block;background:#060808}#mute{position:absolute;top:24px;right:28px;width:34px;height:34px;background:rgba(34,38,42,0.88);border-radius:100px;outline:none;border:2px solid #222;display:flex;align-items:center;justify-content:center;z-index:25;cursor:pointer;font-size:16px;color:#4fc3f7;line-height:0;transition:background .14s,border-color .13s}#mute.muted{color:#777;border-color:#444;background:rgba(34,38,42,0.38)}#overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(10,10,10,.92);text-align:center;z-index:20;padding:20px}#overlay.off{display:none}#overlay h2{font-size:30px;font-weight:700;margin-bottom:8px}#overlay p{color:#999;font-size:13px;margin-bottom:24px;max-width:300px;line-height:1.45}#overlay button{background:rgba(0,255,136,.15);border:1px solid #00ff88;color:#00ff88;padding:12px 36px;border-radius:10px;font-size:15px;cursor:pointer;font-family:inherit}#overlay input[type=text]{font-size:24px;font-weight:700;background:#191;border:none;color:#00ff88;border-radius:8px;padding:5px 16px;width:70px;text-align:center;outline:none;box-shadow:0 0 0 2px #00ff8855}#initials-prompt{margin-top:18px;display:none}#initials-prompt p{margin:0 0 8px;color:#eee;font-size:17px;}#initials-prompt form{display:flex;align-items:center;gap:10px;justify-content:center}@media (max-width:420px){body{width:390px !important;height:844px !important;}}</style></head><body><div id=\"hdr\"><div><div class=\"title\"><span class=\"accent\">BrickStorm DX</span></div><div id=\"hs\">AAA 0</div></div><div id=\"score\">0</div></div><div id=\"hud\"></div><div id=\"cw\"><canvas id=\"game\" width=\"390\" height=\"700\"></canvas></div><div id=\"mute\" title=\"Mute/Unmute\"></div><div id=\"overlay\"><h2 id=\"otitle\">BrickStorm DX</h2><p id=\"otext\">Touch/arrow keys and space to move and launch. Destroy all bricks!</p><button id=\"obtn\">Start</button><div id=\"initials-prompt\"><p>New High Score! Enter your initials:</p><form id=\"init-form\"><input id=\"in-inits\" maxlength=\"3\" autocapitalize=\"characters\" autocomplete=\"off\"/><button type=\"submit\">Save</button></form></div></div><script>\nif(window.__canvasAnimId) cancelAnimationFrame(window.__canvasAnimId);\nlet WIDTH=390, HEIGHT=700;\nlet canvas=document.querySelector('canvas'), ctx=canvas.getContext('2d');\nlet score=0, high={name:'AAA',score:0};\nlet level=1, lives=3, maxLevels=8, started=false, gameover=false, victory=false;\nlet activePowers={};\nlet bricks=[], balls=[], paddle=null, fallingPUs=[], hazards=[], enemies=[];\nlet overlay=document.getElementById('overlay'),scoreDiv=document.getElementById('score'),hsDiv=document.getElementById('hs'),hudDiv=document.getElementById('hud');\nlet bgColors=[\"#0a0a0a\", \"#31212b\", \"#0d1f28\", \"#1a2d08\", \"#302840\", \"#242992\", \"#2a0a28\", \"#0f222e\", \"#233412\"];\nlet muteBtn=document.getElementById('mute'),muted=false;\nlet actx, musicGain, sfxGain, musicStep=0, noteTimer=0, currentTheme=[];\nlet ambiencePhase=0, ambienceTimer=0;\nfunction setupAudio(){\n  if(actx)return;\n  actx=new(window.AudioContext||window.webkitAudioContext)();\n  musicGain=actx.createGain();musicGain.gain.value=0.14;musicGain.connect(actx.destination);\n  sfxGain=actx.createGain();sfxGain.gain.value=0.26;sfxGain.connect(actx.destination);\n}\nfunction playTone(freq,duration,type,gain,attack,release,target){\n  if(muted||!actx)return;\n  let o=actx.createOscillator(),g=actx.createGain(),now=actx.currentTime;\n  o.type=type||'sine';\n  o.frequency.setValueAtTime(freq,now);\n  g.gain.setValueAtTime(0.0001,now);\n  g.gain.linearRampToValueAtTime(gain||0.1,now+(attack||0.05));\n  g.gain.linearRampToValueAtTime(0.0001,now+duration-(release||0.2));\n  o.connect(g);g.connect(target||musicGain);\n  o.start(now);o.stop(now+duration+0.02);\n}\nfunction playPad(chord,duration){\n  if(muted||!actx)return;\n  for(let i=0;i<chord.length;i++) playTone(chord[i],duration,'sine',0.03,0.22,0.38,musicGain);\n}\nfunction playBell(freq,duration){\n  if(muted||!actx)return;\n  playTone(freq,duration||0.55,'triangle',0.07,0.02,0.28,musicGain);\n  playTone(freq*2,duration||0.55,'sine',0.018,0.01,0.22,musicGain);\n}\nfunction sfx(freq,type,duration,v){\n  if(muted||!actx)return;\n  let o=actx.createOscillator(),g=actx.createGain(),now=actx.currentTime;\n  o.type=type||'sine';o.frequency.setValueAtTime(freq,now);\n  g.gain.setValueAtTime(0.0001,now);\n  g.gain.linearRampToValueAtTime(v||0.18,now+0.015);\n  g.gain.exponentialRampToValueAtTime(0.0001,now+(duration||0.12));\n  o.connect(g);g.connect(sfxGain);o.start(now);o.stop(now+(duration||0.12)+0.03);\n}\nfunction pickMusicTheme(){\n  let themes=[\n    {root:220,scale:[0,3,7,10],pulse:2.8,melody:[0,7,3,10,7,3]},\n    {root:196,scale:[0,5,7,12],pulse:3.0,melody:[0,5,7,12,7,5]},\n    {root:233.08,scale:[0,2,7,9],pulse:2.6,melody:[0,7,9,7,2,7]},\n    {root:174.61,scale:[0,3,5,10],pulse:3.2,melody:[0,5,10,5,3,5]}\n  ];\n  return themes[(level-1)%themes.length];\n}\nfunction scheduleMeditativeMusic(dt){\n  if(!actx)return;\n  ambienceTimer-=dt;noteTimer-=dt;\n  if(!currentTheme.root) currentTheme=pickMusicTheme();\n  if(ambienceTimer<=0){\n    let root=currentTheme.root;\n    let chord=[root, root*Math.pow(2,currentTheme.scale[1]/12), root*Math.pow(2,currentTheme.scale[2]/12)];\n    if(level>=5) chord.push(root*Math.pow(2,currentTheme.scale[3]/12));\n    playPad(chord,2.7+Math.min(level*0.05,0.45));\n    ambienceTimer=currentTheme.pulse;\n  }\n  if(noteTimer<=0){\n    let deg=currentTheme.melody[musicStep%currentTheme.melody.length];\n    let freq=currentTheme.root*Math.pow(2,deg/12);\n    playBell(freq,0.52);\n    if(level>=6&&musicStep%4===2) playBell(freq/2,0.68);\n    musicStep++;\n    noteTimer=0.78-(level>6?0.04:0);\n  }\n}\nfunction saveHigh(){try{localStorage.setItem('brickstorm-hs',JSON.stringify(high));}catch(e){}}\nfunction loadHigh(){try{let s=localStorage.getItem('brickstorm-hs');if(s){let h=JSON.parse(s)||{};if(h.name&&h.score>=0)high=h;}}catch(e){}}\nloadHigh();\nfunction showHigh(){hsDiv.textContent=`${(high.name||'AAA').substring(0,3).padEnd(3,' ')} ${high.score||0}`;}\nfunction showScore(){scoreDiv.textContent=score;}\nfunction showHUD(){\n  hudDiv.innerHTML='';\n  let life=document.createElement('div');life.className='pu active';life.innerHTML=`<span style='width:9px;height:9px;display:inline-block;border-radius:100px;background:#ff6b35;'></span>LIVES <span style='color:#ff6b35'>${lives}</span>`;hudDiv.appendChild(life);\n  for(let k in activePowers){\n    if(activePowers[k]&&activePowers[k].time>0){\n      let pu=activePowers[k];\n      let div=document.createElement('div');\n      div.className='pu active';\n      div.innerHTML=`<span style='width:9px;height:9px;display:inline-block;border-radius:100px;background:${pu.color};'></span>${pu.label} <span style='color:${pu.color}'>${Math.ceil(pu.time)}s</span>`;\n      hudDiv.appendChild(div);\n    }\n  }\n}\nfunction showOverlay(title,txt,showBtn){\n  overlay.classList.remove('off');\n  document.getElementById('otitle').textContent=title;\n  document.getElementById('otext').innerHTML=txt;\n  document.getElementById('obtn').style.display=showBtn?'':'none';\n  document.getElementById('initials-prompt').style.display='none';\n}\nfunction hideOverlay(){overlay.classList.add('off');}\ndocument.getElementById('obtn').onclick=()=>{if(!actx)setupAudio();document.getElementById('initials-prompt').style.display='none';startGame();};\nfunction promptInitials(){\n  overlay.classList.remove('off');\n  document.getElementById('otitle').textContent='NEW HIGH SCORE!';\n  document.getElementById('otext').innerHTML=`${score}<br>${high.name} ${high.score}`;\n  document.getElementById('initials-prompt').style.display='block';\n  document.getElementById('obtn').style.display='none';\n  let f=document.getElementById('init-form'), inp=document.getElementById('in-inits');\n  inp.value='';inp.focus();\n  f.onsubmit=e=>{e.preventDefault();let n=inp.value.replace(/[^a-zA-Z0-9]/g,'').substring(0,3).toUpperCase();if(!n)n='AAA';high={name:n,score:score};saveHigh();showHigh();document.getElementById('initials-prompt').style.display='none';document.getElementById('obtn').style.display='';showOverlay(gameover&&victory?'VICTORY!':'GAME OVER',`Score: <span style='color:#00ff88'>${score}</span><br>High Score: <span style='color:#00ff88'>${high.name} ${high.score}</span>`,true);sfx(660,'triangle',0.42,0.16);return false;};\n}\nlet availablePU=[\n  {type:'life',label:'1UP',color:'#4fc3f7',icon:'💙'},\n  {type:'shield',label:'SHIELD',color:'#00ff88',icon:'🛡️'},\n  {type:'speed',label:'SPEED',color:'#ff6b35',icon:'⚡'},\n  {type:'slow',label:'SLOW',color:'#ffde59',icon:'🐢'},\n  {type:'multi',label:'MULTI',color:'#b967ff',icon:'🔮'},\n  {type:'laser',label:'LASER',color:'#f037a5',icon:'🔫'},\n  {type:'magnet',label:'MAGNET',color:'#3887ff',icon:'🧲'},\n  {type:'bomb',label:'BOMB',color:'#ec4040',icon:'💣'},\n  {type:'double',label:'2x',color:'#83ff30',icon:'×2'}\n];\nlet levels=[function(){let arr=[],R=6,C=8,pad=20,w=40,h=18;for(let r=0;r<R;r++)for(let c=0;c<C;c++)arr.push({x:pad+c*w+2*r,y:pad+32+r*h,hp:1,color:`hsl(${30*r+60},75%,60%)`,type:'brick'});return arr;},function(){let arr=[],R=5,C=10,pad=8,w=33,h=20;for(let r=0;r<R;r++)for(let c=0;c<C;c++)if(r<=c&&c<=(C-1)-r)arr.push({x:pad+c*w+16*r,y:48+r*h,hp:1+r%2,color:`hsl(${72-10*r+11*c},80%,57%)`,type:'brick'});return arr;},function(){let arr=[];let map=[\"..XXX.XXX..\",\".XXXX.XXXX.\",\"XXXXXXXXXX\",\".XXXXXXXX.\",\"..XXXXXX..\",\"...XXXX...\",\"....XX....\"];let h=18,w=30,ox=35,oy=46;for(let r=0;r<map.length;r++)for(let c=0;c<map[r].length;c++)if(map[r][c]==='X')arr.push({x:ox+c*w,y:oy+r*h,hp:2-(r>3),color:`hsl(${r*45+35},80%,65%)`,type:'brick'});return arr;},function(){let arr=[],y=44;let W=80,H=22,g=34,n=4,o=28;for(let i=0;i<n;i++)arr.push({x:o+g*i,y:y,W:W,H:H,dir:2-((i%2)*4),move:true,hp:2,color:'#ff6b35',type:'brick'});for(let c=0;c<8;c++)arr.push({x:14+40*c,y:y+110,hp:1,color:`hsl(${30*c+100},80%,60%)`,type:'brick'});return arr;},function(){let arr=[],cx=WIDTH/2,cy=140,r=60,w=32,h=16;for(let i=0;i<18;i++){let th=i*0.35,rx=cx+Math.cos(th)*r,ry=cy+Math.sin(th)*r;arr.push({x:rx-w/2,y:ry-h/2,hp:1+(i%3==0),color:`hsl(${i*27},95%,65%)`,type:'brick'});r+=4-(i%2)*6;}for(let i=0;i<7;i++)arr.push({x:cx-18+i*27,y:235,hp:2,color:'#00ff88',type:'brick'});return arr;},function(){let arr=[],pad=24,C=8,R=10,w=35,h=18;for(let r=0;r<R;r++)for(let c=0;c<C;c++){let ind=(r+c)%4==0;arr.push({x:pad+c*w,y:pad+34+r*h,hp:ind?999:1,color:ind?'#28294a':`hsl(${r*30+50},75%,55%)`,type:ind?'steel':'brick'});}return arr;},function(){let arr=[];for(let i=0;i<7;i++)arr.push({x:40+40*i,y:86,hp:1,color:'#ffb436',type:'brick'});for(let i=0;i<7;i++)arr.push({x:15+i*44,y:204,hp:2,color:'#52e1fe',type:'brick'});for(let c=0;c<6;c++)arr.push({x:45+c*50,y:316,hp:1,color:'#f94343',type:'brick'});return arr;},function(){let arr=[],cx=WIDTH/2,cy=120,rad=72,w=28,h=14;for(let i=0;i<12;i++){let th=i*0.5,rx=cx+Math.cos(th)*rad,ry=cy+Math.sin(th)*rad;arr.push({x:rx-w/2,y:ry-h/2,hp:2-(i%3==0),color:`hsl(${i*30+100},100%,72%)`,type:'brick'});rad-=8-(i%3)*2;}return arr;}];\nfunction randPUType(){let arr=availablePU;let weights=[1,1,1.2,1.1,1,0.9,0.95,0.6,0.72],pool=[];arr.forEach((p,i)=>{for(let j=0;j<Math.floor(weights[i]*3);j++)pool.push(i);});return arr[pool[Math.floor(Math.random()*pool.length)]].type;}\nfunction spawnFallingPU(x,y,tp){let pu=availablePU.find(p=>p.type==tp);if(!pu)return;fallingPUs.push({x:x,y:y,vy:2.3+Math.random(),type:pu.type,label:pu.label,color:pu.color,icon:pu.icon,life:240});}\nlet keys={},touching=false,laserActive=false,laserReady=false,magnetFlash=0,shieldActive=0,slowBalls=0,ballStick=false;\nfunction activatePU(tp){let def=availablePU.find(p=>p.type==tp);if(!def)return;activePowers[tp]={...(def),time:tp==='life'?0:12};showHUD();if(tp==='life'){lives++;delete activePowers[tp];sfx(320,'triangle',0.25,0.14);}else if(tp==='multi'){multiBall();sfx(520,'sine',0.28,0.14);}else if(tp==='bomb'){clearBricksNear();sfx(120,'triangle',0.32,0.16);}else if(tp==='double'){activePowers[tp].time=16;sfx(610,'sine',0.22,0.14);}else if(tp==='magnet'){activePowers[tp].time=10;magnetFlash=8;ballStick=true;sfx(360,'triangle',0.2,0.15);}else if(tp==='laser'){activePowers[tp].time=8;laserReady=true;sfx(700,'triangle',0.16,0.14);}else if(tp==='slow'){activePowers[tp].time=12;slowBalls=12;sfx(170,'sine',0.28,0.14);}else if(tp==='shield'){activePowers[tp].time=14;shieldActive=14;sfx(246,'triangle',0.24,0.15);}else if(tp==='speed'){activePowers[tp].time=10;if(paddle)paddle.spd=15;sfx(560,'sine',0.18,0.13);}showHUD();}\nfunction startGame(){level=1;score=0;lives=3;victory=false;started=true;gameover=false;currentTheme=pickMusicTheme();musicStep=0;noteTimer=0;ambienceTimer=0;startLevel(level);hideOverlay();showScore();showHigh();showHUD();window.__canvasAnimId=requestAnimationFrame(tick);}\nfunction startLevel(lv){paddle={x:WIDTH/2-53,y:HEIGHT-48,w:107,h:15,spd:11,d:0};balls=[{x:WIDTH/2,y:paddle.y-15,dx:8*(Math.random()<.5?1:-1),dy:-8,sz:10,live:true,sticky:true}];bricks=(levels[(lv-1)%levels.length]());fallingPUs=[];activePowers={};hazards=[];enemies=[];laserReady=false;magnetFlash=0;shieldActive=0;slowBalls=0;ballStick=false;currentTheme=pickMusicTheme();musicStep=0;noteTimer=0.2;ambienceTimer=0.1;showScore();showHUD();showOverlay(`LEVEL ${lv}`,levelFlavor(lv),false);sfx(480+lv*18,'triangle',0.34,0.12);setTimeout(()=>{overlay.classList.add('off');},lv===1?1100:1300);}\nfunction levelFlavor(lv){let arr=['Classic brick wall, rainbow!','Triangles: <span style=\"color:#4fc3f7\">precision</span>','<span style=\"color:#ff6b35\">Heart</span> formation','Moving bricks: <span style=\"color:#ffde59\">dodge!</span>','Spiral vortex','<span style=\"color:#b967ff\">Steel blocks cannot break</span>','Banks, with gaps','Double spiral & hazard enemy!'];return arr[(lv-1)%arr.length]||'';}\nfunction multiBall(){let arr=[];for(let ball of balls)if(ball.live)arr.push({...ball,dx:-ball.dx+1+(Math.random()*2),dy:-ball.dy+2*(Math.random()-0.5),sz:ball.sz,sticky:false});balls.push(...arr);}\nfunction clearBricksNear(){if(!paddle)return;let yp=paddle.y-65;for(let i=bricks.length-1;i>=0;i--){let b=bricks[i];if(b.y>yp&&b.y<paddle.y+30&&b.hp<999)bricks.splice(i,1);}}\ncanvas.onmousedown=canvas.ontouchstart=e=>{touching=true;let pt=e.touches?e.touches[0]:e;touching=true;if(paddle)touchX=pt.clientX-canvas.getBoundingClientRect().left;};\ncanvas.onmouseup=canvas.ontouchend=e=>{touching=false;};\ncanvas.onmousemove=canvas.ontouchmove=e=>{if(!touching||!paddle)return;let pt=e.touches?e.touches[0]:e;let x=pt.clientX-canvas.getBoundingClientRect().left;paddle.x=x-paddle.w/2;};\nwindow.onkeydown=e=>{if(e.repeat)return;keys[e.code]=1;if(e.code==='Space')for(let b of balls)if(b&&b.sticky){b.sticky=false;break;};\n  // -- RESTART BALL TO PADDLE with 'KeyR'\n  if(e.code==='KeyR') restartBallToPaddle();\n};\nwindow.onkeyup=e=>{keys[e.code]=0;};\nfunction movePaddle(){if(!paddle)return;let spd=paddle.spd||11;if(keys['ArrowLeft']||keys['KeyA'])paddle.x-=spd;if(keys['ArrowRight']||keys['KeyD'])paddle.x+=spd;paddle.x=Math.max(7,Math.min(WIDTH-paddle.w-9,paddle.x));}\nfunction launchBallIfMagnet(){if(ballStick)for(let b of balls)if(b&&b.sticky&&keys['Space']){b.sticky=false;break;}}\nfunction moveBalls(){for(let i=balls.length-1;i>=0;i--){let b=balls[i];if(!b||!b.live)continue;let slow=(activePowers.slow&&activePowers.slow.time>0)||slowBalls>0?0.45:1;if(b.sticky){if(paddle){b.x=paddle.x+paddle.w/2-b.sz/2;b.y=paddle.y-b.sz-1;}continue;}b.x+=b.dx*slow;b.y+=b.dy*slow;if(b.x<1||b.x>WIDTH-b.sz-1){b.dx=-b.dx;sfx(180,'sine',0.08,0.07);b.x=Math.max(2,Math.min(WIDTH-b.sz-2,b.x));}if(b.y<3){b.dy=-b.dy;sfx(260,'triangle',0.08,0.08);b.y=3;}if(paddle&&b.y+b.sz>=paddle.y-2&&b.y+b.sz<=paddle.y+14&&b.x+b.sz/2>paddle.x&&b.x+b.sz/2<paddle.x+paddle.w){sfx(220,'triangle',0.09,0.08);b.dy=-(8+1.4*(Math.random()-0.5));let off=((b.x+b.sz/2)-(paddle.x+paddle.w/2))/paddle.w;b.dx=7.5*off+5.5*(Math.random()-0.5);b.y=paddle.y-b.sz-1;if(ballStick||(activePowers.magnet&&activePowers.magnet.time>0))b.sticky=true;}if(b.y>HEIGHT){b.live=false;balls.splice(i,1);sfx(90,'triangle',0.16,0.12);if(!balls.filter(bb=>bb&&bb.live).length)loseBall();}}}\nfunction moveBricks(){for(let b of bricks)if(b.move){b.x+=b.dir;b.x=Math.max(5,Math.min(WIDTH-(b.W||40)-9,b.x));if(b.x<=6||b.x>=WIDTH-(b.W||40)-10)b.dir=-b.dir;}}\nfunction moveHazards(){for(let h of hazards){h.x+=h.vx;h.y+=h.vy;h.life--;if(h.x<10||h.x>WIDTH-10)h.vx=-h.vx;}}\nfunction moveEnemies(){for(let e of enemies){e.x+=e.dx;e.y+=e.dy?e.dy:0;if(e.x<0||e.x>WIDTH-e.w)e.dx=-e.dx;if(e.y<20)e.dy=Math.abs(e.dy||0.8);if(e.y>HEIGHT-200)e.dy=-Math.abs(e.dy||0.8);}}\nfunction moveFallingPU(){for(let pu of fallingPUs){pu.y+=pu.vy;pu.life--;}}\nfunction draw(){ctx.clearRect(0,0,WIDTH,HEIGHT);ctx.save();ctx.fillStyle=bgColors[(level-1)%bgColors.length];ctx.globalAlpha=0.31;ctx.fillRect(0,0,WIDTH,HEIGHT);ctx.restore();for(let i=0;i<36;i++){ctx.fillStyle='rgba(255,255,255,0.03)';ctx.fillRect((i*31+ambiencePhase*6)%WIDTH,(i*57)%HEIGHT,2,2);}ambiencePhase+=0.002;for(let b of bricks){ctx.save();ctx.beginPath();ctx.rect(b.x,b.y,b.W||40,b.H||b.h||18);ctx.fillStyle=b.hp>=999?'#28294a':b.color;ctx.fill();ctx.lineWidth=b.hp>=999?3:1;ctx.strokeStyle=b.hp>=999?'#4fc3f7':b.color;ctx.stroke();ctx.restore();}if(paddle){ctx.save();ctx.beginPath();ctx.rect(paddle.x,paddle.y,paddle.w,paddle.h);ctx.fillStyle='#00ff88';ctx.fill();ctx.strokeStyle='#FFF';ctx.stroke();ctx.restore();}for(let b of balls){if(!b||!b.live)continue;ctx.beginPath();ctx.arc(b.x+b.sz/2,b.y+b.sz/2,b.sz/2,0,Math.PI*2);ctx.fillStyle=activePowers.double?'#83ff30':b.sticky?'#3887ff':'#ffde59';ctx.fill();ctx.strokeStyle='#ff6b35';ctx.lineWidth=1.2;ctx.stroke();}for(let h of hazards){ctx.save();ctx.beginPath();ctx.arc(h.x,h.y,h.sz,0,7);ctx.fillStyle='#ec4040';ctx.globalAlpha=0.7;ctx.fill();ctx.restore();}for(let e of enemies){ctx.save();ctx.beginPath();ctx.rect(e.x,e.y,e.w,e.h);ctx.fillStyle=e.col||'#b967ff';ctx.globalAlpha=0.82;ctx.fill();ctx.restore();}for(let pu of fallingPUs){ctx.save();ctx.beginPath();ctx.arc(pu.x,pu.y,16,0,7);ctx.fillStyle=pu.color;ctx.globalAlpha=0.92;ctx.fill();ctx.globalAlpha=1;ctx.strokeStyle='#292929';ctx.lineWidth=3;ctx.stroke();ctx.font='19px system-ui';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillStyle='#fff';ctx.fillText(pu.icon,pu.x,pu.y+1);ctx.font='11px system-ui';ctx.fillStyle=pu.color;ctx.fillText(pu.label,pu.x,pu.y+14);ctx.restore();}if(magnetFlash>0&&paddle){ctx.save();ctx.globalAlpha=magnetFlash/8;ctx.strokeStyle='#3887ff';ctx.lineWidth=7;ctx.strokeRect(paddle.x-3,paddle.y-2,paddle.w+6,paddle.h+6);ctx.restore();}if(shieldActive>0&&paddle){ctx.save();ctx.beginPath();ctx.arc(paddle.x+paddle.w/2,paddle.y+paddle.h/2,54,0,7);ctx.globalAlpha=0.10+0.07*Math.random();ctx.strokeStyle='#00ff88';ctx.lineWidth=6;ctx.stroke();ctx.restore();}if(laserReady&&paddle){ctx.save();ctx.strokeStyle='#f037a5';ctx.globalAlpha=0.4;ctx.beginPath();ctx.moveTo(paddle.x+paddle.w/2,paddle.y);ctx.lineTo(paddle.x+paddle.w/2,paddle.y-14);ctx.stroke();ctx.restore();}ctx.fillStyle='#999';ctx.font='12px system-ui';ctx.fillText('Lives: '+lives,14,18);ctx.fillText('Level: '+level,320,18);}\nfunction checkFallingPU(){if(!paddle)return;for(let i=fallingPUs.length-1;i>=0;i--){let pu=fallingPUs[i];if(pu.y>HEIGHT-35||pu.life<=0){fallingPUs.splice(i,1);continue;}if(pu.y>paddle.y-11&&pu.x>paddle.x-12&&pu.x<paddle.x+paddle.w+12&&pu.y<paddle.y+paddle.h+12){activatePU(pu.type);fallingPUs.splice(i,1);sfx(520,'triangle',0.18,0.12);}}}\nfunction checkBallBrick(){for(let ball of balls){if(!ball||!ball.live)continue;for(let i=bricks.length-1;i>=0;i--){let b=bricks[i];let bx=ball.x+ball.sz/2,by=ball.y+ball.sz/2;if(bx>b.x&&bx<b.x+(b.W||40)&&by>b.y&&by<b.y+(b.H||b.h||18)){if(b.type==='steel'){if(b.hp>=999)sfx(140,'square',0.08,0.07);}else{score+=activePowers.double?36:18;showScore();b.hp--;if(b.hp<=0){if(Math.random()<0.23)spawnFallingPU(b.x+((b.W||40)/2),b.y+((b.H||18)/2),randPUType());bricks.splice(i,1);sfx(360,'triangle',0.14,0.11);if(bricks.length===0)nextLevel();}else{sfx(200,'sine',0.09,0.08);}}if(Math.abs(bx-b.x)<3||Math.abs(bx-(b.x+(b.W||40)))<3)ball.dx=-ball.dx;else ball.dy=-ball.dy;break;}}}}\nfunction checkBallHazard(){for(let ball of balls){if(!ball||!ball.live)continue;for(let i=hazards.length-1;i>=0;i--){let h=hazards[i];let dx=ball.x+h.sz-ball.sz/2,dy=ball.y+h.sz-ball.sz/2;if(Math.abs(dx)<h.sz+ball.sz&&Math.abs(dy)<h.sz+ball.sz){ball.dy=-ball.dy;hazards.splice(i,1);sfx(130,'sine',0.12,0.09);}}}}\nfunction checkBallEnemy(){for(let ball of balls){if(!ball||!ball.live)continue;for(let i=enemies.length-1;i>=0;i--){let e=enemies[i];let ex=e.x+e.w/2,ey=e.y+e.h/2;let dx=Math.abs(ball.x+ball.sz/2-ex),dy=Math.abs(ball.y+ball.sz/2-ey);if(dx<(e.w/2+ball.sz/2)&&dy<(e.h/2+ball.sz/2)){e.hp=(e.hp===undefined?1:e.hp)-1;ball.dy=-ball.dy;sfx(190,'triangle',0.11,0.09);if(e.hp<=0){enemies.splice(i,1);score+=101;showScore();}}}}}\nfunction checkLaser(){if(!laserReady||!laserActive||!paddle)return;let px=paddle.x+paddle.w/2,py=paddle.y-9;for(let i=bricks.length-1;i>=0;i--){let b=bricks[i];if(px>b.x&&px<b.x+(b.W||40)&&py>b.y&&py<b.y+(b.H||b.h||18)){if(b.type!=='steel'){score+=22;b.hp=0;showScore();if(Math.random()<0.27)spawnFallingPU(b.x+((b.W||40)/2),b.y+((b.H||18)/2),randPUType());bricks.splice(i,1);sfx(620,'triangle',0.09,0.08);if(bricks.length===0)nextLevel();}break;}}}\nfunction loseBall(){if(shieldActive>0){shieldActive=0;sfx(180,'triangle',0.2,0.12);return;}lives--;if(paddle)balls=[{x:WIDTH/2,y:paddle.y-14,dx:7*(Math.random()<.5?1:-1),dy:-8,sz:10,live:true,sticky:true}];showHUD();if(lives<=0)endGame();else sfx(84,'triangle',0.26,0.12);}\nfunction nextLevel(){level++;if(level>maxLevels){victory=true;endGame(true);}else{setTimeout(()=>{startLevel(level);},1209);sfx(540,'triangle',0.36,0.12);}}\nfunction endGame(vict){started=false;gameover=true;setTimeout(()=>{if(score>high.score){promptInitials();sfx(700,'triangle',0.44,0.13);}else showOverlay(vict?'VICTORY!':'GAME OVER',`Score: <span style='color:#00ff88'>${score}</span><br>High Score: <span style='color:#00ff88'>${high.name} ${high.score}</span>`,true);if(!vict&&score<=high.score)sfx(110,'sine',0.5,0.12);},930);}\nfunction updatePUs(dt){for(let k in activePowers){if(activePowers[k].time>0){activePowers[k].time-=dt;if(activePowers[k].time<=0){if(k==='speed'&&paddle)paddle.spd=11;if(k==='magnet'){ballStick=false;magnetFlash=0;}if(k==='laser')laserReady=false;delete activePowers[k];}}}if(magnetFlash>0)magnetFlash-=dt*1.2;if(shieldActive>0)shieldActive-=dt*1.5;if(slowBalls>0)slowBalls-=dt*1.33;}\nlet puTimer=0;\nfunction autoSpawnPU(dt){puTimer-=dt;if(puTimer<=0){let arr=availablePU.filter(p=>p.type!=='life');let pu=arr[Math.floor(Math.random()*arr.length)];spawnFallingPU(24+Math.random()*(WIDTH-48),80+Math.random()*340,pu.type);puTimer=6.6+2.4*Math.random();}}\nfunction updateHazards(dt){if(level>=8&&enemies.length<1&&Math.random()<0.033)enemies.push({x:Math.random()*(WIDTH-44),y:55,w:44,h:22,dx:3.8*(Math.random()<.5?1:-1),dy:0.5+Math.random(),col:'#f037a5'});if(level>=4&&hazards.length<2&&Math.random()<.012)hazards.push({x:Math.random()*(WIDTH-20),y:102,sz:13+Math.random()*7,vx:2.4*(Math.random()<.5?1:-1),vy:1.2+Math.random()*0.6,life:145});}\nfunction cleanupEntities(){for(let i=hazards.length-1;i>=0;i--)if(hazards[i].life<=0)hazards.splice(i,1);for(let i=fallingPUs.length-1;i>=0;i--)if(fallingPUs[i].life<=0)fallingPUs.splice(i,1);}\nlet last=performance.now();\nfunction tick(tm){let now=tm,lasttm=last;last=now;let dt=Math.min((now-lasttm)/1000,0.077);if(!started)return;movePaddle();moveBalls();moveBricks();moveHazards();moveEnemies();moveFallingPU();cleanupEntities();updatePUs(dt);autoSpawnPU(dt);updateHazards(dt);checkBallBrick();checkBallHazard();checkBallEnemy();checkFallingPU();if(laserReady){laserActive=(keys['ArrowUp']||keys['KeyW']||keys['Space']);if(laserActive){sfx(520,'sine',0.05,0.05);checkLaser();}}launchBallIfMagnet();draw();showHUD();scheduleMeditativeMusic(dt);window.__canvasAnimId=requestAnimationFrame(tick);}\nfunction showMuteBtn(){muteBtn.innerHTML=muted?'<svg width=\"21\" height=\"21\" viewBox=\"0 0 21 21\"><path d=\"m2 2 17 17\" stroke=\"#4fc3f7\" stroke-width=\"2\"/><path fill=\"#444\" d=\"M12.8 3.3c.1-.3.5-.4.7-.1a10.7 10.7 0 0 1 .8 2.6l-9 9H4.5a.5.5 0 0 1-.5-.5v-3.43a1 1 0 0 1 0-1.1v-3.5c0-.28.22-.5.5-.5h2.3l9-9c.3-.3.7-.2.8.1z\"/></svg>':'<svg width=\"24\" height=\"24\" aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M8 10v4h4l5 5V5l-5 5z\" opacity=\".4\"/><path fill=\"#4fc3f7\" d=\"M19 12c0-1.77-.77-3.37-2-4.47v8.94A6.997 6.997 0 0 0 19 12z\"/></svg>';muteBtn.className=muted?'muted':'';}\nmuteBtn.onclick=()=>{muted=!muted;showMuteBtn();};\nshowMuteBtn();showHigh();showScore();showHUD();draw();showOverlay('BrickStorm DX','Touch/arrow keys + space to play.<br>Destroy all bricks!',true);\n\n// --- ADDED: manual \"restart ball\" function\nfunction restartBallToPaddle() {\n  if (!paddle) return;\n  // Remove all balls\n  balls.splice(0);\n  // Always reset a single sticky ball atop the paddle\n  balls.push({\n    x: paddle.x + paddle.w/2 - 5,\n    y: paddle.y - 11,\n    dx: 7*(Math.random()<.5?1:-1),\n    dy: -8,\n    sz: 10,\n    live: true,\n    sticky: true\n  });\n}\n\n</script><script>\n(function(){\n  var t = window.traits;\n  if (!t || !t.score) return;\n  var _last = 0;\n  var _lastInit = '';\n  function getPlayerInitials() {\n    try { if (typeof getHighScore === 'function') { var h = getHighScore(); return h.initials || h.initial || ''; } } catch(e) {}\n    try { if (typeof highInitials === 'string' && highInitials) return highInitials; } catch(e) {}\n    try { if (typeof highInits === 'string' && highInits) return highInits; } catch(e) {}\n    try {\n      var hs = document.getElementById('hs');\n      if (hs) { var m = hs.textContent.match(/^([A-Z]{2,4})\\s/); if (m) return m[1]; }\n    } catch(e) {}\n    try {\n      for (var i = 0; i < localStorage.length; i++) {\n        var val = localStorage.getItem(localStorage.key(i));\n        if (!val) continue;\n        var sm = val.match(/^([A-Z]{2,4})\\s+\\d+$/);\n        if (sm) return sm[1];\n        try {\n          var obj = JSON.parse(val);\n          if (typeof obj === 'object' && obj) {\n            var init = obj.initials || obj.inits || obj.init || '';\n            if (init && typeof init === 'string' && init.length <= 4) return init;\n            if (obj.name && typeof obj.name === 'string' && obj.name.length <= 4 && typeof obj.score === 'number') return obj.name;\n          }\n        } catch(e2) {}\n      }\n    } catch(e) {}\n    return '';\n  }\n  function report(v) {\n    v = parseInt(v);\n    if (isNaN(v) || v < 0) return;\n    var init = getPlayerInitials();\n    if (v > _last || (v === _last && init && init !== _lastInit)) {\n      _last = v;\n      _lastInit = init;\n      t.score(v, init);\n    }\n  }\n  var el = document.getElementById('score');\n  if (el) {\n    new MutationObserver(function(){ report(el.textContent); })\n      .observe(el, {childList:true, characterData:true, subtree:true});\n  }\n  setInterval(function(){\n    try { if (typeof score === 'number') report(score); } catch(e){}\n    try { if (typeof game === 'object' && game && typeof game.score === 'number') report(game.score); } catch(e){}\n  }, 500);\n  function updateHS(sc, pl) {\n    var hs = document.getElementById('hs');\n    if (!hs) return;\n    var cur = hs.textContent.match(/(\\d+)/);\n    if (!cur || parseInt(cur[1]) >= sc) return;\n    var lbl = hs.textContent.match(/^(best|hi|hs|high)\\s*:\\s*/i);\n    var prefix = lbl ? lbl[0] : '';\n    hs.textContent = prefix + (pl ? pl + ' ' : '') + sc;\n  }\n  var synced = t.score();\n  var sv = (typeof synced === 'object' && synced) ? (synced.score || 0) : (synced || 0);\n  var sp = (typeof synced === 'object' && synced) ? (synced.player || '') : '';\n  if (sv > 0) updateHS(sv, sp);\n  window.addEventListener('message', function(e){\n    if (e.data && e.data.type === 'highscore-update' && e.data.score > 0) {\n      updateHS(e.data.score, e.data.player || '');\n    }\n  });\n})();\n</script></body></html>",
