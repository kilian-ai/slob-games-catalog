  "name": "kilian-ai__shooterx-260414235547-1",
  "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>ShooterX</title><style>*{margin:0;padding:0;box-sizing:border-box}body{width:390px;height:844px;overflow:hidden;background:#0a0a0a;color:#e0e0e0;font-family:system-ui,sans-serif;user-select:none}#hdr{display:flex;align-items:center;justify-content:space-between;padding:18px 20px 10px}#hdr .title{font-size:22px;font-weight:700}.accent{color:#00ff88}#score{font-size:22px;font-weight:700;color:#00ff88}#hs{font-size:11px;color:#555;margin-top:2px}#hud{display:flex;gap:10px;font-size:13px;font-weight:600;margin-bottom:2px;justify-content:center;align-items:center;min-height:20px}#hud .pu{background:#222;padding:2px 10px 2px 8px;border-radius:10px;display:inline-flex;align-items:center;gap:4px;border:1px solid #333;font-size:13px;font-weight:700;}#hud .pu.active{border-color:#00ff88}#cw{display:flex;justify-content:center;padding:0 20px}canvas{border-radius:8px;border:1px solid #1a1a1a}#mute{position:absolute;top:24px;right:28px;width:34px;height:34px;background:rgba(34,38,42,0.88);border-radius:100px;outline:none;border:2px solid #222;display:flex;align-items:center;justify-content:center;z-index:25;cursor:pointer;font-size:16px;color:#4fc3f7;line-height:0;transition:background .14s,border-color .13s}#mute.muted{color:#777;border-color:#444;background:rgba(34,38,42,0.38)}#overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(10,10,10,.92);text-align:center;z-index:20}#overlay.off{display:none}#overlay h2{font-size:30px;font-weight:700;margin-bottom:8px}#overlay p{color:#666;font-size:13px;margin-bottom:24px}#overlay button{background:rgba(0,255,136,.15);border:1px solid #00ff88;color:#00ff88;padding:12px 36px;border-radius:10px;font-size:15px;cursor:pointer;font-family:inherit}#overlay input[type=text]{font-size:24px;font-weight:700;background:#191;border:none;color:#00ff88;border-radius:8px;padding:5px 16px;width:70px;text-align:center;outline:none;box-shadow:0 0 0 2px #00ff8855}#initials-prompt{margin-top:18px;display:none}#initials-prompt p{margin:0 0 8px;color:#eee;font-size:17px;}#initials-prompt form{display:flex;align-items:center;gap:10px;justify-content:center}#blink-loop-indicator{position:absolute;top:3px;left:50%;transform:translateX(-50%);width:18px;height:18px;border-radius:9px;background:#ff6b35;box-shadow:0 0 6px 2px #000a;z-index:99998;border:2px solid #fff176;transition:background .09s;pointer-events:none;}</style></head><body><div id=\"blink-loop-indicator\"></div><div id=\"hdr\"><div><div class=\"title\"><span class=\"accent\">ShooterX</span></div><div id=\"hs\">AAA 0</div></div><div id=\"score\">0</div></div><div id=\"hud\"></div><div id=\"cw\"><canvas id=\"game\" width=\"390\" height=\"700\" style=\"width:390px;height:700px; display:block;background:#060808\"></canvas></div><div id=\"mute\" title=\"Mute/Unmute\"></div><div id=\"overlay\"><h2 id=\"otitle\">🚀 ShooterX</h2><p id=\"otext\">Touch/arrow keys to move and shoot</p><button id=\"obtn\">Start</button><div id=\"initials-prompt\"><p>New High Score! Enter your initials:</p><form id=\"init-form\"><input id=\"in-inits\" maxlength=\"3\" autocapitalize=\"characters\" autocomplete=\"off\"/><button type=\"submit\">Save</button></form></div></div><script>\n////////////////////////////////////////////////\n// --- ShooterX Multi-Level Shooting Game --- //\n////////////////////////////////////////////////\n\nlet WIDTH=390, HEIGHT=700;\nlet canvas=document.getElementById('game'), ctx=canvas.getContext('2d');\nlet score=0, highScore=0, highInits='AAA', level=0, highScoreKey='shooterx_hs';\nlet lives=3, isRunning=false, gameOverFlag=false, overlay=document.getElementById('overlay');\nlet levelIntroTimer=0, overlayTitle=document.getElementById('otitle'), overlayText=document.getElementById('otext'), overlayBtn=document.getElementById('obtn');\nlet initialsPrompt=document.getElementById('initials-prompt'), initialsInput=document.getElementById('in-inits');\nlet hsEl=document.getElementById('hs'), scoreEl=document.getElementById('score');\nlet muteBtn=document.getElementById('mute'), muted=false;\nlet blinkEl=document.getElementById('blink-loop-indicator'); let blinkState=false;\n\n// --- Enemies, Bullets, Power-ups --- //\nlet player, playerBullets=[], enemies=[], enemyBullets=[], powerUps=[], activePowerUps=[], powerUpIcons=[];\nlet hud=document.getElementById('hud');\nlet lastEnemySpawn=0, lastPowerUpDrop=0, keyState={}, lastShot=0, multiballNext=0;\nlet playerShotCooldown=260, enemySpeed=2, enemyShotChance=0.06;\nlet levelConfigs=[\n  // Expanded: 8 levels, unique backgrounds/hazards/layouts\n  { name:\"Dusk Fleet\",         bg:'#181C2A',   musicSeed:0,  enemies:12,   enemySpeed:1.5,  pattern:0, hazards:[], boss:false },\n  { name:\"Meteor Storm\",       bg:'#2B1517',   musicSeed:1,  enemies:17,   enemySpeed:2.1,  pattern:1, hazards:[{type:'meteor',interval:1200}], boss:false },\n  { name:\"Gridlock\",           bg:'#142427',   musicSeed:2,  enemies:18,   enemySpeed:2.7,  pattern:2, hazards:[], boss:false },\n  { name:\"Saboteurs\",          bg:'#211831',   musicSeed:3,  enemies:22,   enemySpeed:3.1,  pattern:3, hazards:[{type:'sniper',interval:1500}], boss:false },\n  { name:\"Swarm\",              bg:'#212A14',   musicSeed:4,  enemies:25,   enemySpeed:3.7,  pattern:4, hazards:[], boss:false },\n  { name:\"Formation Shift\",    bg:'#2C2031',   musicSeed:5,  enemies:30,   enemySpeed:4.2,  pattern:5, hazards:[{type:'meteor',interval:900}], boss:false },\n  { name:\"Magnetron\",          bg:'#32343A',   musicSeed:6,  enemies:33,   enemySpeed:4.7,  pattern:6, hazards:[{type:'sniper',interval:950}], boss:true },\n  { name:\"Laser Lattice\",      bg:'#181F33',   musicSeed:7,  enemies:38,   enemySpeed:5.1,  pattern:7, hazards:[{type:'laser',interval:900}], boss:false }\n];\n\nlet powerUpTypes=[\n  { id:'LIFE', color:'#00ff88', label:'1UP', icon:'♥',  desc:'Extra Life', duration:0 },\n  { id:'SHIELD', color:'#4fc3f7', label:'SHD', icon:'🛡️',desc:'Shield',    duration:8500 },\n  { id:'SBOOST', color:'#ff6b35', label:'SPD', icon:'⚡', desc:'Speed Boost',duration:6000 },\n  { id:'MULTI', color:'#bcff99', label:'MBL', icon:'🔄', desc:'Multi-Ball', duration:8500 },\n  { id:'LASER', color:'#fff176', label:'LSR', icon:'🔫', desc:'Laser',      duration:4000 },\n  { id:'MAGNET',color:'#00bfff', label:'MAG', icon:'🧲', desc:'Magnet',     duration:8500 },\n  { id:'BOMB', color:'#e57373', label:'BMB', icon:'💣', desc:'Bomb/Clear', duration:0 },\n  { id:'POINTX2',color:'#ffb300',label:'2X', icon:'💲', desc:'Double Score',duration:8000 },\n  { id:'FREEZE',color:'#b39ddb',label:'FRZ', icon:'❄️', desc:'Time Freeze', duration:4200 },\n  { id:'MYST', color:'#fa7eff', label:'???', icon:'❔', desc:'Mystery Box', duration:6500 }\n];\n\n// ========== AUDIO ========== //\nlet audioCtx, masterGain, seq=[], musicStep=0, musicTimer=0, musicSpeed=265;\nfunction setupAudio(){\n  if(!audioCtx){\n    audioCtx=new(window.AudioContext||window.webkitAudioContext)();\n    masterGain=audioCtx.createGain();\n    masterGain.gain.value=muted?0:0.34;\n    masterGain.connect(audioCtx.destination);\n  }\n}\nfunction playTone(freq,type,dur,vol){\n  if(!audioCtx)return;\n  let o=audioCtx.createOscillator();\n  let g=audioCtx.createGain();\n  o.type=type||'triangle';o.frequency.value=freq||440;\n  g.gain.value=vol||0.2;\n  o.connect(g);g.connect(masterGain);\n  o.start();\n  g.gain.setValueAtTime(g.gain.value,audioCtx.currentTime);\n  g.gain.linearRampToValueAtTime(0.001,audioCtx.currentTime+dur/1000);\n  o.stop(audioCtx.currentTime+dur/1000);\n}\nfunction sfx(type){\n  if(muted)return;\n  setupAudio();\n  switch(type){\n    case 'shoot': playTone(880,'triangle',40,0.18); break;\n    case 'hit': playTone(420,'sawtooth',55,0.17); break;\n    case 'enemydead': playTone(155,'square',75,0.21); break;\n    case 'get': playTone(890,'triangle',60,0.27); playTone(1200,'triangle',90,0.11); break;\n    case 'life': playTone(640,'triangle',60,0.28); playTone(540,'triangle',90,0.17); break;\n    case 'bomb': playTone(110,'triangle',170,0.31); break;\n    case 'shield': playTone(401,'triangle',60,0.18); break;\n    case 'freeze': playTone(290,'triangle',58,0.14); break;\n    case 'multi': playTone(420,'triangle',45,0.19); playTone(800,'triangle',40,0.17); break;\n    case 'laser': playTone(1050,'square',57,0.21); break;\n    case 'magnet': playTone(280,'triangle',73,0.12); break;\n    case 'high': playTone(880,'triangle',130,0.21); playTone(1000,'triangle',80,0.12); break;\n    case 'win': playTone(940,'triangle',145,0.19); playTone(1790,'triangle',90,0.11); break;\n    case 'over': playTone(175,'square',330,0.21); break;\n  }\n}\nfunction stepMusic(){\n  if(!audioCtx||muted)return;\n  let seed = levelConfigs[level].musicSeed % 8;\n  let base = [220,349,300,135,450,410,520,330][seed]||220;\n  let seqHere = [base,base*1.2,base*0.96, base*1.1, base*1.25, base*0.82, base*1.56];\n  if(Date.now()-musicTimer>musicSpeed-10*level){\n    let fq=seqHere[musicStep%seqHere.length];\n    playTone(fq,'triangle',80-Math.min(level*6,50),0.09+level*0.007);\n    musicStep++; musicTimer=Date.now();\n  }\n}\nfunction muteToggle(){muted=!muted;if(masterGain)masterGain.gain.value=muted?0:0.34;renderMuteBtn();}\nfunction renderMuteBtn(){\n  muteBtn.innerHTML=muted?'<svg width=\"20\" height=\"20\" aria-hidden=\"true\" viewBox=\"0 0 48 48\"><path fill=\"currentColor\" d=\"M19 22H10v8h9l8 6V16z\" opacity=\".5\"/><path fill=\"currentColor\" stroke=\"#4fc3f7\" stroke-width=\"3\" d=\"m35 35-18-18\"/></svg>':'<svg width=\"24\" height=\"24\" aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M8 10v4h4l5 5V5l-5 5z\" opacity=\".4\"/><path fill=\"#4fc3f7\" d=\"M19 12c0-1.77-.77-3.37-2-4.47v8.94A6.997 6.997 0 0 0 19 12z\"/></svg>';\n  muteBtn.classList.toggle('muted',muted);\n}muteBtn.onclick = muteToggle;renderMuteBtn();\n\n// ========== STORAGE ========== //\nfunction loadHigh(){\n  let h=localStorage.getItem(highScoreKey);\n  if(h){ let v=JSON.parse(h); highInits=v.inits||'AAA'; highScore=v.score||0; }\n  hsEl.textContent=highInits+' '+highScore;\n}\nfunction saveHigh(sc,inits){\n  highScore=sc; highInits=inits;\n  localStorage.setItem(highScoreKey,JSON.stringify({inits:inits,score:sc}));\n  hsEl.textContent=highInits+' '+highScore;\n}\nloadHigh();\n\nfunction showIntro(){\n  isRunning=false; overlay.classList.remove('off');\n  overlayTitle.textContent=\"🚀 ShooterX\";\n  overlayText.innerHTML='Touch/arrow keys to move and shoot';\n  overlayBtn.textContent='Start';overlayBtn.style.display='';\n  initialsPrompt.style.display='none';\n  // ---- Clear the canvas fully (reset all objects/arrays/flags) ----\n  score=0; level=0; lives=3; gameOverFlag=false;\n  player=null; playerBullets=[]; enemies=[]; enemyBullets=[]; powerUps=[]; activePowerUps=[]; powerUpIcons=[]; multiballNext=0;\n  keyState={}; lastShot=0; lastEnemySpawn=0; lastPowerUpDrop=0;\n  renderHUD();\n  ctx.clearRect(0,0,WIDTH,HEIGHT);\n  ctx.fillStyle='#181C2A';\n  ctx.fillRect(0,0,WIDTH,HEIGHT);\n}\nfunction showLevelIntro(n){\n  overlay.classList.remove('off');\n  overlayTitle.innerHTML='LEVEL '+(n+1)+' — '+levelConfigs[n].name;\n  overlayText.innerHTML='';\n  overlayBtn.style.display='none';initialsPrompt.style.display='none';\n  // Clear all bullets during level intro\n  playerBullets=[];\n  enemyBullets=[];\n  setTimeout(function(){overlay.classList.add('off');startLevel(n);}, 1450+Math.random()*330);\n}\nfunction showVictory(){\n  overlay.classList.remove('off'); isRunning=false;\n  overlayTitle.innerHTML='🏆 VICTORY!';\n  overlayText.innerHTML='Score: <b>'+score+'</b><br>High Score: '+highInits+' '+highScore;\n  overlayBtn.textContent='Play Again';overlayBtn.style.display='';\n  initialsPrompt.style.display='none';\n  sfx('win');\n}\nfunction showGameOver(){\n  overlay.classList.remove('off');\n  overlayTitle.textContent='💀 Game Over';\n  overlayBtn.style.display='none';\n  initialsPrompt.style.display='none';\n  let hsstring='High Score: '+highInits+' '+highScore;\n  if(score>highScore){promptInitials(); return;}\n  overlayText.innerHTML='Score: <b>'+score+'</b><br>'+hsstring;\n  sfx('over');\n}\nfunction promptInitials(){\n  overlayTitle.textContent='⭐ New High!';\n  overlayText.innerHTML='Your score: <b>'+score+'</b>';\n  overlayBtn.style.display='none';\n  initialsPrompt.style.display='block';\n  initialsInput.value=''; initialsInput.focus();\n}\ndocument.getElementById('init-form').onsubmit=function(e){e.preventDefault();\n  let iv=initialsInput.value.replace(/[^A-Za-z0-9]/g,'').toUpperCase().substring(0,3)||'AAA';\n  saveHigh(score,iv); sfx('high'); initialsPrompt.style.display='none'; overlayBtn.style.display='';\n  overlayText.innerHTML='Score: <b>'+score+'</b><br>High Score: '+iv+' '+score;\n  renderHUD();\n};\n\nfunction startLevel(n){\n  level = n; scoreEl.textContent=score;\n  player = {x:WIDTH/2,y:HEIGHT-60, vx:0, vy:0, r:19, speed:4.3, alive:true, cooldown:0, shield:0, laser:0, magnet:0};\n  lives = 3; playerBullets=[]; enemies=[]; enemyBullets=[]; powerUps=[]; activePowerUps=[];\n  isRunning=true;gameOverFlag=false;\n  lastEnemySpawn=Date.now();multiballNext=0;activePowerUps=[];\n  seq=[]; musicStep=0; musicTimer=0;\n  spawnEnemies(levelConfigs[level]);\n  renderHUD();\n  renderAll();\n}\nfunction nextLevel(){\n  if(level+1>=levelConfigs.length){showVictory();return;}\n  score+=30+20*level;\n  // Clear bullets before next level (clean up between levels)\n  playerBullets=[];\n  enemyBullets=[];\n  powerUps=[];\n  activePowerUps=[];\n  showLevelIntro(level+1);\n}\nfunction renderHUD(){\n  let h='';\n  if(lives>1) h+='<span class=\"pu\" style=\"color:#e53935\">♥ x'+lives+'</span>';\n  for(let act of activePowerUps){\n    if(act.duration===0)continue;\n    h+='<span class=\"pu active\" style=\"color:'+act.color+'\">'+act.icon+' <span style=\"font-size:12px;\">'+act.label+'</span> <span style=\"font-size:12px\">'+Math.ceil(Math.max(0,(act.duration-(Date.now()-act.start))/1000))+'s</span></span>';\n  }\n  hud.innerHTML=h;\n  scoreEl.textContent=score;\n  hsEl.textContent=highInits+' '+highScore;\n}\n\nfunction spawnEnemies(lv){\n  let lc=lv.enemies, spd=lv.enemySpeed, p=lv.pattern;\n  for(let i=0;i<lc;i++){\n    let x=60+Math.random()*(WIDTH-120), y=40+((i%5)*36);\n    enemies.push({x:x,y:y,vx:0,vy:spd*Math.sign(Math.sin(i*0.9+lives)),r:18,hp:1+(lv.boss?2:0),t:0,pattern:p,alive:true,shot:0});\n  }\n  if(lv.boss){\n    enemies.push({x:WIDTH/2,y:80,vx:2,vy:1.2,r:32,hp:9,pattern:lv.pattern,alive:true,shot:0,boss:true});\n  }\n}\n\nfunction spawnPowerUp(pos,forcedId){\n  let pool=powerUpTypes.slice(0);\n  if(forcedId){pool=pool.filter(pu=>pu.id===forcedId);}\n  let idx = Math.floor(Math.random()*pool.length);\n  let pu = pool[idx];\n  let px = pos?pos.x:60+Math.random()*(WIDTH-100);\n  let py = pos?pos.y:70+Math.random()*(0.35*HEIGHT);\n  powerUps.push({id:pu.id,...pu,x:px,y:py,vy:1.1+Math.random()*1.2,live:true,exp:Date.now()+9000});\n}\nfunction processActivePowerUps(){\n  let now=Date.now();\n  // Defensive safe-guard for player object and shield\n  if(!player) return;\n  for(let i=activePowerUps.length-1;i>=0;i--){\n    let pu=activePowerUps[i];\n    if(pu.duration && now-pu.start>pu.duration){\n      if(pu.id==='SHIELD') player.shield=0;\n      if(pu.id==='LASER')player.laser=0;\n      if(pu.id==='MAGNET')player.magnet=0;\n      if(pu.id==='SBOOST')player.speed=4.3;\n      activePowerUps.splice(i,1);\n    }\n  }\n  // bomb/freeze handled when applied\n}\n// POWER-UP EFFECT\nfunction applyPowerUp(pu){\n  let typ =powerUpTypes.find(x=>x.id==pu.id)||powerUpTypes[0];\n  let now = Date.now();\n  sfx(pu.id=='LIFE'?'life':pu.id.toLowerCase());\n  // Defensive for player and shield\n  if(!player) return;\n  switch(typ.id){\n    case 'LIFE': lives++; break;\n    case 'SHIELD': player.shield=1; break;\n    case 'SBOOST': player.speed=7.5; break;\n    case 'MULTI': multiballNext=10; break;\n    case 'LASER': player.laser=1; break;\n    case 'MAGNET': player.magnet=1; break;\n    case 'POINTX2': break;\n    case 'BOMB': clearEnemies(); break;\n    case 'FREEZE': freezeEnemies(); break;\n    case 'MYST': let rand = powerUpTypes[Math.floor(Math.random()*(powerUpTypes.length-1))]; applyPowerUp(rand); break;\n  }\n  if(typ.duration>0)activePowerUps.push({...typ, start:now});\n  renderHUD();\n}\nfunction clearEnemies(){ enemies=[]; sfx('bomb'); }\nfunction freezeEnemies(){\n  for(let e of enemies) e.frozen=Date.now()+3500;\n  sfx('freeze');\n}\n\n// ========== GAME LOOP ========== //\nlet levelClearPending = false;\nfunction update(dt){\n  if(!isRunning) return;\n  stepMusic();\n  processActivePowerUps();\n  // Player bullets\n  for(let b of playerBullets) b.y-=b.vy;\n  playerBullets=playerBullets.filter(b=>b.y>-20);\n  // Multi-ball\n  if(multiballNext>0&&Date.now()%140<60&&player&&player.alive){\n    shootPlayer(); multiballNext--;\n    if(multiballNext<=0)activePowerUps=activePowerUps.filter(p=>p.id!=='MULTI');\n  }\n  // Player power-up: Magnet (auto collect)\n  if(player&&player.magnet){\n    for(let pu of powerUps){\n      if(Math.abs(pu.x-player.x)<40 && Math.abs(pu.y-player.y)<50) pu.x+=0.20*(player.x-pu.x);\n    }\n  }\n  // Enemies\n  for(let e of enemies){\n    if(e.frozen && Date.now()<e.frozen)continue;\n    e.y+=e.vy; e.x+=e.vx?(2.5*Math.sin(e.t/45)):0; e.x+=e.vx||0; e.t++;\n    if(e.boss){ if(Math.random()<0.015+0.01*level&&e.t%18===0) spawnEnemyBullet(e); }\n    else if(Math.random()<enemyShotChance+0.002*level&&Math.random()>0.7) spawnEnemyBullet(e);\n  }\n  enemies=enemies.filter(e=>e.y<HEIGHT+40&&e.x>-20&&e.x<WIDTH+20&&e.hp>0);\n  // Enemy bullets\n  for(let b of enemyBullets){ b.y+=b.vy; }\n  enemyBullets=enemyBullets.filter(b=>b.y<HEIGHT+26);\n  // Powerups\n  for(let pu of powerUps) pu.y+=pu.vy;\n  powerUps=powerUps.filter(pu=>pu.y<HEIGHT+22 && Date.now()<pu.exp);\n  // Collisions\n  for(let i=playerBullets.length-1;i>=0;i--){\n    let b=playerBullets[i];\n    for(let j=enemies.length-1;j>=0;j--){\n      let e=enemies[j];\n      if(dist(b.x,b.y,e.x,e.y)<e.r+5){\n        e.hp--; playerBullets.splice(i,1); sfx('hit');\n        if(e.hp<=0){\n          e.alive=false; score+=(player&&player.laser||PUActive('POINTX2'))?10:5; sfx('enemydead');\n          // On destroy: drop a power-up sometimes\n          if(Math.random()<0.22+level*0.06) spawnPowerUp({x:e.x,y:e.y});\n        }\n        break;\n      }\n    }\n  }\n  enemies=enemies.filter(e=>e.hp>0);\n  // Player vs. Enemy\n  if(player){\n    for(let e of enemies){\n      if(dist(e.x,e.y,player.x,player.y)<player.r+e.r){\n        if(player.shield){ player.shield=0; activePowerUps=activePowerUps.filter(p=>p.id!=='SHIELD'); sfx('shield'); }\n        else { loseLife(); break; }\n        e.hp=0;\n      }\n    }\n    // Player vs. Enemy bullets\n    for(let b of enemyBullets){\n      if(dist(b.x,b.y,player.x,player.y)<player.r+7){\n        if(player.shield){ player.shield=0;activePowerUps=activePowerUps.filter(p=>p.id!=='SHIELD'); sfx('shield'); }\n        else { loseLife(); break; }\n        b.y=HEIGHT+99;\n      }\n    }\n    // Player/Power-up\n    for(let i=powerUps.length-1;i>=0;i--){\n      let pu=powerUps[i];\n      if(dist(player.x,player.y,pu.x,pu.y)<player.r+15){\n        applyPowerUp(pu); powerUps.splice(i,1);\n        sfx('get');\n        break;\n      }\n    }\n    // Timer-based drop\n    if(Date.now()-lastPowerUpDrop > 10000+Math.random()*3000){ spawnPowerUp(); lastPowerUpDrop=Date.now(); }\n    // Player movement (link player to animation loop)\n    // Keyboard controls\n    if(keyState['ArrowLeft']||keyState['a']||keyState['A'])player.x-=player.speed;\n    if(keyState['ArrowRight']||keyState['d']||keyState['D'])player.x+=player.speed;\n    if(keyState['ArrowUp']||keyState['w']||keyState['W'])player.y-=player.speed;\n    if(keyState['ArrowDown']||keyState['s']||keyState['S'])player.y+=player.speed;\n    // Boundaries\n    player.x=Math.max(player.r,Math.min(WIDTH-player.r,player.x));\n    player.y=Math.max(player.r,Math.min(HEIGHT-player.r,player.y));\n    // Player alive check\n    if(!player.alive && lives>0){player.alive=true;player.x=WIDTH/2;player.y=HEIGHT-60;}\n  }\n  renderHUD();\n  // Win? (Level end detection)\n  // Only trigger transition after enemies+powerups offscreen and all bullets are gone\n  if(enemies.length==0 && isRunning){\n    let powerupsStill = powerUps.filter(pu=>pu.y<HEIGHT+21);\n    let bulletsStill = playerBullets.length>0 || enemyBullets.length>0;\n    if(powerupsStill.length===0 && !bulletsStill){\n      isRunning = false; // Pause updates during level intro\n      nextLevel();\n    } else {\n      // Wait for all objects to clear before next level starts\n      // (Don't do anything here, keep running update)\n    }\n  }\n}\nfunction loseLife(){\n  sfx('over');\n  lives--; if(player) player.shield=0;activePowerUps=[];renderHUD();\n  if(lives<=0){ gameOverFlag=true; isRunning=false; showGameOver(); return; }\n  if(player) { player.x=WIDTH/2;player.y=HEIGHT-60; }\n}\nfunction PUActive(id){ return activePowerUps.some(pu=>pu.id===id); }\n// ========== RENDER ========== //\nfunction renderPlayer(){\n  if(!player) return;\n  // Shield effect\n  if(player.shield){\n    ctx.save();ctx.beginPath();ctx.arc(player.x,player.y,player.r+7,0,2*Math.PI);\n    ctx.strokeStyle='#4fc3f7dd';ctx.lineWidth=6;ctx.globalAlpha=0.70+0.3*Math.cos(Date.now()/190);ctx.stroke();ctx.restore();\n  }\n  ctx.save(); ctx.shadowColor='#00ff88'; ctx.shadowBlur=player.laser?16:8;\n  ctx.beginPath();ctx.arc(player.x,player.y,player.r,0,2*Math.PI);\n  ctx.fillStyle=player.laser?'#ffd700':player.magnet?'#00d8ff':'#00ff88';ctx.fill();ctx.restore();\n  // cannon\n  ctx.strokeStyle=player.laser?'#fff176':'#222';ctx.lineWidth=6;\n  ctx.beginPath();ctx.moveTo(player.x,player.y-13);ctx.lineTo(player.x,player.y-player.r-10);ctx.stroke();\n}\nfunction renderEnemy(e){\n  ctx.save();ctx.beginPath();ctx.arc(e.x,e.y,e.r,0,2*Math.PI);\n  ctx.fillStyle=e.boss?'#ff1744':'#4fc3f7';ctx.globalAlpha=e.alive?0.95:0.3;ctx.shadowColor=e.boss?'#ff6b35':'#4fc3f7';ctx.shadowBlur=e.boss?18:6;ctx.fill();ctx.shadowBlur=0;\n  ctx.font='bold '+(e.boss?23:15)+'px system-ui';ctx.fillStyle=e.boss?'#fff':'#222';ctx.textAlign='center';ctx.fillText(e.boss?'👾':'👽',e.x,e.y+4);\n  if(e.frozen&&Date.now()<e.frozen){ctx.globalAlpha=0.77;ctx.fillStyle='#b39ddb';ctx.beginPath();ctx.arc(e.x,e.y,e.r*0.90,0,2*Math.PI);ctx.fill();}\n  ctx.restore();\n}\nfunction renderAll(){\n  ctx.clearRect(0,0,WIDTH,HEIGHT);\n  // BG\n  ctx.fillStyle=levelConfigs[level]?levelConfigs[level].bg:'#0a0a0a';ctx.fillRect(0,0,WIDTH,HEIGHT);\n  // BG hazards (meteors, lasers)\n  if(levelConfigs[level]&&levelConfigs[level].hazards){\n    for(let h of levelConfigs[level].hazards){\n      if(h.type==='meteor'&&(Date.now()%h.interval)<330){drawMeteor();}\n      if(h.type==='laser'&&(Date.now()%h.interval)<160){drawLaserGrid();}\n    }\n  }\n  // Only render bullets (player & enemy) if level is active\n  if (isRunning) {\n    ctx.save();ctx.fillStyle='#ffb300'; for(let b of playerBullets){ ctx.beginPath();ctx.arc(b.x,b.y,5,0,2*Math.PI);ctx.fill(); }\n    ctx.fillStyle='#e57373'; for(let b of enemyBullets){ ctx.beginPath();ctx.arc(b.x,b.y,6,0,2*Math.PI);ctx.fill(); } ctx.restore();\n  }\n  // Enemies\n  for(let e of enemies){ renderEnemy(e); }\n  // PowerUps\n  for(let pu of powerUps){\n    ctx.save();ctx.globalAlpha=0.80+0.17*Math.sin(Date.now()/90+pu.x);\n    ctx.shadowColor=pu.color; ctx.shadowBlur=13; ctx.fillStyle=pu.color; ctx.beginPath();ctx.arc(pu.x,pu.y,18,0,2*Math.PI);ctx.fill();ctx.shadowBlur=0;ctx.globalAlpha=1;\n    ctx.font='16px system-ui';ctx.textAlign='center';ctx.fillStyle='#222';ctx.fillText(pu.icon,pu.x,pu.y+2);ctx.restore();\n  }\n  renderPlayer();\n}\nfunction drawMeteor(){\n  let x = Math.abs(Math.sin(Date.now()/960))*WIDTH*0.97;\n  ctx.save();ctx.beginPath();ctx.arc(x,120,21+8*Math.abs(Math.sin(Date.now()/600)),0,2*Math.PI);ctx.fillStyle='#ff6b35';ctx.shadowColor='#fd9063';ctx.shadowBlur=16;ctx.fill();ctx.shadowBlur=0;\n  ctx.font='bold 18px system-ui';ctx.fillStyle='#f9fff9';ctx.textAlign='center';ctx.fillText('☄️',x,124);\n  ctx.restore();\n}\nfunction drawLaserGrid(){\n  let t = (Date.now()%1200);\n  let x = 54 + (Math.sin(Date.now()/480+99)*WIDTH*0.31);\n  ctx.save(); ctx.globalAlpha=0.67+0.33*Math.cos(Date.now()/90);\n  ctx.strokeStyle='#4fc3f7dd';ctx.lineWidth=6; ctx.beginPath();ctx.moveTo(x,0); ctx.lineTo(x,HEIGHT); ctx.stroke(); ctx.restore();\n}\nfunction dist(x1,y1,x2,y2){let dx=x1-x2,dy=y1-y2;return Math.sqrt(dx*dx+dy*dy);}\n\nfunction spawnEnemyBullet(e){\n  let spread = e.boss?[-0.9,0,0.9]:[0];\n  for(let d of spread){\n    enemyBullets.push({x:e.x,y:e.y+d*15,vy:3.7+level*0.5});\n  }\n}\nfunction shootPlayer(){\n  if(!player||!player.alive||!isRunning)return;\n  let now=Date.now();\n  if(player.laser){\n    playerBullets.push({x:player.x,y:player.y-25,vy:10}); sfx('laser');\n  }else if(now-lastShot>playerShotCooldown){\n    playerBullets.push({x:player.x,y:player.y-25,vy:7+(PUActive('SBOOST')?3:0)}); sfx('shoot');\n    lastShot=now;\n  }\n}\n\n// ========== INPUTS ========== //\ndocument.addEventListener('keydown',function(e){\n  keyState[e.key]=true; if(e.key===' '||e.key==='ArrowUp') shootPlayer();\n  if(!isRunning&&(e.key===' '||e.key==='Enter')){ if(gameOverFlag) showIntro(); else showLevelIntro(0);} \n});\ndocument.addEventListener('keyup',function(e){keyState[e.key]=false;});\ncanvas.addEventListener('touchstart',function(e){\n  let t = e.touches[0]; let rx = t.clientX-canvas.getBoundingClientRect().left;\n  if(rx<WIDTH/2) player.x -= 42; else player.x += 42;\n  shootPlayer();\n});\n\noverlayBtn.onclick = function(){ if(gameOverFlag) showIntro(); else showLevelIntro(0); };\n\n// ========== GAME MAIN LOOP ========== //\nfunction blinkIndicator(){\n  blinkState=!blinkState;\n  blinkEl.style.background=blinkState?'#ff6b35':'#12e478';\n  blinkEl.style.opacity=blinkState?\"1.0\":\"0.6\";\n}\nfunction loop(){\n  // Removed spamming loop logs here\n  update(18);\n  renderAll();\n  renderHUD();\n  if(isRunning)stepMusic();\n  blinkIndicator();\n  window.__canvasAnimId&&cancelAnimationFrame(window.__canvasAnimId);\n  window.__canvasAnimId=requestAnimationFrame(loop);\n}\nshowIntro();\nloop();\n</script><!-- VOICE-UPDATE-TEST-1775766508233 --><script>\n(function(){\n  var t = window.traits;\n  if (!t || !t.score) return;\n  var _last = 0;\n  var _lastInit = '';\n  function getPlayerInitials() {\n    try { if (typeof getHighScore === 'function') { var h = getHighScore(); return h.initials || h.initial || ''; } } catch(e) {}\n    try { if (typeof highInitials === 'string' && highInitials) return highInitials; } catch(e) {}\n    try { if (typeof highInits === 'string' && highInits) return highInits; } catch(e) {}\n    try {\n      var hs = document.getElementById('hs');\n      if (hs) { var m = hs.textContent.match(/^([A-Z]{2,4})\\s/); if (m) return m[1]; }\n    } catch(e) {}\n    try {\n      for (var i = 0; i < localStorage.length; i++) {\n        var val = localStorage.getItem(localStorage.key(i));\n        if (!val) continue;\n        var sm = val.match(/^([A-Z]{2,4})\\s+\\d+$/);\n        if (sm) return sm[1];\n        try {\n          var obj = JSON.parse(val);\n          if (typeof obj === 'object' && obj) {\n            var init = obj.initials || obj.inits || obj.init || '';\n            if (init && typeof init === 'string' && init.length <= 4) return init;\n            if (obj.name && typeof obj.name === 'string' && obj.name.length <= 4 && typeof obj.score === 'number') return obj.name;\n          }\n        } catch(e2) {}\n      }\n    } catch(e) {}\n    return '';\n  }\n  function report(v) {\n    v = parseInt(v);\n    if (isNaN(v) || v < 0) return;\n    var init = getPlayerInitials();\n    if (v > _last || (v === _last && init && init !== _lastInit)) {\n      _last = v;\n      _lastInit = init;\n      t.score(v, init);\n    }\n  }\n  var el = document.getElementById('score');\n  if (el) {\n    new MutationObserver(function(){ report(el.textContent); })\n      .observe(el, {childList:true, characterData:true, subtree:true});\n  }\n  setInterval(function(){\n    try { if (typeof score === 'number') report(score); } catch(e){}\n    try { if (typeof game === 'object' && game && typeof game.score === 'number') report(game.score); } catch(e){}\n  }, 500);\n  function updateHS(sc, pl) {\n    var hs = document.getElementById('hs');\n    if (!hs) return;\n    var cur = hs.textContent.match(/(\\d+)/);\n    if (!cur || parseInt(cur[1]) >= sc) return;\n    var lbl = hs.textContent.match(/^(best|hi|hs|high)\\s*:\\s*/i);\n    var prefix = lbl ? lbl[0] : '';\n    hs.textContent = prefix + (pl ? pl + ' ' : '') + sc;\n  }\n  var synced = t.score();\n  var sv = (typeof synced === 'object' && synced) ? (synced.score || 0) : (synced || 0);\n  var sp = (typeof synced === 'object' && synced) ? (synced.player || '') : '';\n  if (sv > 0) updateHS(sv, sp);\n  window.addEventListener('message', function(e){\n    if (e.data && e.data.type === 'highscore-update' && e.data.score > 0) {\n      updateHS(e.data.score, e.data.player || '');\n    }\n  });\n})();\n</script>\n</body></html>",
